@model ContentManagementSystem.ApplicationCore.DTOs.ContactMessageDto

@{
    ViewData["Title"] = "Chi tiết liên hệ";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chi tiết tin nhắn liên hệ</h2>
        </div>
        <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
            &larr; Quay lại
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 space-y-4">
        <div class="grid grid-cols-2 gap-4 pb-4 border-b border-gray-100">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Người gửi:</span>
                <p class="text-lg font-bold text-gray-900">@Model.Name</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Email:</span>
                <a href="mailto:@Model.Email" class="text-blue-600 hover:underline text-sm font-medium">@Model.Email</a>
            </div>
        </div>

        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Thời gian gửi:</span>
            <p class="text-xs text-gray-500">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</p>
        </div>

        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Nội dung tin nhắn:</span>
            <div class="p-5 bg-gray-50 rounded-xl text-gray-800 text-sm leading-relaxed whitespace-pre-line border border-gray-100">
                @Model.Message
            </div>
        </div>

        <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
            <a asp-action="Delete" asp-route-id="@Model.Id" class="px-5 py-2.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 text-sm font-semibold transition-all">
                Xóa tin nhắn này
            </a>
            <a href="mailto:@Model.Email" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                Trả lời qua Email
            </a>
        </div>
    </div>
</div>

