@model ContentManagementSystem.ApplicationCore.DTOs.CommentDto

@{
    ViewData["Title"] = "Kiểm duyệt Bình luận";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Kiểm duyệt Bình luận</h2>
            <p class="text-sm text-gray-500 mt-1">Duyệt hoặc chỉnh sửa nội dung bình luận.</p>
        </div>
        <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
            &larr; Quay lại
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <form asp-action="Edit" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PostId" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-sm"></div>

            <div>
                <label asp-for="Content" class="block text-sm font-semibold text-gray-700 mb-1">Nội dung bình luận <span class="text-rose-500">*</span></label>
                <textarea asp-for="Content" rows="5" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent font-sans" required></textarea>
                <span asp-validation-for="Content" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div class="pt-2">
                <label class="relative flex items-center gap-3 cursor-pointer">
                    <input asp-for="IsApproved" type="checkbox" class="w-4 h-4 text-green-600 rounded border-gray-300 focus:ring-green-500" />
                    <span class="text-sm font-semibold text-gray-800 select-none">Đã phê duyệt (cho phép hiển thị trên bài viết)</span>
                </label>
            </div>

            <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 text-sm font-medium transition-all">Hủy bỏ</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Cập nhật trạng thái
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

