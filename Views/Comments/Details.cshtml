@model ContentManagementSystem.ApplicationCore.DTOs.CommentDto

@{
    ViewData["Title"] = "Chi tiết Bình luận";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chi tiết Bình luận</h2>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
                &larr; Quay lại danh sách
            </a>
            <a asp-controller="Posts" asp-action="Details" asp-route-id="@Model.PostId" class="inline-flex items-center gap-1.5 text-sm font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 px-4 py-2 rounded-xl border border-blue-200 shadow-sm transition-all">
                📄 Xem bài viết
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 space-y-5">
        <!-- Status & Post Card -->
        <div class="p-4 rounded-xl bg-blue-50/70 border border-blue-100 space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-blue-700 block">Thuộc bài viết:</span>
            <a asp-controller="Posts" asp-action="Details" asp-route-id="@Model.PostId" class="text-base font-bold text-blue-900 hover:underline flex items-center gap-1.5">
                <span>📄</span>
                <span>@(!string.IsNullOrEmpty(Model.PostTitle) ? Model.PostTitle : "Bài viết #" + Model.PostId)</span>
            </a>
            @if (!string.IsNullOrEmpty(Model.DepartmentName))
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-semibold bg-purple-100 text-purple-800">
                    🏢 @Model.DepartmentName
                </span>
            }
        </div>

        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Người bình luận:</span>
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs">
                    @((!string.IsNullOrEmpty(Model.UserName) ? Model.UserName.Substring(0, 1) : "U").ToUpper())
                </div>
                <span class="text-sm font-bold text-gray-800">@(Model.UserName ?? "Người dùng ẩn danh")</span>
            </div>
        </div>

        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Trạng thái duyệt:</span>
            @if (Model.IsApproved)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-50 text-green-700 border border-green-200 rounded-full text-xs font-bold">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span> Đã duyệt
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 rounded-full text-xs font-bold animate-pulse">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Chờ duyệt
                </span>
            }
        </div>

        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Nội dung bình luận:</span>
            <div class="p-4 bg-gray-50 rounded-xl text-gray-800 text-sm whitespace-pre-line leading-relaxed border border-gray-100 font-medium">
                @Model.Content
            </div>
        </div>

        <div class="pt-2 text-xs text-gray-500 border-t border-gray-100 flex items-center justify-between">
            <span>Thời gian gửi: <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</strong></span>
            <div class="flex items-center gap-2">
                @if (!Model.IsApproved)
                {
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all">
                            Duyệt bình luận này
                        </button>
                    </form>
                }
                else
                {
                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-gray-100 hover:bg-amber-100 text-gray-700 hover:text-amber-800 transition-all">
                            Bỏ duyệt
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

