@model IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.CommentDto>

@{
    ViewData["Title"] = "Quản lý Bình luận";
    Layout = "_Layout";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">💬 Quản lý & Phê duyệt Bình luận</h2>
            <p class="text-sm text-gray-500 mt-1">Kiểm duyệt, chấp thuận hoặc ẩn các bình luận từ độc giả trên từng bài viết.</p>
        </div>
        <div class="flex items-center gap-2 text-sm">
            <span class="px-3 py-1 bg-green-50 text-green-700 rounded-xl font-bold text-xs border border-green-200">
                ✅ Đã duyệt: @(Model?.Count(c => c.IsApproved) ?? 0)
            </span>
            <span class="px-3 py-1 bg-amber-50 text-amber-700 rounded-xl font-bold text-xs border border-amber-200">
                ⏳ Chờ duyệt: @(Model?.Count(c => !c.IsApproved) ?? 0)
            </span>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-5 border-b border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <span class="text-sm text-gray-500">
                Tổng cộng: <strong class="text-gray-800 font-bold">@(Model?.Count() ?? 0)</strong> bình luận trên toàn hệ thống
            </span>
            <div class="relative w-full sm:w-64">
                <input type="text" id="commentSearch" placeholder="Tìm theo nội dung, bài viết..."
                       class="w-full pl-9 pr-3 py-1.5 border border-gray-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
                <svg class="w-4 h-4 text-gray-400 absolute left-3 top-2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="commentsTable">
                <thead>
                    <tr class="bg-gray-50/75 text-gray-500 text-xs uppercase tracking-wider">
                        <th class="px-6 py-3.5 font-bold">Nội dung bình luận</th>
                        <th class="px-6 py-3.5 font-bold">Thuộc bài viết</th>
                        <th class="px-6 py-3.5 font-bold">Thời gian</th>
                        <th class="px-6 py-3.5 font-bold">Trạng thái</th>
                        <th class="px-6 py-3.5 font-bold">Phê duyệt</th>
                        <th class="px-6 py-3.5 font-bold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50/75 transition-colors comment-row">
                                <!-- Comment content + author -->
                                <td class="px-6 py-4 max-w-sm">
                                    <div class="flex items-start gap-2.5">
                                        <div class="w-7 h-7 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5 shadow-xs">
                                            @((!string.IsNullOrEmpty(item.UserName) ? item.UserName.Substring(0, 1) : "U").ToUpper())
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <span class="text-xs font-bold text-gray-700 block comment-author">
                                                @(item.UserName ?? "Người dùng ẩn danh")
                                            </span>
                                            <p class="text-gray-900 font-medium text-sm mt-0.5 leading-relaxed comment-content">
                                                @item.Content
                                            </p>
                                        </div>
                                    </div>
                                </td>

                                <!-- Associated Post -->
                                <td class="px-6 py-4 max-w-xs">
                                    <div class="space-y-1">
                                        <a asp-controller="Posts" asp-action="Details" asp-route-id="@item.PostId"
                                           class="font-bold text-blue-600 hover:text-blue-800 hover:underline line-clamp-2 text-xs flex items-center gap-1.5 comment-post"
                                           title="Bấm để xem trực tiếp bài viết này">
                                            <span>📄</span>
                                            <span>@(!string.IsNullOrEmpty(item.PostTitle) ? item.PostTitle : "Bài viết #" + item.PostId.ToString().Substring(0, 8))</span>
                                        </a>
                                        @if (!string.IsNullOrEmpty(item.DepartmentName))
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-purple-50 text-purple-700 border border-purple-100">
                                                🏢 @item.DepartmentName
                                            </span>
                                        }
                                    </div>
                                </td>

                                <!-- Time -->
                                <td class="px-6 py-4 text-gray-500 text-xs whitespace-nowrap">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <!-- Status Badge -->
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (item.IsApproved)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-50 text-green-700 border border-green-200 rounded-full text-xs font-bold">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                                            Đã duyệt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 text-amber-700 border border-amber-200 rounded-full text-xs font-bold animate-pulse">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            Chờ duyệt
                                        </span>
                                    }
                                </td>

                                <!-- Approval Action -->
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (!item.IsApproved)
                                    {
                                        <form asp-action="Approve" asp-route-id="@item.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all active:scale-95" title="Duyệt và hiển thị bình luận công khai">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                Duyệt ngay
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Reject" asp-route-id="@item.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl text-xs font-semibold bg-gray-100 hover:bg-amber-100 text-gray-700 hover:text-amber-800 transition-all active:scale-95" title="Bỏ duyệt bình luận">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                                Bỏ duyệt
                                            </button>
                                        </form>
                                    }
                                </td>

                                <!-- Actions -->
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <div class="inline-flex items-center gap-1">
                                        <!-- View Post directly -->
                                        <a asp-controller="Posts" asp-action="Details" asp-route-id="@item.PostId"
                                           class="p-1.5 text-gray-400 hover:text-emerald-600 rounded-lg hover:bg-emerald-50 transition-all"
                                           title="Xem bài viết của bình luận này">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                        </a>

                                        <!-- Details -->
                                        <a asp-action="Details" asp-route-id="@item.Id" class="p-1.5 text-gray-400 hover:text-blue-600 rounded-lg hover:bg-blue-50 transition-all" title="Xem chi tiết">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                        </a>

                                        <!-- Edit -->
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-gray-400 hover:text-indigo-600 rounded-lg hover:bg-indigo-50 transition-all" title="Chỉnh sửa">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        </a>

                                        <!-- Delete -->
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 text-gray-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-all" title="Xóa">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-16 text-gray-400">
                                <div class="text-3xl mb-2">💬</div>
                                <p class="text-base font-medium text-gray-500">Chưa có bình luận nào trên hệ thống</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById('commentSearch')?.addEventListener('input', function (e) {
        const term = e.target.value.toLowerCase();
        document.querySelectorAll('.comment-row').forEach(row => {
            const content = row.querySelector('.comment-content')?.textContent.toLowerCase() || '';
            const post = row.querySelector('.comment-post')?.textContent.toLowerCase() || '';
            const author = row.querySelector('.comment-author')?.textContent.toLowerCase() || '';
            row.style.display = (content.includes(term) || post.includes(term) || author.includes(term)) ? '' : 'none';
        });
    });
</script>

