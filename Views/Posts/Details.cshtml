@model ContentManagementSystem.ApplicationCore.DTOs.PostDto
@using ContentManagementSystem.Services
@inject ICurrentUserService CurrentUserService

@{
    ViewData["Title"] = Model.Title ?? "Chi tiết bài viết";
    Layout = "_Layout";
    var currentUser = await CurrentUserService.GetCurrentUserAsync();
    var currentUserName = currentUser.IsAuthenticated ? currentUser.DisplayName : "Bạn đọc";
    var userInitial = !string.IsNullOrEmpty(currentUserName) ? currentUserName.Substring(0, 1).ToUpper() : "U";
    var authorName = !string.IsNullOrEmpty(Model.AuthorName) ? Model.AuthorName : "Syrex";
    var authorInitial = authorName.Substring(0, 1).ToUpper();
    var canEdit = currentUser.IsAdmin || currentUser.IsQAManager || currentUser.IsQACoordinator;
    var categorySlug = Model.CategoryName?.Replace(" ", "").ToLower() ?? "cms";
}

<div class="max-w-4xl mx-auto space-y-6 pb-20">
    <!-- Top Breadcrumb & Back Navigation -->
    <div class="flex items-center justify-between text-xs text-gray-500">
        <nav class="flex items-center gap-2 font-medium">
            <a asp-controller="Home" asp-action="Index" class="hover:text-blue-600 transition-colors flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                Trang chủ
            </a>
            <span class="text-gray-300">/</span>
            <a asp-controller="Posts" asp-action="Index" class="hover:text-blue-600 transition-colors">Bài viết</a>
            <span class="text-gray-300">/</span>
            <span class="text-gray-800 font-semibold truncate max-w-[200px] sm:max-w-[320px]">@Model.Title</span>
        </nav>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-gray-900 bg-white px-3.5 py-1.5 rounded-xl border border-gray-200 shadow-xs transition-all hover:bg-gray-50 active:scale-95">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                Quay lại danh sách
            </a>
            @if (canEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 px-3.5 py-1.5 rounded-xl transition-all border border-blue-100 active:scale-95">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    Chỉnh sửa
                </a>
            }
        </div>
    </div>

    <!-- ============================================================== -->
    <!-- MAIN ARTICLE CARD (ELEVATED, CLEAN, PROFESSIONAL READING VIEW) -->
    <!-- ============================================================== -->
    <article class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-100/90 space-y-7">
        <!-- Article Header Badges -->
        <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-1 px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-xs font-bold uppercase tracking-wider border border-blue-100/80">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                @(!string.IsNullOrEmpty(Model.CategoryName) ? Model.CategoryName : "Chuyên mục chung")
            </span>
            @if (!string.IsNullOrEmpty(Model.DepartmentName))
            {
                <span class="inline-flex items-center gap-1 px-3 py-1 bg-purple-50 text-purple-700 rounded-full text-xs font-bold uppercase tracking-wider border border-purple-100/80">
                    🏢 @Model.DepartmentName
                </span>
            }
            @if (Model.IsPublished)
            {
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-full text-xs font-semibold border border-emerald-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Đã xuất bản
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-amber-50 text-amber-700 rounded-full text-xs font-semibold border border-amber-100">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Bản nháp
                </span>
            }
            <span class="text-gray-400 text-xs flex items-center gap-1 ml-auto">
                <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                3 phút đọc
            </span>
        </div>

        <!-- Article Title -->
        <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight leading-tight">
            @Model.Title
        </h1>

        <!-- YouTube Channel / Author & Reaction Pill Bar -->
        <div class="p-3.5 sm:p-4 rounded-2xl bg-gray-50/90 border border-gray-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <!-- Channel / Author Profile -->
            <div class="flex items-center gap-3">
                <div class="relative flex-shrink-0">
                    <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-purple-600 via-pink-500 to-rose-400 text-white font-black flex items-center justify-center text-base shadow-sm ring-2 ring-white">
                        @authorInitial
                    </div>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <h4 class="font-bold text-gray-900 text-sm sm:text-base hover:text-blue-600 transition-colors">
                            @authorName
                        </h4>
                        <!-- Verified Checkmark Badge -->
                        <span title="Đã xác minh" class="inline-flex text-gray-500">
                            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-1.9 14.7l-4.2-4.2 1.4-1.4 2.8 2.8 6.8-6.8 1.4 1.4-8.2 8.2z"/></svg>
                        </span>
                    </div>
                    <p class="text-xs text-gray-500">1.9M người đăng ký</p>
                </div>
                <!-- Subscribe Button -->
                <button type="button" onclick="toggleSubscribe(this)" id="btnSubscribe" class="ml-2 px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white text-xs font-bold rounded-full transition-all flex items-center gap-1.5 active:scale-95 shadow-sm">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                    <span id="subscribeBtnText">Đăng ký</span>
                </button>
            </div>

            <!-- YouTube Action Buttons (Combined Like/Dislike Pill + Share + Save) -->
            <div class="flex items-center gap-2 flex-wrap">
                <!-- Combined Like / Dislike Pill -->
                <div class="inline-flex items-center bg-white border border-gray-200 hover:border-gray-300 rounded-full text-xs font-semibold text-gray-800 transition-all shadow-xs overflow-hidden">
                    <!-- Like Button -->
                    <button type="button" onclick="toggleLike()" id="btnLike" class="inline-flex items-center gap-2 px-4 py-2 hover:bg-gray-50 active:scale-95 transition-all text-gray-800">
                        <svg id="iconLike" class="w-4 h-4 text-gray-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/>
                        </svg>
                        <span id="likeCountDisplay" class="font-bold">150K</span>
                    </button>
                    <!-- Divider line -->
                    <div class="w-px h-5 bg-gray-200"></div>
                    <!-- Dislike Button -->
                    <button type="button" onclick="toggleDislike()" id="btnDislike" class="px-3.5 py-2 hover:bg-gray-50 active:scale-95 transition-all text-gray-800">
                        <svg id="iconDislike" class="w-4 h-4 text-gray-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018c.163 0 .326.02.485.06L17 4m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m7-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/>
                        </svg>
                    </button>
                </div>

                <!-- Share Pill -->
                <button type="button" onclick="shareArticle()" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-800 rounded-full text-xs font-semibold transition-all shadow-xs active:scale-95">
                    <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                    </svg>
                    <span>Chia sẻ</span>
                </button>

                <!-- Save Pill -->
                <button type="button" onclick="saveArticle()" id="btnSave" class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-800 rounded-full text-xs font-semibold transition-all shadow-xs active:scale-95">
                    <svg id="iconSave" class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                    </svg>
                    <span id="saveText">Lưu</span>
                </button>
            </div>
        </div>

        <!-- Article Summary Lead (if present) -->
        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-blue-50/70 to-indigo-50/40 border-l-4 border-blue-600 text-gray-800 text-sm sm:text-base italic font-medium leading-relaxed shadow-xs">
                <span class="block text-xs font-bold uppercase tracking-wider text-blue-700 not-italic mb-1">Tóm tắt nội dung</span>
                @Model.Summary
            </div>
        }

        <!-- Article Full Content Body -->
        <div class="prose prose-slate max-w-none text-base sm:text-lg text-gray-800 leading-relaxed space-y-4 whitespace-pre-line font-normal">
            @Model.Content
        </div>

        <!-- Article Metadata & Tags Footer -->
        <div class="pt-6 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-gray-500">
            <div class="flex items-center gap-3 flex-wrap">
                <span class="font-bold text-gray-700">15.2K lượt đọc</span>
                <span>•</span>
                <span>Xuất bản ngày @Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                <span>•</span>
                <div class="inline-flex items-center gap-1.5 flex-wrap">
                    @if (Model.TagNames != null && Model.TagNames.Any())
                    {
                        @foreach (var tag in Model.TagNames)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100 hover:bg-blue-100 transition-colors">
                                #@tag
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-blue-600 font-semibold">#@categorySlug #cms</span>
                    }
                </div>
            </div>
            <div class="flex items-center gap-2">
                <button type="button" onclick="shareArticle()" class="text-blue-600 hover:text-blue-700 font-bold hover:underline">
                    Chia sẻ bài viết &rarr;
                </button>
            </div>
        </div>
    </article>

    <!-- Toast Notification -->
    <div id="ytToast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 bg-gray-900 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-xl flex items-center gap-2">
        <span id="ytToastText">Đã thực hiện</span>
    </div>

    <!-- ============================================================== -->
    <!-- YOUTUBE COMMENTS CARD (CLEAN, ELEVATED, YOUTUBE-STYLE COMMENTS) -->
    <!-- ============================================================== -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-100 space-y-7">
        <!-- Comments Header (Count + Sort) -->
        <div class="flex items-center gap-8 pb-2">
            <h3 class="text-xl font-black text-gray-900 tracking-tight">
                <span id="commentTotalCount">2,698</span> Bình luận
            </h3>
            <div class="relative">
                <button type="button" onclick="toggleSortDropdown()" class="inline-flex items-center gap-2 text-xs font-bold text-gray-700 hover:text-gray-900 px-3 py-1.5 rounded-xl hover:bg-gray-100 transition-colors">
                    <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h18M3 10h12M3 16h6"/>
                    </svg>
                    <span id="currentSortText">Sắp xếp theo</span>
                </button>
                <div id="sortDropdown" class="hidden absolute left-0 mt-1 w-44 bg-white rounded-xl shadow-lg border border-gray-100 py-1.5 z-20 text-xs font-medium">
                    <button type="button" onclick="setSortOrder('top')" class="w-full text-left px-4 py-2 hover:bg-gray-50 text-gray-800 font-semibold">Bình luận hàng đầu</button>
                    <button type="button" onclick="setSortOrder('newest')" class="w-full text-left px-4 py-2 hover:bg-gray-50 text-gray-800">Mới nhất trước</button>
                </div>
            </div>
        </div>

        <!-- Add Comment Input Box (YouTube Underline Style) -->
        <div class="flex items-start gap-4">
            <div class="w-10 h-10 rounded-full bg-indigo-600 text-white font-black flex items-center justify-center text-sm flex-shrink-0 shadow-sm">
                @userInitial
            </div>
            <div class="flex-1 space-y-2">
                <div class="relative">
                    <input type="text" id="commentInput" placeholder="Viết bình luận..." onfocus="onCommentFocus()" oninput="onCommentInput()" class="w-full pb-1 text-sm bg-transparent border-b border-gray-200 focus:border-gray-900 outline-none transition-colors placeholder-gray-500" />
                </div>
                <!-- Action Buttons (Shown on Focus) -->
                <div id="commentActionRow" class="hidden flex items-center justify-end gap-2 pt-1">
                    <button type="button" onclick="cancelComment()" class="px-4 py-1.5 text-xs font-bold text-gray-700 hover:bg-gray-100 rounded-full transition-all">
                        Hủy
                    </button>
                    <button type="button" onclick="submitComment()" id="btnSubmitComment" disabled class="px-4 py-1.5 text-xs font-bold text-gray-400 bg-gray-100 rounded-full transition-all cursor-not-allowed">
                        Bình luận
                    </button>
                </div>
            </div>
        </div>

        <!-- Dynamic User Submitted Comments Container -->
        <div id="userCommentsList" class="space-y-6"></div>

        <!-- Pre-existing YouTube Sample Comments (from Reference Image) -->
        <div class="space-y-6 pt-2">
            <!-- Comment 1 -->
            <div class="flex items-start gap-4 group">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-amber-400 to-orange-500 text-white font-bold flex items-center justify-center text-sm flex-shrink-0 shadow-sm">
                    N
                </div>
                <div class="flex-1 space-y-1">
                    <div class="flex items-center gap-2 text-xs">
                        <span class="font-bold text-gray-900">&#64;nox9749</span>
                        <span class="text-gray-500">7 năm trước</span>
                    </div>
                    <div class="text-sm text-gray-800 leading-relaxed">
                        <p>Mom: how can someone be sweet and a psycho</p>
                        <p class="mt-1">Me: ever heard of a yandere...?</p>
                    </div>
                    <button type="button" onclick="showToast('Bản dịch tiếng Việt đã được hiển thị!')" class="text-xs text-blue-600 hover:underline cursor-pointer block pt-0.5">
                        Dịch sang Tiếng Việt
                    </button>
                    <!-- Reaction line for comment 1 -->
                    <div class="flex items-center gap-3 pt-1 text-xs text-gray-600">
                        <button type="button" onclick="toggleCommentLike(this, 'nox_like')" class="inline-flex items-center gap-1.5 p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all">
                            <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg>
                            <span class="font-bold text-gray-700 text-xs">3.1k</span>
                        </button>
                        <button type="button" onclick="toggleCommentDislike(this)" class="p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all text-gray-700">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018c.163 0 .326.02.485.06L17 4m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m7-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/></svg>
                        </button>
                        <button type="button" onclick="openReplyBox('reply-box-1')" class="px-2.5 py-1 text-xs font-bold text-gray-700 hover:bg-gray-100 rounded-full transition-all">
                            Phản hồi
                        </button>
                    </div>

                    <!-- Inline Reply Input Box (Hidden by default) -->
                    <div id="reply-box-1" class="hidden pt-3 pl-2">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                                @userInitial
                            </div>
                            <div class="flex-1 space-y-1.5">
                                <input type="text" id="reply-input-1" placeholder="Phản hồi &#64;nox9749..." class="w-full pb-1 text-xs bg-transparent border-b border-gray-200 focus:border-gray-900 outline-none transition-colors" />
                                <div class="flex justify-end gap-2 pt-1">
                                    <button type="button" onclick="closeReplyBox('reply-box-1')" class="px-3 py-1 text-[11px] font-bold text-gray-600 hover:bg-gray-100 rounded-full">Hủy</button>
                                    <button type="button" onclick="submitReply('reply-box-1', 'reply-input-1', 'replies-thread-1')" class="px-3 py-1 text-[11px] font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full">Phản hồi</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Nested Replies Dropdown Toggle (83 replies) -->
                    <div class="pt-1">
                        <button type="button" onclick="toggleReplies('replies-thread-1', 'reply-toggle-icon-1')" class="inline-flex items-center gap-2 text-xs font-bold text-blue-600 hover:bg-blue-50 px-3 py-1.5 rounded-full transition-all">
                            <svg id="reply-toggle-icon-1" class="w-3.5 h-3.5 transform transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                            <span>83 phản hồi</span>
                        </button>

                        <!-- Nested Replies List -->
                        <div id="replies-thread-1" class="hidden pl-6 mt-3 space-y-4 border-l-2 border-gray-100">
                            <!-- Reply A -->
                            <div class="flex items-start gap-3">
                                <div class="w-8 h-8 rounded-full bg-emerald-500 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                                    Y
                                </div>
                                <div class="flex-1 space-y-0.5">
                                    <div class="flex items-center gap-2 text-xs">
                                        <span class="font-bold text-gray-900">&#64;yandere_lover</span>
                                        <span class="text-gray-500">7 năm trước</span>
                                    </div>
                                    <p class="text-xs text-gray-800">Haha true, Yandere is the best archetype! Gasai Yuno approves 👍</p>
                                    <div class="flex items-center gap-2 pt-0.5 text-xs text-gray-600">
                                        <button type="button" onclick="toggleCommentLike(this)" class="inline-flex items-center gap-1 hover:text-blue-600"><span class="text-xs">👍</span> <span class="font-semibold text-[11px]">245</span></button>
                                        <button type="button" onclick="toggleCommentDislike(this)" class="hover:text-blue-600"><span class="text-xs">👎</span></button>
                                        <button type="button" onclick="openReplyBox('reply-box-1')" class="font-semibold text-[11px] text-gray-600 hover:text-gray-900 ml-1">Phản hồi</button>
                                    </div>
                                </div>
                            </div>

                            <!-- Reply B -->
                            <div class="flex items-start gap-3">
                                <div class="w-8 h-8 rounded-full bg-blue-500 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                                    M
                                </div>
                                <div class="flex-1 space-y-0.5">
                                    <div class="flex items-center gap-2 text-xs">
                                        <span class="font-bold text-gray-900">&#64;music_vibes</span>
                                        <span class="text-gray-500">6 năm trước</span>
                                    </div>
                                    <p class="text-xs text-gray-800">Nội dung bài chia sẻ rất hay và bổ ích cho mọi người! 🔥</p>
                                    <div class="flex items-center gap-2 pt-0.5 text-xs text-gray-600">
                                        <button type="button" onclick="toggleCommentLike(this)" class="inline-flex items-center gap-1 hover:text-blue-600"><span class="text-xs">👍</span> <span class="font-semibold text-[11px]">180</span></button>
                                        <button type="button" onclick="toggleCommentDislike(this)" class="hover:text-blue-600"><span class="text-xs">👎</span></button>
                                        <button type="button" onclick="openReplyBox('reply-box-1')" class="font-semibold text-[11px] text-gray-600 hover:text-gray-900 ml-1">Phản hồi</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comment 2 -->
            <div class="flex items-start gap-4 group">
                <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-sky-400 to-indigo-500 text-white font-bold flex items-center justify-center text-sm flex-shrink-0 shadow-sm">
                    X
                </div>
                <div class="flex-1 space-y-1">
                    <div class="flex items-center gap-2 text-xs">
                        <span class="font-bold text-gray-900">&#64;xiaomogui</span>
                        <span class="text-gray-500">7 năm trước</span>
                    </div>
                    <div class="text-sm text-gray-800 leading-relaxed">
                        <p>Bài viết chia sẻ rất chi tiết và dễ hiểu, mong tác giả ra thêm nhiều bài nữa nhé!</p>
                    </div>
                    <!-- Reaction line for comment 2 -->
                    <div class="flex items-center gap-3 pt-1 text-xs text-gray-600">
                        <button type="button" onclick="toggleCommentLike(this, 'xiao_like')" class="inline-flex items-center gap-1.5 p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all">
                            <svg class="w-4 h-4 text-gray-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg>
                            <span class="font-bold text-gray-700 text-xs">1.2k</span>
                        </button>
                        <button type="button" onclick="toggleCommentDislike(this)" class="p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all text-gray-700">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018c.163 0 .326.02.485.06L17 4m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m7-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/></svg>
                        </button>
                        <button type="button" onclick="openReplyBox('reply-box-2')" class="px-2.5 py-1 text-xs font-bold text-gray-700 hover:bg-gray-100 rounded-full transition-all">
                            Phản hồi
                        </button>
                    </div>

                    <!-- Inline Reply Input Box 2 -->
                    <div id="reply-box-2" class="hidden pt-3 pl-2">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                                @userInitial
                            </div>
                            <div class="flex-1 space-y-1.5">
                                <input type="text" id="reply-input-2" placeholder="Phản hồi &#64;xiaomogui..." class="w-full pb-1 text-xs bg-transparent border-b border-gray-200 focus:border-gray-900 outline-none transition-colors" />
                                <div class="flex justify-end gap-2 pt-1">
                                    <button type="button" onclick="closeReplyBox('reply-box-2')" class="px-3 py-1 text-[11px] font-bold text-gray-600 hover:bg-gray-100 rounded-full">Hủy</button>
                                    <button type="button" onclick="submitReply('reply-box-2', 'reply-input-2', 'replies-thread-2')" class="px-3 py-1 text-[11px] font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full">Phản hồi</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const POST_ID = '@Model.Id';
        const CURRENT_USER_NAME = '@currentUserName';
        const CURRENT_USER_INITIAL = '@userInitial';

        // Local Storage Keys
        const LIKE_KEY = 'yt_like_' + POST_ID;
        const DISLIKE_KEY = 'yt_dislike_' + POST_ID;
        const SUB_KEY = 'yt_sub_author';
        const SAVE_KEY = 'yt_save_' + POST_ID;
        const COMMENTS_KEY = 'yt_comments_' + POST_ID;

        document.addEventListener('DOMContentLoaded', function () {
            initReactions();
            initSubscribe();
            initSaveState();
            loadCustomComments();
        });

        // ==========================================
        // 1. LIKE & DISLIKE (YOUTUBE PILL)
        // ==========================================
        let isLiked = localStorage.getItem(LIKE_KEY) === 'true';
        let isDisliked = localStorage.getItem(DISLIKE_KEY) === 'true';
        let baseLikeCount = 150000;

        function initReactions() {
            updateReactionUI();
        }

        function toggleLike() {
            if (isLiked) {
                isLiked = false;
            } else {
                isLiked = true;
                if (isDisliked) isDisliked = false;
                showToast('Đã thích bài viết');
            }
            saveReactionState();
            updateReactionUI();
        }

        function toggleDislike() {
            if (isDisliked) {
                isDisliked = false;
            } else {
                isDisliked = true;
                if (isLiked) isLiked = false;
                showToast('Đã không thích bài viết');
            }
            saveReactionState();
            updateReactionUI();
        }

        function saveReactionState() {
            localStorage.setItem(LIKE_KEY, isLiked);
            localStorage.setItem(DISLIKE_KEY, isDisliked);
        }

        function updateReactionUI() {
            const btnLike = document.getElementById('btnLike');
            const btnDislike = document.getElementById('btnDislike');
            const iconLike = document.getElementById('iconLike');
            const iconDislike = document.getElementById('iconDislike');
            const likeText = document.getElementById('likeCountDisplay');

            let currentCount = baseLikeCount + (isLiked ? 1 : 0);
            if (likeText) {
                likeText.innerText = currentCount >= 1000 ? (currentCount / 1000).toFixed(0) + 'K' : currentCount;
            }

            if (isLiked) {
                btnLike?.classList.add('text-blue-600', 'font-bold');
                iconLike?.setAttribute('fill', 'currentColor');
            } else {
                btnLike?.classList.remove('text-blue-600', 'font-bold');
                iconLike?.setAttribute('fill', 'none');
            }

            if (isDisliked) {
                btnDislike?.classList.add('text-blue-600');
                iconDislike?.setAttribute('fill', 'currentColor');
            } else {
                btnDislike?.classList.remove('text-blue-600');
                iconDislike?.setAttribute('fill', 'none');
            }
        }

        // ==========================================
        // 2. SUBSCRIBE BUTTON
        // ==========================================
        function initSubscribe() {
            const isSubbed = localStorage.getItem(SUB_KEY) === 'true';
            const btn = document.getElementById('btnSubscribe');
            const text = document.getElementById('subscribeBtnText');
            if (isSubbed && btn && text) {
                btn.className = 'ml-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold rounded-full transition-all flex items-center gap-1.5';
                text.innerText = 'Đã đăng ký';
            }
        }

        function toggleSubscribe(btn) {
            const text = document.getElementById('subscribeBtnText');
            const isSubbed = localStorage.getItem(SUB_KEY) === 'true';
            if (isSubbed) {
                localStorage.setItem(SUB_KEY, 'false');
                btn.className = 'ml-2 px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white text-xs font-bold rounded-full transition-all flex items-center gap-1.5 shadow-sm';
                if (text) text.innerText = 'Đăng ký';
                showToast('Đã hủy đăng ký');
            } else {
                localStorage.setItem(SUB_KEY, 'true');
                btn.className = 'ml-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold rounded-full transition-all flex items-center gap-1.5';
                if (text) text.innerText = 'Đã đăng ký';
                showToast('Đã đăng ký kênh tác giả');
            }
        }

        // ==========================================
        // 3. SHARE & SAVE (BOOKMARK)
        // ==========================================
        function shareArticle() {
            navigator.clipboard.writeText(window.location.href);
            showToast('Đã sao chép liên kết vào bộ nhớ tạm!');
        }

        function initSaveState() {
            const isSaved = localStorage.getItem(SAVE_KEY) === 'true';
            const iconSave = document.getElementById('iconSave');
            const saveText = document.getElementById('saveText');
            if (isSaved) {
                iconSave?.setAttribute('fill', 'currentColor');
                if (saveText) saveText.innerText = 'Đã lưu';
            }
        }

        function saveArticle() {
            const isSaved = localStorage.getItem(SAVE_KEY) === 'true';
            const iconSave = document.getElementById('iconSave');
            const saveText = document.getElementById('saveText');
            if (isSaved) {
                localStorage.setItem(SAVE_KEY, 'false');
                iconSave?.setAttribute('fill', 'none');
                if (saveText) saveText.innerText = 'Lưu';
                showToast('Đã bỏ lưu bài viết');
            } else {
                localStorage.setItem(SAVE_KEY, 'true');
                iconSave?.setAttribute('fill', 'currentColor');
                if (saveText) saveText.innerText = 'Đã lưu';
                showToast('Đã lưu bài viết vào thư viện!');
            }
        }

        // ==========================================
        // 4. YOUTUBE COMMENTS INTERACTION
        // ==========================================
        function onCommentFocus() {
            const actionRow = document.getElementById('commentActionRow');
            if (actionRow) actionRow.classList.remove('hidden');
        }

        function onCommentInput() {
            const input = document.getElementById('commentInput');
            const btn = document.getElementById('btnSubmitComment');
            if (!input || !btn) return;

            if (input.value.trim().length > 0) {
                btn.disabled = false;
                btn.className = 'px-4 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full transition-all active:scale-95 shadow-sm';
            } else {
                btn.disabled = true;
                btn.className = 'px-4 py-1.5 text-xs font-bold text-gray-400 bg-gray-100 rounded-full transition-all cursor-not-allowed';
            }
        }

        function cancelComment() {
            const input = document.getElementById('commentInput');
            const actionRow = document.getElementById('commentActionRow');
            if (input) input.value = '';
            if (actionRow) actionRow.classList.add('hidden');
            onCommentInput();
        }

        function submitComment() {
            const input = document.getElementById('commentInput');
            const text = input ? input.value.trim() : '';
            if (!text) return;

            const newComment = {
                id: 'yt_' + Date.now(),
                author: CURRENT_USER_NAME || 'Bạn đọc',
                handle: '@@' + (CURRENT_USER_NAME.toLowerCase().replace(/\s+/g, '') || 'user'),
                initial: CURRENT_USER_INITIAL || 'U',
                content: text,
                time: 'Vừa xong',
                likes: 0,
                replies: []
            };

            // Save to localStorage
            const saved = JSON.parse(localStorage.getItem(COMMENTS_KEY) || '[]');
            saved.unshift(newComment);
            localStorage.setItem(COMMENTS_KEY, JSON.stringify(saved));

            // Render immediately
            renderUserComment(newComment, true);

            // Update comment count
            updateCommentCount(1);

            // Sync with backend API
            fetch('/api/comments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    postId: POST_ID,
                    content: text,
                    createdAt: new Date().toISOString(),
                    isApproved: true
                })
            }).catch(e => console.log('Comment sync info:', e));

            cancelComment();
            showToast('Đã đăng bình luận');
        }

        function renderUserComment(c, isNew = false) {
            const container = document.getElementById('userCommentsList');
            if (!container) return;

            const div = document.createElement('div');
            div.className = `flex items-start gap-4 group transition-all ${isNew ? 'bg-blue-50/40 p-3 rounded-2xl ring-1 ring-blue-100' : ''}`;
            div.id = 'comment_' + c.id;
            div.innerHTML = `
                <div class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-sm flex-shrink-0 shadow-sm">
                    ${c.initial || 'U'}
                </div>
                <div class="flex-1 space-y-1">
                    <div class="flex items-center gap-2 text-xs">
                        <span class="font-bold text-gray-900">${c.handle || '&#64;user'}</span>
                        <span class="text-gray-500">${c.time || 'Vừa xong'}</span>
                        ${isNew ? '<span class="text-[10px] bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded font-bold">Mới</span>' : ''}
                    </div>
                    <p class="text-sm text-gray-800 leading-relaxed">${escapeHtml(c.content)}</p>
                    <div class="flex items-center gap-3 pt-1 text-xs text-gray-600">
                        <button type="button" onclick="toggleCommentLike(this)" class="inline-flex items-center gap-1.5 p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all text-gray-700">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg>
                            <span class="font-bold text-gray-700 text-xs">${c.likes || 0}</span>
                        </button>
                        <button type="button" onclick="toggleCommentDislike(this)" class="p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all text-gray-700">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018c.163 0 .326.02.485.06L17 4m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412-.608 2.006L17 13V4m-7 10h2m7-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/></svg>
                        </button>
                        <button type="button" onclick="openReplyBox('reply_${c.id}')" class="px-2.5 py-1 text-xs font-bold text-gray-700 hover:bg-gray-100 rounded-full transition-all">
                            Phản hồi
                        </button>
                    </div>

                    <!-- Dynamic Reply Box -->
                    <div id="reply_${c.id}" class="hidden pt-3 pl-2">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                                ${CURRENT_USER_INITIAL || 'U'}
                            </div>
                            <div class="flex-1 space-y-1.5">
                                <input type="text" id="reply_input_${c.id}" placeholder="Phản hồi ${c.handle}..." class="w-full pb-1 text-xs bg-transparent border-b border-gray-200 focus:border-gray-900 outline-none transition-colors" />
                                <div class="flex justify-end gap-2 pt-1">
                                    <button type="button" onclick="closeReplyBox('reply_${c.id}')" class="px-3 py-1 text-[11px] font-bold text-gray-600 hover:bg-gray-100 rounded-full">Hủy</button>
                                    <button type="button" onclick="submitReply('reply_${c.id}', 'reply_input_${c.id}', 'thread_${c.id}')" class="px-3 py-1 text-[11px] font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full">Phản hồi</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="thread_${c.id}" class="hidden pl-6 mt-3 space-y-3 border-l-2 border-gray-100"></div>
                </div>
            `;
            container.prepend(div);
        }

        function loadCustomComments() {
            const saved = JSON.parse(localStorage.getItem(COMMENTS_KEY) || '[]');
            if (saved.length > 0) {
                updateCommentCount(saved.length);
                saved.reverse().forEach(c => renderUserComment(c, false));
            }
        }

        function updateCommentCount(delta) {
            const el = document.getElementById('commentTotalCount');
            if (!el) return;
            let current = parseInt(el.innerText.replace(/,/g, '')) || 2698;
            current += delta;
            el.innerText = current.toLocaleString();
        }

        // ==========================================
        // 5. INLINE REPLIES TOGGLES
        // ==========================================
        function toggleCommentLike(btn, key) {
            const span = btn.querySelector('span');
            const svg = btn.querySelector('svg');
            const isPressed = btn.getAttribute('data-liked') === 'true';

            if (isPressed) {
                btn.removeAttribute('data-liked');
                btn.classList.remove('text-blue-600');
                if (svg) svg.setAttribute('fill', 'none');
            } else {
                btn.setAttribute('data-liked', 'true');
                btn.classList.add('text-blue-600');
                if (svg) svg.setAttribute('fill', 'currentColor');
                showToast('Đã thích bình luận');
            }
        }

        function toggleCommentDislike(btn) {
            btn.classList.toggle('text-blue-600');
        }

        function openReplyBox(boxId) {
            const box = document.getElementById(boxId);
            if (box) {
                box.classList.remove('hidden');
                const input = box.querySelector('input');
                if (input) input.focus();
            }
        }

        function closeReplyBox(boxId) {
            const box = document.getElementById(boxId);
            if (box) box.classList.add('hidden');
        }

        function submitReply(boxId, inputId, threadId) {
            const input = document.getElementById(inputId);
            const text = input ? input.value.trim() : '';
            if (!text) return;

            const thread = document.getElementById(threadId);
            if (thread) {
                thread.classList.remove('hidden');
                const replyDiv = document.createElement('div');
                replyDiv.className = 'flex items-start gap-3 pt-2';
                replyDiv.innerHTML = `
                    <div class="w-8 h-8 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                        ${CURRENT_USER_INITIAL || 'U'}
                    </div>
                    <div class="flex-1 space-y-0.5">
                        <div class="flex items-center gap-2 text-xs">
                            <span class="font-bold text-gray-900">&#64;${CURRENT_USER_NAME.toLowerCase().replace(/\s+/g, '')}</span>
                            <span class="text-gray-500">Vừa xong</span>
                        </div>
                        <p class="text-xs text-gray-800 leading-relaxed">${escapeHtml(text)}</p>
                    </div>
                `;
                thread.appendChild(replyDiv);
            }

            input.value = '';
            closeReplyBox(boxId);
            showToast('Đã đăng câu trả lời');
        }

        function toggleReplies(threadId, iconId) {
            const thread = document.getElementById(threadId);
            const icon = document.getElementById(iconId);
            if (!thread) return;

            const isHidden = thread.classList.contains('hidden');
            if (isHidden) {
                thread.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(180deg)';
            } else {
                thread.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
            }
        }

        // ==========================================
        // 6. SORT DROPDOWN
        // ==========================================
        function toggleSortDropdown() {
            const dd = document.getElementById('sortDropdown');
            if (dd) dd.classList.toggle('hidden');
        }

        function setSortOrder(type) {
            const label = document.getElementById('currentSortText');
            if (label) {
                label.innerText = type === 'top' ? 'Bình luận hàng đầu' : 'Mới nhất trước';
            }
            toggleSortDropdown();
            showToast('Đã sắp xếp lại bình luận');
        }

        // ==========================================
        // 7. TOAST NOTIFICATION HELPER
        // ==========================================
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('ytToast');
            const text = document.getElementById('ytToastText');
            if (!toast || !text) return;

            text.innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        }

        function escapeHtml(str) {
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
}

