@model ContentManagementSystem.ApplicationCore.DTOs.PostDto

@{
    ViewData["Title"] = "Chi tiết bài viết";
    Layout = "_Layout";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chi tiết bài viết</h2>
            <p class="text-sm text-gray-500 mt-1">Xem thông tin và nội dung đầy đủ của bài viết.</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="inline-flex items-center gap-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
                &larr; Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-xl shadow-sm transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                Chỉnh sửa
            </a>
        </div>
    </div>

    <!-- Details Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <!-- Top banner/meta -->
        <div class="p-6 sm:p-8 border-b border-gray-100 space-y-4">
            <div class="flex flex-wrap items-center gap-2">
                <span class="px-3 py-1 bg-blue-50 text-blue-700 rounded-lg text-xs font-semibold">
                    @(!string.IsNullOrEmpty(Model.CategoryName) ? Model.CategoryName : "Chưa phân loại")
                </span>
                @if (Model.IsPublished)
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-50 text-green-700 rounded-full text-xs font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                        Đã xuất bản
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 text-amber-700 rounded-full text-xs font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        Bản nháp
                    </span>
                }
            </div>

            <h1 class="text-3xl font-extrabold text-gray-900 leading-tight">@Model.Title</h1>

            <div class="flex flex-wrap items-center gap-4 text-xs text-gray-400">
                <span class="flex items-center gap-1">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                    Tác giả: <strong class="text-gray-600">@(!string.IsNullOrEmpty(Model.AuthorName) ? Model.AuthorName : Model.AuthorId)</strong>
                </span>
                <span class="flex items-center gap-1">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    Ngày tạo: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </span>
                <span>Slug: <code class="bg-gray-100 text-gray-600 px-2 py-0.5 rounded text-xs">@Model.Slug</code></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Summary))
            {
                <div class="p-4 bg-gray-50 rounded-xl border border-gray-100 text-gray-600 text-sm italic">
                    @Model.Summary
                </div>
            }
        </div>

        <!-- Content Body -->
        <div class="p-6 sm:p-8 prose max-w-none text-gray-700 leading-relaxed whitespace-pre-line text-sm sm:text-base">
            @Model.Content
        </div>
    </div>
</div>

