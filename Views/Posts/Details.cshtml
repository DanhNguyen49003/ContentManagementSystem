@model ContentManagementSystem.ApplicationCore.DTOs.PostDto
@using ContentManagementSystem.Services
@inject ICurrentUserService CurrentUserService

@{
    ViewData["Title"] = Model.Title ?? "Chi tiết bài viết";
    Layout = "_Layout";
    var currentUser = await CurrentUserService.GetCurrentUserAsync();
    var currentUserName = currentUser.IsAuthenticated ? currentUser.DisplayName : "Bạn đọc";
    var userInitial = !string.IsNullOrEmpty(currentUserName) ? currentUserName.Substring(0, 1).ToUpper() : "U";
    var isAnonymous = Model.IsAnonymous;
    var displayAuthorName = isAnonymous ? "Người dùng ẩn danh" : (!string.IsNullOrEmpty(Model.AuthorName) ? Model.AuthorName : "Tác giả");
    var authorInitial = isAnonymous ? "🎭" : displayAuthorName.Substring(0, 1).ToUpper();
    var canEdit = currentUser.IsAdmin || currentUser.IsQAManager || currentUser.IsQACoordinator;
    var categorySlug = Model.CategoryName?.Replace(" ", "").ToLower() ?? "cms";
}

<div class="max-w-4xl mx-auto space-y-6 pb-20">
    <!-- Top Breadcrumb & Back Navigation -->
    <div class="flex items-center justify-between text-xs text-gray-500">
        <nav class="flex items-center gap-2 font-medium">
            <a asp-controller="Home" asp-action="Index" class="hover:text-blue-600 transition-colors flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                Trang chủ
            </a>
            <span class="text-gray-300">/</span>
            <a asp-controller="Posts" asp-action="Index" class="hover:text-blue-600 transition-colors">Bài viết</a>
            <span class="text-gray-300">/</span>
            <span class="text-gray-800 font-semibold truncate max-w-[200px] sm:max-w-[320px]">@Model.Title</span>
        </nav>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-semibold text-gray-600 hover:text-gray-900 bg-white px-3.5 py-1.5 rounded-xl border border-gray-200 shadow-xs transition-all hover:bg-gray-50 active:scale-95">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                Quay lại danh sách
            </a>
            @if (canEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1 text-xs font-bold text-blue-600 hover:text-blue-700 bg-blue-50 hover:bg-blue-100 px-3.5 py-1.5 rounded-xl transition-all border border-blue-100 active:scale-95">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    Chỉnh sửa
                </a>
            }
        </div>
    </div>

    @{
        var postStatus = Model.Status ?? "Pending";
        var isAuthorView = currentUser.IsAuthenticated && !currentUser.IsAdmin && !currentUser.IsQACoordinator && !currentUser.IsQAManager;
    }

    @* ── AUTHOR VIEW: feedback from reviewer ── *@
    @if ((postStatus == "ChangesRequested" || postStatus == "Rejected") && isAuthorView)
    {
        var feedbackBg = postStatus == "Rejected" ? "from-red-50 to-rose-50 border-red-200/80" : "from-amber-50 to-yellow-50 border-amber-200/80";
        var feedbackIcon = postStatus == "Rejected" ? "❌" : "🔄";
        var feedbackLabel = postStatus == "Rejected" ? "Bài viết đã bị TỪ CHỐI" : "Bài viết CẦN SỬA ĐỔI";
        var feedbackTextColor = postStatus == "Rejected" ? "text-red-900" : "text-amber-900";
        var feedbackSubColor = postStatus == "Rejected" ? "text-red-700" : "text-amber-700";
        <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r @feedbackBg border flex flex-col gap-3 shadow-sm">
            <div class="flex items-start gap-3">
                <span class="text-2xl">@feedbackIcon</span>
                <div class="flex-1">
                    <h4 class="font-bold @feedbackTextColor text-sm">@feedbackLabel</h4>
                    @if (!string.IsNullOrEmpty(Model.ReviewerFeedback))
                    {
                        <p class="text-xs @feedbackSubColor mt-1 leading-relaxed">Phản hồi từ ban kiểm duyệt:</p>
                        <blockquote class="mt-1 p-3 bg-white/70 rounded-xl border text-xs @feedbackTextColor font-medium italic leading-relaxed">
                            @Model.ReviewerFeedback
                        </blockquote>
                    }
                    @if (postStatus == "ChangesRequested")
                    {
                        <div class="mt-3">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-xl shadow-sm transition-all active:scale-95">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                Chỉnh sửa và nộp lại
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @* ── REVIEWER PANEL: 3-action review ── *@
    @if (!Model.IsPublished && ViewBag.CanApprove == true)
    {
        <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 flex flex-col gap-4 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                <div class="flex items-start gap-3">
                    <div class="p-2 bg-amber-100 text-amber-700 rounded-xl flex-shrink-0">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <div>
                        <h4 class="font-bold text-amber-900 text-sm">
                            Bài viết đang chờ duyệt
                            <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-200 text-amber-900">
                                @(postStatus == "ChangesRequested" ? "🔄 Chờ sửa đổi" : postStatus == "Rejected" ? "❌ Đã từ chối" : "⏳ Pending")
                            </span>
                        </h4>
                        <p class="text-xs text-amber-700 mt-0.5 leading-relaxed">
                            Xem xét kỹ nội dung và chọn hành động phù hợp bên dưới.
                        </p>
                        @if (!string.IsNullOrEmpty(Model.ReviewerFeedback))
                        {
                            <div class="mt-2 p-2.5 bg-white/70 rounded-lg border border-amber-200 text-xs text-amber-900 italic">
                                <span class="font-bold not-italic">Phản hồi trước:</span> @Model.ReviewerFeedback
                            </div>
                        }
                    </div>
                </div>

                <div class="flex items-center gap-2 flex-wrap sm:flex-nowrap flex-shrink-0">
                    @* Green: Approve *@
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="flex-shrink-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-md shadow-emerald-500/20 transition-all active:scale-95">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                            Duyệt & Xuất bản
                        </button>
                    </form>
                    @* Yellow: Request Changes *@
                    <button type="button" onclick="document.getElementById('modalRequestChanges').classList.remove('hidden')"
                            class="inline-flex items-center gap-1.5 px-4 py-2 bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs rounded-xl shadow-md shadow-amber-500/20 transition-all active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        Yêu cầu sửa đổi
                    </button>
                    @* Red: Reject *@
                    <button type="button" onclick="document.getElementById('modalReject').classList.remove('hidden')"
                            class="inline-flex items-center gap-1.5 px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-bold text-xs rounded-xl shadow-md shadow-red-500/20 transition-all active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        Từ chối
                    </button>
                </div>
            </div>

            @* Tag review strip *@
            <div class="pt-3 border-t border-amber-200/60 flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-bold text-amber-900 flex items-center gap-1">
                        <span>🏷️</span> Thẻ tags đi kèm bài viết:
                    </span>
                    @if (Model.TagNames != null && Model.TagNames.Any())
                    {
                        foreach (var tag in Model.TagNames)
                        {
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-white/80 text-purple-700 border border-purple-200 shadow-xs">
                                #@tag
                            </span>
                        }
                    }
                    else
                    {
                        <span class="text-amber-800 italic">Bài viết này chưa gắn tag nào.</span>
                    }
                </div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="text-[11px] text-amber-700 font-bold hover:underline flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                    Sửa bài & tag trước khi duyệt
                </a>
            </div>
        </div>

        @* ── Modal: Request Changes ── *@
        <div id="modalRequestChanges" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-gray-900 text-base flex items-center gap-2">
                        <span class="text-amber-500">🔄</span> Yêu cầu sửa đổi bài viết
                    </h3>
                    <button type="button" onclick="document.getElementById('modalRequestChanges').classList.add('hidden')" class="p-1 hover:bg-gray-100 rounded-lg transition-colors">
                        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                <p class="text-sm text-gray-600">Mô tả rõ những điểm tác giả cần sửa đổi trước khi bài viết được xuất bản.</p>
                <form asp-action="RequestChanges" asp-route-id="@Model.Id" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <textarea name="feedback" rows="5" required placeholder="Ví dụ: Phần kết luận cần bổ sung thêm dữ liệu thực tế, tiêu đề cần chỉnh lại cho rõ nghĩa hơn..."
                              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-amber-400 focus:ring-2 focus:ring-amber-100 outline-none text-sm text-gray-800 resize-none transition-all"></textarea>
                    <div class="flex justify-end gap-2">
                        <button type="button" onclick="document.getElementById('modalRequestChanges').classList.add('hidden')"
                                class="px-4 py-2 text-xs font-bold text-gray-700 hover:bg-gray-100 rounded-xl transition-all">Hủy</button>
                        <button type="submit"
                                class="px-5 py-2 text-xs font-bold text-white bg-amber-500 hover:bg-amber-600 rounded-xl shadow-sm shadow-amber-200 transition-all active:scale-95">
                            Gửi yêu cầu sửa đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @* ── Modal: Reject ── *@
        <div id="modalReject" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
            <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-gray-900 text-base flex items-center gap-2">
                        <span class="text-red-500">❌</span> Từ chối bài viết
                    </h3>
                    <button type="button" onclick="document.getElementById('modalReject').classList.add('hidden')" class="p-1 hover:bg-gray-100 rounded-lg transition-colors">
                        <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
                <p class="text-sm text-gray-600">Nêu rõ lý do từ chối để tác giả hiểu và cải thiện lần sau.</p>
                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="space-y-3">
                    @Html.AntiForgeryToken()
                    <textarea name="feedback" rows="5" required placeholder="Ví dụ: Nội dung bài viết không phù hợp với chủ đề phòng ban, vi phạm quy định nội dung..."
                              class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:border-red-400 focus:ring-2 focus:ring-red-100 outline-none text-sm text-gray-800 resize-none transition-all"></textarea>
                    <div class="flex justify-end gap-2">
                        <button type="button" onclick="document.getElementById('modalReject').classList.add('hidden')"
                                class="px-4 py-2 text-xs font-bold text-gray-700 hover:bg-gray-100 rounded-xl transition-all">Hủy</button>
                        <button type="submit"
                                class="px-5 py-2 text-xs font-bold text-white bg-red-600 hover:bg-red-700 rounded-xl shadow-sm shadow-red-200 transition-all active:scale-95">
                            Xác nhận từ chối
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
    @* ── PENDING NOTICE (non-reviewer view) ── *@
    @if (!Model.IsPublished && ViewBag.CanApprove != true)
    {
        <div class="p-4 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/80 flex items-center gap-3 shadow-sm">
            <div class="p-2 bg-amber-100 text-amber-700 rounded-xl flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
                <h4 class="font-bold text-amber-900 text-sm">Bài viết đang ở trạng thái CHỜ DUYỆT</h4>
                <p class="text-xs text-amber-700 mt-0.5">Nội dung này chưa được xuất bản công khai. Chỉ tác giả và ban kiểm duyệt mới có quyền xem trước.</p>
            </div>
        </div>
    }

    <!-- ============================================================== -->
    <!-- MAIN ARTICLE CARD (ELEVATED, CLEAN, PROFESSIONAL READING VIEW) -->
    <!-- ============================================================== -->
    <article class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-100/90 space-y-7">
        <!-- Article Header Badges -->
        <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-1 px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-xs font-bold uppercase tracking-wider border border-blue-100/80">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
                @(!string.IsNullOrEmpty(Model.CategoryName) ? Model.CategoryName : "Chuyên mục chung")
            </span>
            @if (!string.IsNullOrEmpty(Model.DepartmentName))
            {
                <span class="inline-flex items-center gap-1 px-3 py-1 bg-purple-50 text-purple-700 rounded-full text-xs font-bold uppercase tracking-wider border border-purple-100/80">
                    🏢 @Model.DepartmentName
                </span>
            }
            @if (!string.IsNullOrEmpty(Model.SubmissionWindowName))
            {
                <span class="inline-flex items-center gap-1 px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-xs font-bold border border-slate-200" title="Hạn chót tương tác: @(Model.SubmissionFinalClosureDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "")">
                    📅 @Model.SubmissionWindowName
                </span>
            }
            @if (Model.IsPublished)
            {
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-full text-xs font-bold border border-emerald-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Đã duyệt & Đăng
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-amber-50 text-amber-800 rounded-full text-xs font-bold border border-amber-200">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span> Chờ duyệt (Chưa đăng)
                </span>
            }
            <span class="text-gray-400 text-xs flex items-center gap-1 ml-auto">
                <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                3 phút đọc
            </span>
        </div>

        <!-- Article Title -->
        <h1 class="text-3xl sm:text-4xl font-black text-gray-900 tracking-tight leading-tight">
            @Model.Title
        </h1>

        <!-- YouTube Channel / Author & Reaction Pill Bar -->
        <div class="p-3.5 sm:p-4 rounded-2xl bg-gray-50/90 border border-gray-100 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <!-- Channel / Author Profile -->
            <div class="flex items-center gap-3">
                <div class="relative flex-shrink-0">
                    <div class="w-11 h-11 rounded-full @(isAnonymous ? "bg-purple-600 text-white" : "bg-gradient-to-tr from-purple-600 via-pink-500 to-rose-400 text-white") font-black flex items-center justify-center text-base shadow-sm ring-2 ring-white">
                        @authorInitial
                    </div>
                </div>
                <div>
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <h4 class="font-bold text-gray-900 text-sm sm:text-base hover:text-blue-600 transition-colors">
                            @displayAuthorName
                        </h4>
                        @if (!isAnonymous)
                        {
                            <!-- Verified Checkmark Badge -->
                            <span title="Đã xác minh" class="inline-flex text-gray-500">
                                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm-1.9 14.7l-4.2-4.2 1.4-1.4 2.8 2.8 6.8-6.8 1.4 1.4-8.2 8.2z"/></svg>
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-700 border border-purple-200">
                                🎭 Ẩn danh
                            </span>
                        }
                    </div>
                    @if (isAnonymous && (currentUser.IsAdmin || currentUser.IsQAManager || currentUser.IsQACoordinator))
                    {
                        <p class="text-[11px] text-purple-600 font-medium">🎭 Tác giả thật: @(!string.IsNullOrEmpty(Model.AuthorName) ? Model.AuthorName : Model.AuthorId) (Quản trị xem)</p>
                    }
                    else
                    {
                        <p class="text-xs text-gray-500">Thành viên cộng đồng</p>
                    }
                </div>
                @if (!isAnonymous)
                {
                    <!-- Subscribe Button -->
                    <button type="button" onclick="toggleSubscribe(this)" id="btnSubscribe" class="ml-2 px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white text-xs font-bold rounded-full transition-all flex items-center gap-1.5 active:scale-95 shadow-sm">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                        <span id="subscribeBtnText">Đăng ký</span>
                    </button>
                }
            </div>

            <!-- YouTube Action Buttons (Combined Like/Dislike Pill + Share + Save) -->
            <div class="flex items-center gap-2 flex-wrap">
                <!-- Combined Like / Dislike Pill -->
                <div class="inline-flex items-center bg-white border border-gray-200 hover:border-gray-300 rounded-full text-xs font-semibold text-gray-800 transition-all shadow-xs overflow-hidden">
                    <!-- Like Button -->
                    <button type="button" onclick="toggleLike()" id="btnLike" class="inline-flex items-center gap-2 px-4 py-2 hover:bg-gray-50 active:scale-95 transition-all text-gray-800">
                        <svg id="iconLike" class="w-4 h-4 text-gray-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
