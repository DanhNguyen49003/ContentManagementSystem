                                <div class="flex justify-end gap-2 pt-1">
                                    <button type="button" onclick="closeReplyBox('reply-box-2')" class="px-3 py-1 text-[11px] font-bold text-gray-600 hover:bg-gray-100 rounded-full">Hủy</button>
                                    <button type="button" onclick="submitReply('reply-box-2', 'reply-input-2', 'replies-thread-2')" class="px-3 py-1 text-[11px] font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full">Phản hồi</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        const POST_ID = '@Model.Id';
        const CURRENT_USER_NAME = '@currentUserName';
        const CURRENT_USER_INITIAL = '@userInitial';

        // Local Storage Keys
        const LIKE_KEY = 'yt_like_' + POST_ID;
        const DISLIKE_KEY = 'yt_dislike_' + POST_ID;
        const SUB_KEY = 'yt_sub_author';
        const SAVE_KEY = 'yt_save_' + POST_ID;
        const COMMENTS_KEY = 'yt_comments_' + POST_ID;

        document.addEventListener('DOMContentLoaded', function () {
            initReactions();
            initSubscribe();
            initSaveState();
            loadCustomComments();
        });

        // ==========================================
        // 1. LIKE & DISLIKE (YOUTUBE PILL)
        // ==========================================
        let isLiked = localStorage.getItem(LIKE_KEY) === 'true';
        let isDisliked = localStorage.getItem(DISLIKE_KEY) === 'true';
        let baseLikeCount = 150000;

        function initReactions() {
            updateReactionUI();
        }

        function toggleLike() {
            if (isLiked) {
                isLiked = false;
            } else {
                isLiked = true;
                if (isDisliked) isDisliked = false;
                showToast('Đã thích bài viết');
            }
            saveReactionState();
            updateReactionUI();
        }

        function toggleDislike() {
            if (isDisliked) {
                isDisliked = false;
            } else {
                isDisliked = true;
                if (isLiked) isLiked = false;
                showToast('Đã không thích bài viết');
            }
            saveReactionState();
            updateReactionUI();
        }

        function saveReactionState() {
            localStorage.setItem(LIKE_KEY, isLiked);
            localStorage.setItem(DISLIKE_KEY, isDisliked);
        }

        function updateReactionUI() {
            const btnLike = document.getElementById('btnLike');
            const btnDislike = document.getElementById('btnDislike');
            const iconLike = document.getElementById('iconLike');
            const iconDislike = document.getElementById('iconDislike');
            const likeText = document.getElementById('likeCountDisplay');

            let currentCount = baseLikeCount + (isLiked ? 1 : 0);
            if (likeText) {
                likeText.innerText = currentCount.toLocaleString();
            }

            let baseDislikeCount = 120;
            let currentDislike = baseDislikeCount + (isDisliked ? 1 : 0);
            const dislikeText = document.getElementById('dislikeCountDisplay');
            if (dislikeText) {
                dislikeText.innerText = currentDislike.toLocaleString();
            }

            if (isLiked) {
                btnLike?.classList.add('text-blue-600', 'font-bold');
                iconLike?.setAttribute('fill', 'currentColor');
            } else {
                btnLike?.classList.remove('text-blue-600', 'font-bold');
                iconLike?.setAttribute('fill', 'none');
            }

            if (isDisliked) {
                btnDislike?.classList.add('text-blue-600');
                iconDislike?.setAttribute('fill', 'currentColor');
            } else {
                btnDislike?.classList.remove('text-blue-600');
                iconDislike?.setAttribute('fill', 'none');
            }
        }

        // ==========================================
        // 2. SUBSCRIBE BUTTON
        // ==========================================
        function initSubscribe() {
            const isSubbed = localStorage.getItem(SUB_KEY) === 'true';
            const btn = document.getElementById('btnSubscribe');
            const text = document.getElementById('subscribeBtnText');
            if (isSubbed && btn && text) {
                btn.className = 'ml-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold rounded-full transition-all flex items-center gap-1.5';
                text.innerText = 'Đã đăng ký';
            }
        }

        function toggleSubscribe(btn) {
            const text = document.getElementById('subscribeBtnText');
            const isSubbed = localStorage.getItem(SUB_KEY) === 'true';
            if (isSubbed) {
                localStorage.setItem(SUB_KEY, 'false');
                btn.className = 'ml-2 px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white text-xs font-bold rounded-full transition-all flex items-center gap-1.5 shadow-sm';
                if (text) text.innerText = 'Đăng ký';
                showToast('Đã hủy đăng ký');
            } else {
                localStorage.setItem(SUB_KEY, 'true');
                btn.className = 'ml-2 px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-bold rounded-full transition-all flex items-center gap-1.5';
                if (text) text.innerText = 'Đã đăng ký';
                showToast('Đã đăng ký kênh tác giả');
            }
        }

        // ==========================================
        // 3. SHARE & SAVE (BOOKMARK)
        // ==========================================
        function shareArticle() {
            navigator.clipboard.writeText(window.location.href);
            showToast('Đã sao chép liên kết vào bộ nhớ tạm!');
        }

        function initSaveState() {
            const isSaved = localStorage.getItem(SAVE_KEY) === 'true';
            const iconSave = document.getElementById('iconSave');
            const saveText = document.getElementById('saveText');
            if (isSaved) {
                iconSave?.setAttribute('fill', 'currentColor');
                if (saveText) saveText.innerText = 'Đã lưu';
            }
        }

        function saveArticle() {
            const isSaved = localStorage.getItem(SAVE_KEY) === 'true';
            const iconSave = document.getElementById('iconSave');
            const saveText = document.getElementById('saveText');
            if (isSaved) {
                localStorage.setItem(SAVE_KEY, 'false');
                iconSave?.setAttribute('fill', 'none');
                if (saveText) saveText.innerText = 'Lưu';
                showToast('Đã bỏ lưu bài viết');
            } else {
                localStorage.setItem(SAVE_KEY, 'true');
                iconSave?.setAttribute('fill', 'currentColor');
                if (saveText) saveText.innerText = 'Đã lưu';
                showToast('Đã lưu bài viết vào thư viện!');
            }
        }

        // ==========================================
        // 4. YOUTUBE COMMENTS INTERACTION
        // ==========================================
        function onCommentFocus() {
            const actionRow = document.getElementById('commentActionRow');
            if (actionRow) actionRow.classList.remove('hidden');
        }

        function onCommentInput() {
            const input = document.getElementById('commentInput');
            const btn = document.getElementById('btnSubmitComment');
            if (!input || !btn) return;

            if (input.value.trim().length > 0) {
                btn.disabled = false;
                btn.className = 'px-4 py-1.5 text-xs font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full transition-all active:scale-95 shadow-sm';
            } else {
                btn.disabled = true;
                btn.className = 'px-4 py-1.5 text-xs font-bold text-gray-400 bg-gray-100 rounded-full transition-all cursor-not-allowed';
            }
        }

        function cancelComment() {
            const input = document.getElementById('commentInput');
            const actionRow = document.getElementById('commentActionRow');
            if (input) input.value = '';
            if (actionRow) actionRow.classList.add('hidden');
            onCommentInput();
        }

        function submitComment() {
            const input = document.getElementById('commentInput');
            const text = input ? input.value.trim() : '';
            if (!text) return;

            const newComment = {
                id: 'yt_' + Date.now(),
                author: CURRENT_USER_NAME || 'Bạn đọc',
                handle: '@@' + (CURRENT_USER_NAME.toLowerCase().replace(/\s+/g, '') || 'user'),
                initial: CURRENT_USER_INITIAL || 'U',
                content: text,
                time: 'Vừa xong',
                likes: 0,
                dislikes: 0,
                isLiked: false,
                isDisliked: false,
                replies: []
            };

            // Save to localStorage
            const saved = JSON.parse(localStorage.getItem(COMMENTS_KEY) || '[]');
            saved.unshift(newComment);
            localStorage.setItem(COMMENTS_KEY, JSON.stringify(saved));

            // Render immediately
            renderUserComment(newComment, true);

            // Update comment count
            updateCommentCount(1);

            // Sync with backend API
            fetch('/api/comments', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    postId: POST_ID,
                    content: text,
                    createdAt: new Date().toISOString(),
                    isApproved: true
                })
            }).catch(e => console.log('Comment sync info:', e));

            cancelComment();
            showToast('Đã đăng bình luận');
        }

        function renderUserComment(c, isNew = false) {
            const container = document.getElementById('userCommentsList');
            if (!container) return;

            const div = document.createElement('div');
            div.className = `flex items-start gap-4 group transition-all ${isNew ? 'bg-blue-50/40 p-3 rounded-2xl ring-1 ring-blue-100' : ''}`;
            div.id = 'comment_' + c.id;
            div.innerHTML = `
                <div class="w-10 h-10 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-sm flex-shrink-0 shadow-sm">
                    ${c.initial || 'U'}
                </div>
                <div class="flex-1 space-y-1">
                    <div class="flex items-center gap-2 text-xs">
                        <span class="font-bold text-gray-900">${c.handle || '&#64;user'}</span>
                        <span class="text-gray-500">${c.time || 'Vừa xong'}</span>
                        ${isNew ? '<span class="text-[10px] bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded font-bold">Mới</span>' : ''}
                    </div>
                    <p class="text-sm text-gray-800 leading-relaxed">${escapeHtml(c.content)}</p>
                    <div class="flex items-center gap-3 pt-1 text-xs text-gray-600">
                        <button type="button" onclick="toggleCommentLike(this, '${c.id}')" data-count="${c.likes || 0}" ${c.isLiked ? 'data-liked="true"' : ''} class="inline-flex items-center gap-1.5 p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all ${c.isLiked ? 'text-blue-600' : 'text-gray-700'}">
                            <svg class="w-4 h-4" fill="${c.isLiked ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg>
                            <span class="font-bold text-xs ${c.isLiked ? 'text-blue-600' : 'text-gray-700'}">${c.likes || 0}</span>
                        </button>
                        <button type="button" onclick="toggleCommentDislike(this, '${c.id}')" data-count="${c.dislikes || 0}" ${c.isDisliked ? 'data-disliked="true"' : ''} class="inline-flex items-center gap-1.5 p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all ${c.isDisliked ? 'text-blue-600' : 'text-gray-700'}">
                            <svg class="w-4 h-4" fill="${c.isDisliked ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018c.163 0 .326.02.485.06L17 4m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412-.608 2.006L17 13V4m-7 10h2m7-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/></svg>
                            <span class="font-bold text-xs ${c.isDisliked ? 'text-blue-600' : 'text-gray-700'}">${c.dislikes || 0}</span>
                        </button>
                        <button type="button" onclick="openReplyBox('reply_${c.id}')" class="px-2.5 py-1 text-xs font-bold text-gray-700 hover:bg-gray-100 rounded-full transition-all">
                            Phản hồi
                        </button>
                    </div>

                    <!-- Dynamic Reply Box -->
                    <div id="reply_${c.id}" class="hidden pt-3 pl-2">
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                                ${CURRENT_USER_INITIAL || 'U'}
                            </div>
                            <div class="flex-1 space-y-1.5">
                                <input type="text" id="reply_input_${c.id}" placeholder="Phản hồi ${c.handle}..." class="w-full pb-1 text-xs bg-transparent border-b border-gray-200 focus:border-gray-900 outline-none transition-colors" />
                                <div class="flex justify-end gap-2 pt-1">
                                    <button type="button" onclick="closeReplyBox('reply_${c.id}')" class="px-3 py-1 text-[11px] font-bold text-gray-600 hover:bg-gray-100 rounded-full">Hủy</button>
                                    <button type="button" onclick="submitReply('reply_${c.id}', 'reply_input_${c.id}', 'thread_${c.id}')" class="px-3 py-1 text-[11px] font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-full">Phản hồi</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="thread_${c.id}" class="hidden pl-6 mt-3 space-y-3 border-l-2 border-gray-100"></div>
                </div>
            `;
            container.prepend(div);
        }

        function loadCustomComments() {
            const saved = JSON.parse(localStorage.getItem(COMMENTS_KEY) || '[]');
            if (saved.length > 0) {
                updateCommentCount(saved.length);
                saved.reverse().forEach(c => renderUserComment(c, false));
            }
        }

        function updateCommentCount(delta) {
            const el = document.getElementById('commentTotalCount');
            if (!el) return;
            let current = parseInt(el.innerText.replace(/,/g, '')) || 2698;
            current += delta;
            el.innerText = current.toLocaleString();
        }

        // ==========================================
        // 5. INLINE REPLIES TOGGLES
        // ==========================================
        function parseLikeCount(text) {
            if (!text) return 0;
            text = text.trim().toLowerCase();
            if (text.endsWith('k')) {
                let num = parseFloat(text.replace('k', '')) || 0;
                return Math.round(num * 1000);
            }
            return parseInt(text.replace(/,/g, ''), 10) || 0;
        }

        function formatLikeCount(num, hadK = false) {
            if (num < 0) num = 0;
            if (hadK || num >= 1000) {
                return (num / 1000).toFixed(1).replace('.0', '') + 'k';
            }
            return num.toString();
        }

        function toggleCommentLike(btn, key) {
            let commentId = key;
            if (!commentId && btn.closest('[id^="comment_yt_"]')) {
                commentId = btn.closest('[id^="comment_yt_"]').id.replace('comment_', '');
            }

            const span = btn.querySelector('span');
            const svg = btn.querySelector('svg');
            const isLiked = btn.getAttribute('data-liked') === 'true';
            const dislikeBtn = btn.nextElementSibling;

            // Đọc và phân tích số lượng like hiện tại
            let currentCount = 0;
            let hadK = false;
            if (btn.hasAttribute('data-count')) {
                currentCount = parseInt(btn.getAttribute('data-count'), 10) || 0;
                if (btn.getAttribute('data-had-k') === 'true') hadK = true;
            } else if (span) {
                const txt = span.innerText.trim();
                hadK = txt.toLowerCase().includes('k');
                currentCount = parseLikeCount(txt);
                if (hadK) btn.setAttribute('data-had-k', 'true');
            }

            if (isLiked) {
                // Hủy thích (Giảm số đếm)
                btn.removeAttribute('data-liked');
                btn.classList.remove('text-blue-600');
                if (svg) svg.setAttribute('fill', 'none');
                currentCount = Math.max(0, currentCount - 1);
                btn.setAttribute('data-count', currentCount);
                if (span) {
                    span.innerText = formatLikeCount(currentCount, hadK && currentCount >= 1000);
                    span.classList.remove('text-blue-600');
                }
                showToast('Đã bỏ thích');
            } else {
                // Thích (Tăng số đếm)
                btn.setAttribute('data-liked', 'true');
                btn.classList.add('text-blue-600');
                if (svg) svg.setAttribute('fill', 'currentColor');
                currentCount = currentCount + 1;
                btn.setAttribute('data-count', currentCount);
                if (span) {
                    span.innerText = formatLikeCount(currentCount, hadK && currentCount >= 1000);
                    span.classList.add('text-blue-600');
                }

                // Nếu Dislike đang bật thì gỡ Dislike (và trừ 1 số lượt không thích)
                if (dislikeBtn && dislikeBtn.getAttribute('data-disliked') === 'true') {
                    toggleCommentDislike(dislikeBtn, commentId);
                }

                showToast('Đã thích bình luận');
            }

            // Đồng bộ trạng thái vào localStorage nếu là bình luận của người dùng
            if (commentId) {
                try {
                    const saved = JSON.parse(localStorage.getItem(COMMENTS_KEY) || '[]');
                    const comment = saved.find(item => item.id === commentId);
                    if (comment) {
                        comment.likes = currentCount;
                        comment.isLiked = !isLiked;
                        localStorage.setItem(COMMENTS_KEY, JSON.stringify(saved));
                    }
                } catch (e) {
                    console.log('Lỗi lưu like vào localStorage:', e);
                }
            }
        }

        function toggleCommentDislike(btn, key) {
            let commentId = key;
            if (!commentId && btn.closest('[id^="comment_yt_"]')) {
                commentId = btn.closest('[id^="comment_yt_"]').id.replace('comment_', '');
            }

            let span = btn.querySelector('span');
            if (!span) {
                span = document.createElement('span');
                span.className = 'font-bold text-xs';
                span.innerText = '0';
                btn.appendChild(span);
            }
            const svg = btn.querySelector('svg');
            const isDisliked = btn.getAttribute('data-disliked') === 'true';
            const likeBtn = btn.previousElementSibling;

            // Đọc số lượng dislike hiện tại
            let currentDislikeCount = 0;
            if (btn.hasAttribute('data-count')) {
                currentDislikeCount = parseInt(btn.getAttribute('data-count'), 10) || 0;
            } else {
                currentDislikeCount = parseInt(span.innerText.trim(), 10) || 0;
            }

            if (isDisliked) {
                // Bỏ không thích (Giảm số lượt không thích)
                btn.removeAttribute('data-disliked');
                btn.classList.remove('text-blue-600');
                if (svg) svg.setAttribute('fill', 'none');
                currentDislikeCount = Math.max(0, currentDislikeCount - 1);
                btn.setAttribute('data-count', currentDislikeCount);
                span.innerText = currentDislikeCount.toString();
                span.classList.remove('text-blue-600');
                showToast('Đã bỏ không thích');
            } else {
                // Bấm không thích (Tăng số lượt không thích)
                btn.setAttribute('data-disliked', 'true');
                btn.classList.add('text-blue-600');
                if (svg) svg.setAttribute('fill', 'currentColor');
                currentDislikeCount = currentDislikeCount + 1;
                btn.setAttribute('data-count', currentDislikeCount);
                span.innerText = currentDislikeCount.toString();
                span.classList.add('text-blue-600');

                // Nếu Like đang bật thì tắt Like (và giảm số lượt thích)
                if (likeBtn && likeBtn.getAttribute('data-liked') === 'true') {
                    toggleCommentLike(likeBtn, commentId);
                }
                showToast('Đã không thích bình luận');
            }

            // Đồng bộ trạng thái vào localStorage nếu là bình luận của người dùng
            if (commentId) {
                try {
                    const saved = JSON.parse(localStorage.getItem(COMMENTS_KEY) || '[]');
                    const comment = saved.find(item => item.id === commentId);
                    if (comment) {
                        comment.dislikes = currentDislikeCount;
                        comment.isDisliked = !isDisliked;
                        localStorage.setItem(COMMENTS_KEY, JSON.stringify(saved));
                    }
                } catch (e) {
                    console.log('Lỗi lưu dislike vào localStorage:', e);
                }
            }
        }

        function openReplyBox(boxId) {
            const box = document.getElementById(boxId);
            if (box) {
                box.classList.remove('hidden');
                const input = box.querySelector('input');
                if (input) input.focus();
            }
        }

        function closeReplyBox(boxId) {
            const box = document.getElementById(boxId);
            if (box) box.classList.add('hidden');
        }

        function submitReply(boxId, inputId, threadId) {
            const input = document.getElementById(inputId);
            const text = input ? input.value.trim() : '';
            if (!text) return;

            const thread = document.getElementById(threadId);
            if (thread) {
                thread.classList.remove('hidden');
                const replyDiv = document.createElement('div');
                const replyId = 'reply_' + Date.now();
                replyDiv.className = 'flex items-start gap-3 pt-2';
                replyDiv.innerHTML = `
                    <div class="w-8 h-8 rounded-full bg-indigo-600 text-white font-bold flex items-center justify-center text-xs flex-shrink-0">
                        ${CURRENT_USER_INITIAL || 'U'}
                    </div>
                    <div class="flex-1 space-y-0.5">
                        <div class="flex items-center gap-2 text-xs">
                            <span class="font-bold text-gray-900">&#64;${CURRENT_USER_NAME.toLowerCase().replace(/\s+/g, '')}</span>
                            <span class="text-gray-500">Vừa xong</span>
                        </div>
                        <p class="text-xs text-gray-800 leading-relaxed">${escapeHtml(text)}</p>
                        <div class="flex items-center gap-2 pt-0.5 text-xs text-gray-600">
                            <button type="button" onclick="toggleCommentLike(this, '${replyId}')" data-count="0" class="inline-flex items-center gap-1.5 p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all text-gray-700">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/></svg>
                                <span class="font-bold text-[11px]">0</span>
                            </button>
                            <button type="button" onclick="toggleCommentDislike(this, '${replyId}')" data-count="0" class="inline-flex items-center gap-1.5 p-1 hover:bg-gray-100 rounded-full active:scale-95 transition-all text-gray-700">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018c.163 0 .326.02.485.06L17 4m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m7-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5"/></svg>
                                <span class="font-bold text-[11px]">0</span>
                            </button>
                        </div>
                    </div>
                `;
                thread.appendChild(replyDiv);
            }

            input.value = '';
            closeReplyBox(boxId);
            showToast('Đã đăng câu trả lời');
        }

        function toggleReplies(threadId, iconId) {
            const thread = document.getElementById(threadId);
            const icon = document.getElementById(iconId);
            if (!thread) return;

            const isHidden = thread.classList.contains('hidden');
            if (isHidden) {
                thread.classList.remove('hidden');
                if (icon) icon.style.transform = 'rotate(180deg)';
            } else {
                thread.classList.add('hidden');
                if (icon) icon.style.transform = 'rotate(0deg)';
            }
        }

        // ==========================================
        // 6. SORT DROPDOWN
        // ==========================================
        function toggleSortDropdown() {
            const dd = document.getElementById('sortDropdown');
            if (dd) dd.classList.toggle('hidden');
        }

        function setSortOrder(type) {
            const label = document.getElementById('currentSortText');
            if (label) {
                label.innerText = type === 'top' ? 'Bình luận hàng đầu' : 'Mới nhất trước';
            }
            toggleSortDropdown();
            showToast('Đã sắp xếp lại bình luận');
        }

        // ==========================================
        // 7. TOAST NOTIFICATION HELPER
        // ==========================================
        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('ytToast');
            const text = document.getElementById('ytToastText');
            if (!toast || !text) return;

            text.innerText = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        }

        function escapeHtml(str) {
            return str
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
}

