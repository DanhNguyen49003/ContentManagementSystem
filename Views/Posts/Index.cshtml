@model IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.PostDto>

@{
    ViewData["Title"] = "Quản lý bài viết";
    Layout = "_Layout";
}

<div class="space-y-6">
    <!-- Header & Action -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Quản lý bài viết</h2>
            <p class="text-sm text-gray-500 mt-1">Danh sách bài viết, duyệt xuất bản và kiểm soát nội dung hệ thống.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Thêm bài viết mới
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3">
            <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3">
            <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Data Table Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <!-- Action Bar -->
        <div class="p-5 border-b border-gray-100 flex flex-col sm:flex-row justify-between gap-4">
            <div class="relative w-full sm:w-80">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                </div>
                <input type="text" id="postSearch" class="block w-full pl-9 pr-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" placeholder="Tìm kiếm bài viết...">
            </div>
            <div class="flex items-center gap-4 text-xs">
                <span class="px-2.5 py-1 bg-green-50 text-green-700 rounded-lg font-medium">
                    Đã xuất bản: @(Model?.Count(p => p.IsPublished) ?? 0)
                </span>
                <span class="px-2.5 py-1 bg-amber-50 text-amber-700 rounded-lg font-medium">
                    Bản nháp: @(Model?.Count(p => !p.IsPublished) ?? 0)
                </span>
                <span class="text-gray-500">Tổng cộng: <strong class="text-gray-800 font-semibold">@(Model?.Count() ?? 0)</strong></span>
            </div>
        </div>

        <!-- Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="postsTable">
                <thead>
                    <tr class="bg-gray-50/75 text-gray-500 text-xs uppercase tracking-wider">
                        <th class="px-6 py-3.5 font-semibold">Tiêu đề bài viết</th>
                        <th class="px-6 py-3.5 font-semibold">Chuyên mục</th>
                        <th class="px-6 py-3.5 font-semibold">Phòng ban</th>
                        <th class="px-6 py-3.5 font-semibold">Trạng thái</th>
                        <th class="px-6 py-3.5 font-semibold">Duyệt bài</th>
                        <th class="px-6 py-3.5 font-semibold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var post in Model)
                        {
                            bool isAdmin = User.IsInRole("Admin");
                            bool isCoordinator = User.IsInRole("QA Coordinator");
                            Guid? userDeptId = ViewBag.UserDepartmentId as Guid?;
                            bool canApprove = isAdmin || (isCoordinator && userDeptId.HasValue && post.DepartmentId.HasValue && post.DepartmentId.Value == userDeptId.Value);
                            bool isOtherDept = isCoordinator && (!userDeptId.HasValue || !post.DepartmentId.HasValue || post.DepartmentId.Value != userDeptId.Value);

                            <tr class="hover:bg-gray-50/75 transition-colors post-row">
                                <td class="px-6 py-4">
                                    <div class="font-semibold text-gray-800 post-title">@post.Title</div>
                                    <div class="text-xs text-gray-400 mt-0.5 flex items-center gap-3">
                                        <span>Tác giả: <strong class="text-gray-600">@(!string.IsNullOrEmpty(post.AuthorName) ? post.AuthorName : post.AuthorId)</strong></span>
                                        <span>•</span>
                                        <span>@post.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    @if (post.TagNames != null && post.TagNames.Any())
                                    {
                                        <div class="flex items-center gap-1.5 mt-1.5 flex-wrap">
                                            @foreach (var tag in post.TagNames.Take(4))
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                                                    #@tag
                                                </span>
                                            }
                                            @if (post.TagNames.Count > 4)
                                            {
                                                <span class="text-[11px] text-slate-400 font-medium">+@(post.TagNames.Count - 4)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium bg-blue-50 text-blue-700">
                                        @(!string.IsNullOrEmpty(post.CategoryName) ? post.CategoryName : "Chưa phân loại")
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-100">
                                        @(!string.IsNullOrEmpty(post.DepartmentName) ? post.DepartmentName : "Chung")
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    @if (post.IsPublished)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-50 text-green-700 rounded-full text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                                            Đã xuất bản
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-50 text-amber-700 rounded-full text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                            Bản nháp
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (canApprove)
                                    {
                                        if (!post.IsPublished)
                                        {
                                            <form asp-action="TogglePublish" asp-route-id="@post.Id" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-all" title="Duyệt và xuất bản ngay">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                                    Duyệt & Đăng
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="TogglePublish" asp-route-id="@post.Id" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl text-xs font-semibold bg-gray-100 hover:bg-gray-200 text-gray-600 transition-all" title="Gỡ xuất bản / Chuyển về bản nháp">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                    Gỡ bài
                                                </button>
                                            </form>
                                        }
                                    }
                                    else if (isOtherDept)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-gray-100 text-gray-400" title="Bài viết thuộc phòng ban khác, bạn không phụ trách">
                                            <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                            Khác phòng ban
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-gray-400 italic">Chờ QA duyệt</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@post.Id" class="p-1.5 text-gray-400 hover:text-blue-600 rounded-lg hover:bg-blue-50 transition-all" title="Chi tiết">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@post.Id" class="p-1.5 text-gray-400 hover:text-indigo-600 rounded-lg hover:bg-indigo-50 transition-all" title="Chỉnh sửa">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@post.Id" class="p-1.5 text-gray-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-all" title="Xóa">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-12 text-gray-400">
                                <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                <p class="text-base font-medium text-gray-500">Chưa có bài viết nào</p>
                                <a asp-action="Create" class="inline-block mt-3 text-sm text-blue-600 hover:underline">Tạo bài viết đầu tiên &rarr;</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.getElementById('postSearch')?.addEventListener('input', function (e) {
        const term = e.target.value.toLowerCase();
        document.querySelectorAll('.post-row').forEach(row => {
            const title = row.querySelector('.post-title')?.textContent.toLowerCase() || '';
            row.style.display = title.includes(term) ? '' : 'none';
        });
    });
</script>