@model IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.PostDto>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CMS - Quản lý nội dung</title>
    <!-- Tích hợp Tailwind CSS qua CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 p-8 font-sans">

    <div class="max-w-7xl mx-auto">
        <!-- Header & Thêm mới -->
        <div class="flex justify-between items-center mb-6">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Quản lý nội dung</h2>
                <p class="text-sm text-gray-500 mt-1">Quản lý tất cả bài viết, danh mục và trạng thái hệ thống.</p>
            </div>
            <a href="/Posts/Create" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors shadow-sm flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Thêm nội dung mới
            </a>
        </div>

        <!-- Bảng Dữ liệu -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
            
            <!-- Action Bar -->
            <div class="p-5 border-b border-gray-100 flex flex-col sm:flex-row justify-between gap-4">
                <div class="relative w-full sm:w-96">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input type="text" class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 text-sm" placeholder="Tìm kiếm theo tiêu đề...">
                </div>
                <div class="flex gap-2">
                    <select class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-blue-500 focus:border-blue-500">
                        <option value="">Tất cả trạng thái</option>
                        <option value="published">Đã xuất bản</option>
                        <option value="pending">Chờ duyệt</option>
                        <option value="draft">Bản nháp</option>
                    </select>
                </div>
            </div>

            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                            <th class="px-6 py-4 font-medium">Tiêu đề</th>
                            <th class="px-6 py-4 font-medium">Chuyên mục</th>
                            <th class="px-6 py-4 font-medium">Trạng thái</th>
                            <th class="px-6 py-4 font-medium">Ngày tạo</th>
                            <th class="px-6 py-4 font-medium text-right">Hành động</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var post in Model)
                        {
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="font-medium text-gray-800">@post.Title</div>
                                    <div class="text-xs text-gray-500 mt-1">ID: @post.Id.ToString().Substring(0,8)</div>
                                </td>
                                <td class="px-6 py-4 text-gray-600">
                                    @(!string.IsNullOrEmpty(post.CategoryName) ? post.CategoryName : "Chưa phân loại")
                                </td>
                                <td class="px-6 py-4">
                                    @if (post.IsPublished)
                                    {
                                        <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">Đã xuất bản</span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-medium">Bản nháp</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-gray-500">@post.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="px-6 py-4 text-right">
                                    <a href="/Posts/Edit/@post.Id" class="text-gray-400 hover:text-blue-600 transition-colors mx-1" title="Chỉnh sửa">
                                        <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                                    </a>
                                    <a href="/Posts/Delete/@post.Id" class="text-gray-400 hover:text-red-600 transition-colors mx-1" title="Xóa">
                                        <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang (Pagination) -->
            <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between">
                <span class="text-sm text-gray-500">Hiển thị @Model.Count() kết quả</span>
                <div class="flex gap-1">
                    <button class="px-3 py-1 border border-gray-300 rounded text-sm text-gray-600 hover:bg-gray-50 disabled:opacity-50">Trước</button>
                    <button class="px-3 py-1 border border-blue-600 bg-blue-50 rounded text-sm text-blue-600 font-medium">1</button>
                    <button class="px-3 py-1 border border-gray-300 rounded text-sm text-gray-600 hover:bg-gray-50">Tiếp</button>
                </div>
            </div>

        </div>
    </div>

</body>
</html>

