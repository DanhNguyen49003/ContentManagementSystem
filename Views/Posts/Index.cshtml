@model IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.PostDto>
@using ContentManagementSystem.Services
@inject ICurrentUserService CurrentUserService

@{
    ViewData["Title"] = "Quản lý bài viết";
    Layout = "_Layout";

    var currentUser = await CurrentUserService.GetCurrentUserAsync();
    bool isAdmin     = currentUser.IsAdmin;
    bool isManager   = currentUser.IsQAManager;
    bool isCoord     = currentUser.IsQACoordinator;
    bool isCustomer  = currentUser.IsCustomer;
    Guid? userDeptId = ViewBag.UserDepartmentId as Guid?;

    // Tab filter
    var statusFilter = Context.Request.Query["status"].ToString();
    var deptFilter   = Context.Request.Query["departmentId"].ToString();

    var allPosts = Model?.ToList() ?? new List<ContentManagementSystem.ApplicationCore.DTOs.PostDto>();

    // Count per status
    int cntAll       = allPosts.Count;
    int cntPending   = allPosts.Count(p => (p.Status ?? "Pending") == "Pending"   && !p.IsPublished);
    int cntApproved  = allPosts.Count(p => p.IsPublished);
    int cntRejected  = allPosts.Count(p => (p.Status ?? "") == "Rejected");
    int cntChanges   = allPosts.Count(p => (p.Status ?? "") == "ChangesRequested");

    // Apply tab filter
    IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.PostDto> filtered = allPosts;
    if (statusFilter == "Pending")          filtered = allPosts.Where(p => (p.Status ?? "Pending") == "Pending" && !p.IsPublished);
    else if (statusFilter == "Approved")    filtered = allPosts.Where(p => p.IsPublished);
    else if (statusFilter == "Rejected")    filtered = allPosts.Where(p => (p.Status ?? "") == "Rejected");
    else if (statusFilter == "Changes")     filtered = allPosts.Where(p => (p.Status ?? "") == "ChangesRequested");

    var depts = ViewBag.Departments as IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.DepartmentDto>
                ?? Enumerable.Empty<ContentManagementSystem.ApplicationCore.DTOs.DepartmentDto>();
    var selDept = ViewBag.SelectedDepartmentId as Guid?;

    // Helper: build tab URL
    string TabUrl(string tab) {
        var qs = new System.Text.StringBuilder("/Posts?");
        if (!string.IsNullOrEmpty(tab))          qs.Append($"status={tab}&");
        if (!string.IsNullOrEmpty(deptFilter))   qs.Append($"departmentId={deptFilter}&");
        return qs.ToString().TrimEnd('&', '?');
    }
}

<div class="space-y-5">
    @* ── PAGE HEADER ── *@
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-black text-gray-900 tracking-tight">📝 Quản lý bài viết</h2>
            <p class="text-sm text-gray-500 mt-0.5">Luồng duyệt bài: Author nộp → QA Coordinator duyệt → Cộng đồng xem → QA Manager thống kê.</p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            @if (isAdmin || isManager)
            {
                <a href="/Posts/ExportCsv@(!string.IsNullOrEmpty(deptFilter) ? $"?departmentId={deptFilter}" : "")"
                   class="inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-xl shadow-sm transition-all active:scale-95">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Xuất CSV
                </a>
            }
            <a asp-action="Create" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl text-sm font-bold shadow-sm transition-all active:scale-95">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Thêm bài viết mới
            </a>
        </div>
    </div>

    @* ── TOAST MESSAGES ── *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3">
            <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3">
            <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @* ── STATUS FILTER TABS ── *@
    @if (isAdmin || isManager || isCoord)
    {
        <div class="flex items-center gap-1.5 flex-wrap">
            @{
                var tabs = new[]
                {
                    ("", "Tất cả", cntAll, "text-gray-700 bg-white border-gray-200"),
                    ("Pending", "⏳ Chờ duyệt", cntPending, "text-amber-700 bg-amber-50 border-amber-200"),
                    ("Approved", "✅ Đã duyệt", cntApproved, "text-emerald-700 bg-emerald-50 border-emerald-200"),
                    ("Changes", "🔄 Cần sửa", cntChanges, "text-orange-700 bg-orange-50 border-orange-200"),
                    ("Rejected", "❌ Từ chối", cntRejected, "text-red-700 bg-red-50 border-red-200"),
                };
                foreach (var (key, label, count, cls) in tabs)
                {
                    bool isActive = statusFilter == key;
                    string activeCls = isActive ? "ring-2 ring-offset-1 ring-blue-400 font-black shadow-sm" : "hover:bg-gray-50";
                    <a href="@TabUrl(key)"
                       class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border text-xs font-bold transition-all @cls @activeCls">
                        @label
                        <span class="inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full bg-white/70 border text-[10px] font-black @cls">
                            @count
                        </span>
                    </a>
                }
            }
        </div>
    }

    @* ── MAIN TABLE CARD ── *@
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">

        @* ── FILTERS BAR ── *@
        <div class="p-4 border-b border-gray-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-3">
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto flex-1">
                <div class="relative w-full sm:w-72">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                    <input type="text" id="postSearch" class="block w-full pl-9 pr-3 py-2 border border-gray-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" placeholder="Tìm kiếm bài viết...">
                </div>
                <div class="w-full sm:w-56">
                    <select id="deptFilterSelect" onchange="filterByDept(this.value)"
                            class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs font-semibold focus:bg-white focus:ring-2 focus:ring-blue-600 transition-all">
                        <option value="">🏢 -- Tất cả phòng ban --</option>
                        @foreach (var d in depts)
                        {
                            if (selDept == d.Id)
                            {
                                <option value="@d.Id" selected>🏢 @d.Name</option>
                            }
                            else
                            {
                                <option value="@d.Id">🏢 @d.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="flex items-center gap-2 text-xs flex-wrap">
                <span class="px-2.5 py-1 bg-slate-50 text-slate-600 rounded-lg font-medium border border-slate-100">
                    Hiển thị: <strong>@filtered.Count()</strong> / @cntAll bài
                </span>
            </div>
        </div>

        @* ── TABLE ── *@
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse" id="postsTable">
                <thead>
                    <tr class="bg-gray-50/75 text-gray-500 text-xs uppercase tracking-wider">
                        <th class="px-5 py-3.5 font-bold">Tiêu đề bài viết</th>
                        <th class="px-5 py-3.5 font-bold">Chuyên mục / Phòng ban</th>
                        <th class="px-5 py-3.5 font-bold">Trạng thái</th>
                        @if (isAdmin || isCoord)
                        {
                            <th class="px-5 py-3.5 font-bold">Kiểm duyệt nhanh</th>
                        }
                        <th class="px-5 py-3.5 font-bold text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50 text-sm">
                    @if (filtered.Any())
                    {
                        foreach (var post in filtered)
                        {
                            var postStatus = post.Status ?? (post.IsPublished ? "Approved" : "Pending");
                            bool canApprove = isAdmin || (isCoord && userDeptId.HasValue && post.DepartmentId.HasValue && post.DepartmentId.Value == userDeptId.Value);
                            bool isOtherDept = !isAdmin && isCoord && (!userDeptId.HasValue || !post.DepartmentId.HasValue || post.DepartmentId.Value != userDeptId.Value);

                            var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                            bool isAuthor = !string.IsNullOrEmpty(currentUserId) && string.Equals(post.AuthorId, currentUserId, StringComparison.OrdinalIgnoreCase);
                            bool canEdit   = isAdmin || isManager || isCoord || isAuthor;
                            bool canDelete = isAdmin || isManager;

                            // Status badge
                            string statusIcon, statusLabel, statusBg;
                            if (post.IsPublished)                         { statusIcon = "✅"; statusLabel = "Đã duyệt & Đăng";   statusBg = "bg-emerald-50 text-emerald-700 border-emerald-200"; }
                            else if (postStatus == "Rejected")            { statusIcon = "❌"; statusLabel = "Bị từ chối";          statusBg = "bg-red-50 text-red-700 border-red-200"; }
                            else if (postStatus == "ChangesRequested")    { statusIcon = "🔄"; statusLabel = "Cần sửa đổi";         statusBg = "bg-orange-50 text-orange-700 border-orange-200"; }
                            else                                          { statusIcon = "⏳"; statusLabel = "Chờ duyệt";           statusBg = "bg-amber-50 text-amber-700 border-amber-200"; }

                            <tr class="hover:bg-gray-50/60 transition-colors post-row">
                                @* Title + Author + Tags *@
                                <td class="px-5 py-4 max-w-xs">
                                    <a asp-action="Details" asp-route-id="@post.Id" class="font-bold text-gray-900 hover:text-blue-600 transition-colors line-clamp-1 post-title">
                                        @post.Title
                                    </a>
                                    <div class="text-xs text-gray-400 mt-0.5 flex items-center gap-2 flex-wrap">
                                        @if (post.IsAnonymous)
                                        {
                                            <span class="inline-flex items-center gap-1 font-semibold text-purple-700 bg-purple-50 px-1.5 py-0.5 rounded border border-purple-100">🎭 Ẩn danh</span>
                                            @if (isAdmin || isManager || isCoord || isAuthor)
                                            {
                                                <span class="text-gray-400 text-[10px]">(@post.AuthorName)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>@(!string.IsNullOrEmpty(post.AuthorName) ? post.AuthorName : post.AuthorId)</span>
                                        }
                                        <span class="text-gray-300">•</span>
                                        <span>@post.CreatedAt.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    @if (post.TagNames != null && post.TagNames.Any())
                                    {
                                        <div class="flex items-center gap-1 mt-1.5 flex-wrap">
                                            @foreach (var tag in post.TagNames.Take(3))
                                            {
                                                <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600 border border-slate-200">#@tag</span>
                                            }
                                            @if (post.TagNames.Count > 3)
                                            {
                                                <span class="text-[10px] text-slate-400">+@(post.TagNames.Count - 3)</span>
                                            }
                                        </div>
                                    }
                                </td>

                                @* Category + Department *@
                                <td class="px-5 py-4">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                                        @(!string.IsNullOrEmpty(post.CategoryName) ? post.CategoryName : "Chưa phân loại")
                                    </span>
                                    @if (!string.IsNullOrEmpty(post.DepartmentName))
                                    {
                                        <div class="mt-1">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-medium bg-purple-50 text-purple-700 border border-purple-100">
                                                🏢 @post.DepartmentName
                                            </span>
                                        </div>
                                    }
                                </td>

                                @* Status Badge *@
                                <td class="px-5 py-4 whitespace-nowrap">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold border @statusBg">
                                        @statusIcon @statusLabel
                                    </span>
                                    @if (!string.IsNullOrEmpty(post.ReviewedByName) && (post.IsPublished || postStatus == "Rejected" || postStatus == "ChangesRequested"))
                                    {
                                        <div class="text-[10px] text-gray-400 mt-0.5">
                                            bởi @post.ReviewedByName
                                        </div>
                                    }
                                </td>

                                @* Quick-Approve column *@
                                @if (isAdmin || isCoord)
                                {
                                    <td class="px-5 py-4 whitespace-nowrap">
                                        @if (canApprove && !post.IsPublished && postStatus != "Approved")
                                        {
                                            <div class="flex items-center gap-1.5">
                                                <form asp-action="Approve" asp-route-id="@post.Id" method="post" class="inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white transition-all active:scale-95"
                                                            title="Duyệt & xuất bản ngay">
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                        Duyệt
                                                    </button>
                                                </form>
                                                <a asp-action="Details" asp-route-id="@post.Id"
                                                   class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-bold bg-gray-100 hover:bg-gray-200 text-gray-700 transition-all"
                                                   title="Xem chi tiết để duyệt đầy đủ (3 lựa chọn)">
                                                    Chi tiết
                                                </a>
                                            </div>
                                        }
                                        else if (isOtherDept)
                                        {
                                            <span class="text-xs text-gray-400 flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                                Khác phòng ban
                                            </span>
                                        }
                                        else if (post.IsPublished)
                                        {
                                            <form asp-action="TogglePublish" asp-route-id="@post.Id" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 hover:bg-gray-200 text-gray-600 transition-all active:scale-95"
                                                        title="Thu hồi bài viết">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                    Thu hồi
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-gray-400">—</span>
                                        }
                                    </td>
                                }

                                @* Actions *@
                                <td class="px-5 py-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-action="Details" asp-route-id="@post.Id" class="p-1.5 text-gray-400 hover:text-blue-600 rounded-lg hover:bg-blue-50 transition-all" title="Chi tiết">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                        </a>
                                        @if (canEdit)
                                        {
                                            <a asp-action="Edit" asp-route-id="@post.Id" class="p-1.5 text-gray-400 hover:text-indigo-600 rounded-lg hover:bg-indigo-50 transition-all" title="Chỉnh sửa">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            </a>
                                        }
                                        @if (canDelete)
                                        {
                                            <a asp-action="Delete" asp-route-id="@post.Id" class="p-1.5 text-gray-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-all" title="Xóa">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@((isAdmin || isCoord) ? 5 : 4)" class="text-center py-16 text-gray-400">
                                <div class="text-4xl mb-3">📭</div>
                                <p class="text-base font-medium text-gray-500">Không có bài viết nào trong trạng thái này</p>
                                @if (string.IsNullOrEmpty(statusFilter))
                                {
                                    <a asp-action="Create" class="inline-block mt-3 text-sm text-blue-600 hover:underline">Tạo bài viết đầu tiên →</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // Client-side search filter
    document.getElementById('postSearch')?.addEventListener('input', function (e) {
        const term = e.target.value.toLowerCase();
        document.querySelectorAll('.post-row').forEach(row => {
            const title = row.querySelector('.post-title')?.textContent.toLowerCase() || '';
            row.style.display = title.includes(term) ? '' : 'none';
        });
    });

    // Department dropdown with status preservation
    function filterByDept(deptId) {
        const currentUrl = new URL(window.location.href);
        if (deptId) {
            currentUrl.searchParams.set('departmentId', deptId);
        } else {
            currentUrl.searchParams.delete('departmentId');
        }
        window.location.href = currentUrl.toString();
    }
</script>