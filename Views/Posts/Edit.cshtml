@model ContentManagementSystem.ApplicationCore.DTOs.PostDto

@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    Layout = "_Layout";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chỉnh sửa bài viết</h2>
            <p class="text-sm text-gray-500 mt-1">Cập nhật nội dung và thông tin xuất bản bài viết.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
            &larr; Quay lại danh sách
        </a>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-sm"></div>

            <div class="space-y-4">
                <!-- Title -->
                <div>
                    <label asp-for="Title" class="block text-sm font-semibold text-gray-700 mb-1">Tiêu đề bài viết <span class="text-rose-500">*</span></label>
                    <input asp-for="Title" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" required />
                    <span asp-validation-for="Title" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Slug -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label asp-for="Slug" class="block text-sm font-semibold text-gray-700">Đường dẫn thân thiện (Slug)</label>
                        <button type="button" id="btnGenerateSlug" class="text-xs text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1 hover:underline">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            Tạo lại từ tiêu đề
                        </button>
                    </div>
                    <input asp-for="Slug" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent font-mono text-gray-700 transition-all" />
                    <p class="text-xs text-gray-400 mt-1">Đổi tiêu đề thì có thể bấm tạo lại hoặc để trống để cập nhật slug tự động.</p>
                    <span asp-validation-for="Slug" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Category, Department & Author -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label asp-for="CategoryId" class="block text-sm font-semibold text-gray-700 mb-1">Chuyên mục <span class="text-rose-500">*</span></label>
                        <select asp-for="CategoryId" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white" asp-items="ViewBag.CategoryId" required></select>
                        <span asp-validation-for="CategoryId" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="DepartmentId" class="block text-sm font-semibold text-gray-700 mb-1">Phòng ban phụ trách</label>
                        <select asp-for="DepartmentId" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white" asp-items="ViewBag.DepartmentId">
                            <option value="">-- Chọn phòng ban --</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="AuthorId" class="block text-sm font-semibold text-gray-700 mb-1">Tác giả <span class="text-rose-500">*</span></label>
                        <select asp-for="AuthorId" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white" asp-items="ViewBag.AuthorId" required></select>
                        <span asp-validation-for="AuthorId" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>
                </div>

                <!-- Tags Selection (Gắn thẻ bài viết) -->
                <div class="p-4 sm:p-5 rounded-2xl bg-gray-50/80 border border-gray-100 space-y-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <label class="block text-sm font-bold text-gray-800 flex items-center gap-1.5">
                                <span class="text-blue-600">🏷️</span> Gắn thẻ bài viết (Tags)
                            </label>
                            <p class="text-xs text-gray-400 mt-0.5">Bấm chọn các thẻ tag có sẵn hoặc gõ thêm tag mới để độc giả dễ tìm kiếm bài viết.</p>
                        </div>
                        <span id="selectedTagsCount" class="text-xs font-semibold px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full border border-blue-100">
                            0 tag đã chọn
                        </span>
                    </div>

                    <!-- Available Tags Chips -->
                    @if (ViewBag.AvailableTags is List<ContentManagementSystem.ApplicationCore.DTOs.TagDto> availableTags && availableTags.Any())
                    {
                        <div class="flex flex-wrap gap-2 pt-1" id="tagsContainer">
                            @foreach (var tag in availableTags)
                            {
                                var isSelected = Model?.SelectedTagIds != null && Model.SelectedTagIds.Contains(tag.Id);
                                <label class="tag-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold cursor-pointer select-none transition-all @(isSelected ? "bg-blue-600 text-white shadow-sm ring-2 ring-blue-400/40" : "bg-white text-gray-700 border border-gray-200 hover:border-blue-300 hover:bg-blue-50/50")">
                                    <input type="checkbox" name="SelectedTagIds" value="@tag.Id" class="hidden tag-checkbox" @(isSelected ? "checked" : "") onchange="updateTagChipState(this)" />
                                    <span class="opacity-60">#</span>
                                    <span>@tag.Name</span>
                                    <span class="tag-check @(isSelected ? "inline" : "hidden") text-[10px] font-bold">✓</span>
                                </label>
                            }
                        </div>
                    }

                    <!-- Quick Add Custom Tag Input -->
                    <div class="pt-2 flex items-center gap-2">
                        <div class="relative flex-1">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400 text-xs font-bold">#</span>
                            <input type="text" id="newTagInput" placeholder="Gõ thêm tag mới (ví dụ: AI, Python, Hướng dẫn...) và bấm Thêm tag" class="w-full pl-7 pr-4 py-2 bg-white rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder-gray-400" onkeydown="handleTagKeydown(event)" />
                        </div>
                        <button type="button" onclick="addCustomTag()" class="px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1 active:scale-95 shadow-xs whitespace-nowrap">
                            + Thêm tag
                        </button>
                    </div>

                    <!-- Hidden input to store custom tags comma-separated -->
                    <input type="hidden" asp-for="CustomTags" id="customTagsInput" />
                    <!-- Dynamic container for newly added custom tag chips -->
                    <div id="customTagsList" class="flex flex-wrap gap-2 empty:hidden pt-1"></div>
                </div>

                <!-- Summary -->
                <div>
                    <label asp-for="Summary" class="block text-sm font-semibold text-gray-700 mb-1">Tóm tắt nội dung</label>
                    <textarea asp-for="Summary" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"></textarea>
                    <span asp-validation-for="Summary" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Content -->
                <div>
                    <label asp-for="Content" class="block text-sm font-semibold text-gray-700 mb-1">Nội dung chi tiết <span class="text-rose-500">*</span></label>
                    <textarea asp-for="Content" rows="12" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent font-sans transition-all" required></textarea>
                    <span asp-validation-for="Content" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- IsPublished Toggle -->
                <div class="pt-2">
                    <label class="relative flex items-center gap-3 cursor-pointer">
                        <input asp-for="IsPublished" type="checkbox" class="w-4 h-4 text-blue-600 rounded border-gray-300 focus:ring-blue-500" />
                        <span class="text-sm font-medium text-gray-700 select-none">Xuất bản bài viết</span>
                    </label>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 text-sm font-medium transition-all">Hủy bỏ</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Cập nhật thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Tag Selection logic
        function updateTagChipState(checkbox) {
            const label = checkbox.closest('label');
            const checkIcon = label.querySelector('.tag-check');
            if (checkbox.checked) {
                label.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:border-blue-300', 'hover:bg-blue-50/50');
                label.classList.add('bg-blue-600', 'text-white', 'shadow-sm', 'ring-2', 'ring-blue-400/40');
                if (checkIcon) checkIcon.classList.remove('hidden');
            } else {
                label.classList.remove('bg-blue-600', 'text-white', 'shadow-sm', 'ring-2', 'ring-blue-400/40');
                label.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:border-blue-300', 'hover:bg-blue-50/50');
                if (checkIcon) checkIcon.classList.add('hidden');
            }
            updateSelectedCount();
        }

        let customTagSet = new Set();
        function addCustomTag() {
            const input = document.getElementById('newTagInput');
            const val = input?.value.trim().replace(/^#/, '');
            if (!val) return;

            if (customTagSet.has(val.toLowerCase())) {
                input.value = '';
                return;
            }

            customTagSet.add(val);
            syncCustomTagsInput();

            const container = document.getElementById('customTagsList');
            if (container) {
                const chip = document.createElement('span');
                chip.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-blue-600 text-white shadow-sm ring-2 ring-blue-400/40';
                chip.innerHTML = `<span>#${escapeHtml(val)}</span><button type="button" onclick="removeCustomTag('${escapeHtml(val)}', this)" class="hover:text-rose-200 ml-0.5 text-xs font-bold cursor-pointer">×</button>`;
                container.appendChild(chip);
            }

            input.value = '';
            updateSelectedCount();
        }

        function removeCustomTag(val, btn) {
            customTagSet.delete(val);
            btn.closest('span')?.remove();
            syncCustomTagsInput();
            updateSelectedCount();
        }

        function syncCustomTagsInput() {
            const hidden = document.getElementById('customTagsInput');
            if (hidden) hidden.value = Array.from(customTagSet).join(',');
        }

        function handleTagKeydown(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addCustomTag();
            }
        }

        function updateSelectedCount() {
            const checkedCount = document.querySelectorAll('.tag-checkbox:checked').length;
            const total = checkedCount + customTagSet.size;
            const badge = document.getElementById('selectedTagsCount');
            if (badge) badge.innerText = total + ' tag đã chọn';
        }

        function escapeHtml(str) {
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // Slug Auto-generation
        document.getElementById('btnGenerateSlug')?.addEventListener('click', function () {
            const title = document.getElementById('Title')?.value || '';
            const slug = toSlug(title);
            const slugInput = document.getElementById('Slug');
            if (slugInput) slugInput.value = slug;
        });

        document.getElementById('Title')?.addEventListener('input', function () {
            const slugInput = document.getElementById('Slug');
            if (slugInput && !slugInput.dataset.manual) {
                slugInput.value = toSlug(this.value);
            }
        });

        document.getElementById('Slug')?.addEventListener('input', function () {
            this.dataset.manual = 'true';
        });

        function toSlug(str) {
            str = str.toLowerCase();
            str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, 'a');
            str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, 'e');
            str = str.replace(/ì|í|ị|ỉ|ĩ/g, 'i');
            str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, 'o');
            str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, 'u');
            str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, 'y');
            str = str.replace(/đ/g, 'd');
            str = str.replace(/[^a-z0-9 -]/g, '');
            str = str.replace(/\s+/g, '-');
            str = str.replace(/-+/g, '-');
            return str.trim();
        }

        document.addEventListener('DOMContentLoaded', updateSelectedCount);
    </script>
}

