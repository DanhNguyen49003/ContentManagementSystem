@model ContentManagementSystem.ApplicationCore.DTOs.PostDto
@using ContentManagementSystem.Services
@inject ICurrentUserService CurrentUserService

@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
    Layout = "_Layout";
    var currentUser = await CurrentUserService.GetCurrentUserAsync();
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chỉnh sửa bài viết</h2>
            <p class="text-sm text-gray-500 mt-1">Cập nhật nội dung và thông tin xuất bản bài viết.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
            &larr; Quay lại danh sách
        </a>
    </div>

    @{
        bool isReviewer = currentUser.IsAdmin || currentUser.IsQACoordinator || currentUser.IsQAManager;
        bool isClosedForAuthor = !isReviewer && !Model.IsSubmissionOpen;
    }

    <!-- QA Reviewer Feedback Notice (For Author) -->
    @if (Model.Status == "ChangesRequested")
    {
        <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-amber-50 to-orange-50 border border-amber-200/90 flex flex-col gap-3 shadow-xs">
            <div class="flex items-start gap-3">
                <div class="p-2 bg-amber-100 text-amber-800 rounded-xl text-xl flex-shrink-0">🔄</div>
                <div class="flex-1">
                    <div class="flex items-center gap-2">
                        <h4 class="font-bold text-amber-900 text-sm">Bài viết cần chỉnh sửa theo yêu cầu của QA Coordinator</h4>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-200 text-amber-900">Yêu cầu sửa đổi</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.ReviewerFeedback))
                    {
                        <div class="mt-2 p-3 bg-white/80 rounded-xl border border-amber-200 text-xs text-amber-950 font-medium leading-relaxed italic">
                            <span class="font-bold not-italic text-amber-800 block mb-1">💬 Ghi chú từ người duyệt (@(Model.ReviewedByName ?? "QA Coordinator")):</span>
                            @Model.ReviewerFeedback
                        </div>
                    }
                    <p class="text-xs text-amber-700 mt-2">
                        💡 Sau khi bạn hoàn thiện nội dung và bấm <strong>"Cập nhật và nộp lại"</strong>, bài viết sẽ tự động chuyển về trạng thái <strong>Chờ duyệt (Pending)</strong> để ban kiểm duyệt xem lại.
                    </p>
                </div>
            </div>
        </div>
    }
    else if (Model.Status == "Rejected")
    {
        <div class="p-4 rounded-2xl bg-red-50 border border-red-200 flex items-start gap-3 shadow-xs">
            <div class="p-2 bg-red-100 text-red-700 rounded-xl text-xl flex-shrink-0">❌</div>
            <div class="flex-1">
                <h4 class="font-bold text-red-900 text-sm">Bài viết đã bị từ chối</h4>
                @if (!string.IsNullOrEmpty(Model.ReviewerFeedback))
                {
                    <div class="mt-1.5 p-2.5 bg-white/80 rounded-xl border border-red-200 text-xs text-red-900 italic">
                        <strong>Lý do:</strong> @Model.ReviewerFeedback
                    </div>
                }
            </div>
        </div>
    }

    <!-- Submission Window Notice -->
    @if (!string.IsNullOrEmpty(Model.SubmissionWindowName))
    {
        <div class="p-3.5 rounded-xl border text-xs flex items-center justify-between gap-3 @(Model.IsSubmissionOpen ? "bg-blue-50/70 border-blue-200/60 text-blue-900" : "bg-red-50/80 border-red-200 text-red-900")">
            <div class="flex items-center gap-2">
                <span>📅</span>
                <span>Đợt nộp bài: <strong>@Model.SubmissionWindowName</strong></span>
                <span>•</span>
                <span>Hạn nộp: <strong>@(Model.SubmissionClosureDate?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Không giới hạn")</strong></span>
            </div>
            @if (!Model.IsSubmissionOpen)
            {
                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-red-100 text-red-700 border border-red-200">
                    ⛔ ĐÃ HẾT HẠN NỘP BÀI
                </span>
            }
            else
            {
                <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">
                    🟢 Còn thời hạn nộp
                </span>
            }
        </div>
    }

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <form asp-action="Edit" method="post" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="AuthorId" />
            <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-sm"></div>

            <div class="space-y-4">
                <!-- Title -->
                <div>
                    <label asp-for="Title" class="block text-sm font-semibold text-gray-700 mb-1">Tiêu đề bài viết <span class="text-rose-500">*</span></label>
                    <input asp-for="Title" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" required />
                    <span asp-validation-for="Title" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Slug -->
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label asp-for="Slug" class="block text-sm font-semibold text-gray-700">Đường dẫn thân thiện (Slug)</label>
                        <button type="button" id="btnGenerateSlug" class="text-xs text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1 hover:underline">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                            Tạo lại từ tiêu đề
                        </button>
                    </div>
                    <input asp-for="Slug" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent font-mono text-gray-700 transition-all" />
                    <p class="text-xs text-gray-400 mt-1">Đổi tiêu đề thì có thể bấm tạo lại hoặc để trống để cập nhật slug tự động.</p>
                    <span asp-validation-for="Slug" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Category & Department -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label asp-for="CategoryId" class="block text-sm font-semibold text-gray-700 mb-1">Chuyên mục <span class="text-rose-500">*</span></label>
                        <select asp-for="CategoryId" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white" asp-items="ViewBag.CategoryId" required></select>
                        <span asp-validation-for="CategoryId" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="DepartmentId" class="block text-sm font-semibold text-gray-700 mb-1">
                            Phòng ban phụ trách <span class="text-rose-500">*</span>
                        </label>
                        @if (ViewBag.IsDepartmentLocked == true)
                        {
                            <div class="p-2.5 bg-blue-50/80 border border-blue-200 rounded-xl flex items-center justify-between">
                                <div class="flex items-center gap-2.5">
                                    <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-sm flex-shrink-0">
                                        🏢
                                    </div>
                                    <div>
                                        <span class="text-xs font-bold text-blue-900 block">@ViewBag.LockedDepartmentName</span>
                                        <span class="text-[10px] text-blue-600">Phòng ban của bài viết (Cố định, không thể đổi)</span>
                                    </div>
                                </div>
                                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-200/80 text-blue-800">Cố định</span>
                            </div>
                            <input type="hidden" asp-for="DepartmentId" value="@ViewBag.LockedDepartmentId" />
                        }
                        else
                        {
                            <select asp-for="DepartmentId" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white" asp-items="ViewBag.DepartmentId">
                                <option value="">-- Chọn phòng ban --</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-xs text-rose-500 mt-1 block"></span>
                        }
                    </div>
                </div>

                <!-- Tác giả & Đăng bài ẩn danh -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Author info card (Read-only) -->
                    <div class="p-4 rounded-2xl bg-gray-50 border border-gray-200/80 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center text-sm shadow-xs">
                                @(!string.IsNullOrEmpty(Model.AuthorName) ? Model.AuthorName.Substring(0, 1).ToUpper() : "U")
                            </div>
                            <div>
                                <span class="text-[11px] uppercase font-bold text-gray-400 block tracking-wider">Tác giả bài viết</span>
                                <span class="text-sm font-bold text-gray-800">@(!string.IsNullOrEmpty(Model.AuthorName) ? Model.AuthorName : "Chính bạn")</span>
                            </div>
                        </div>
                        <span class="text-[10px] font-semibold text-slate-600 bg-slate-100 px-2.5 py-1 rounded-full border border-slate-200">
                            Cố định
                        </span>
                    </div>

                    <!-- Đăng ẩn danh Toggle -->
                    <div class="p-4 rounded-2xl bg-gradient-to-r from-purple-50 to-indigo-50 border border-purple-200 flex items-center justify-between gap-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-purple-100 text-purple-700 flex items-center justify-center text-xl flex-shrink-0 shadow-xs">
                                🎭
                            </div>
                            <div>
                                <label for="isAnonymousCheck" class="text-sm font-bold text-gray-900 cursor-pointer flex items-center gap-1.5">
                                    <span>Đăng bài ẩn danh</span>
                                    <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-purple-200 text-purple-800">Riêng tư</span>
                                </label>
                                <p class="text-[11px] text-gray-500 mt-0.5">Ẩn danh tính thành <strong>"Người dùng ẩn danh"</strong> đối với bạn đọc.</p>
                            </div>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer flex-shrink-0">
                            <input asp-for="IsAnonymous" type="checkbox" id="isAnonymousCheck" class="sr-only peer" />
                            <div class="w-11 h-6 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
                        </label>
                    </div>
                </div>

                <!-- Tags Selection (Gắn thẻ bài viết) -->
                <div class="p-4 sm:p-5 rounded-2xl bg-gray-50/80 border border-gray-100 space-y-3">
                    <div class="flex items-center justify-between">
                        <div>
                            <label class="block text-sm font-bold text-gray-800 flex items-center gap-1.5">
                                <span class="text-blue-600">🏷️</span> Gắn thẻ bài viết (Tags)
                            </label>
                            <p class="text-xs text-gray-400 mt-0.5">Bấm chọn các thẻ tag có sẵn hoặc gõ thêm tag mới để độc giả dễ tìm kiếm bài viết.</p>
                        </div>
                        <span id="selectedTagsCount" class="text-xs font-semibold px-2.5 py-1 bg-blue-50 text-blue-700 rounded-full border border-blue-100">
                            0 tag đã chọn
                        </span>
                    </div>

                    <!-- Available Tags Chips -->
                    @if (ViewBag.AvailableTags is List<ContentManagementSystem.ApplicationCore.DTOs.TagDto> availableTags && availableTags.Any())
                    {
                        <div class="flex flex-wrap gap-2 pt-1" id="tagsContainer">
                            @foreach (var tag in availableTags)
                            {
                                var isSelected = Model?.SelectedTagIds != null && Model.SelectedTagIds.Contains(tag.Id);
                                <label class="tag-chip inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold cursor-pointer select-none transition-all @(isSelected ? "bg-blue-600 text-white shadow-sm ring-2 ring-blue-400/40" : "bg-white text-gray-700 border border-gray-200 hover:border-blue-300 hover:bg-blue-50/50")">
                                    <input type="checkbox" name="SelectedTagIds" value="@tag.Id" class="hidden tag-checkbox" @(isSelected ? "checked" : "") onchange="updateTagChipState(this)" />
                                    <span class="opacity-60">#</span>
                                    <span>@tag.Name</span>
                                    <span class="tag-check @(isSelected ? "inline" : "hidden") text-[10px] font-bold">✓</span>
                                </label>
                            }
                        </div>
                    }

                    <!-- Quick Add Custom Tag Input -->
                    <div class="pt-2 flex items-center gap-2">
                        <div class="relative flex-1">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400 text-xs font-bold">#</span>
                            <input type="text" id="newTagInput" placeholder="Gõ thêm tag mới (ví dụ: AI, Python, Hướng dẫn...) và bấm Thêm tag" class="w-full pl-7 pr-4 py-2 bg-white rounded-xl border border-gray-200 text-xs focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all placeholder-gray-400" onkeydown="handleTagKeydown(event)" />
                        </div>
                        <button type="button" onclick="addCustomTag()" class="px-4 py-2 bg-gray-900 hover:bg-gray-800 text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1 active:scale-95 shadow-xs whitespace-nowrap">
                            + Thêm tag
                        </button>
                    </div>

                    <!-- Hidden input to store custom tags comma-separated -->
                    <input type="hidden" asp-for="CustomTags" id="customTagsInput" />
                    <!-- Dynamic container for newly added custom tag chips -->
                    <div id="customTagsList" class="flex flex-wrap gap-2 empty:hidden pt-1"></div>
                </div>

                <!-- Summary -->
                <div>
                    <label asp-for="Summary" class="block text-sm font-semibold text-gray-700 mb-1">Tóm tắt nội dung</label>
                    <textarea asp-for="Summary" rows="3" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"></textarea>
                    <span asp-validation-for="Summary" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Content -->
                <div>
                    <label asp-for="Content" class="block text-sm font-semibold text-gray-700 mb-1">Nội dung chi tiết <span class="text-rose-500">*</span></label>
                    <textarea asp-for="Content" rows="12" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent font-sans transition-all" required></textarea>
                    <span asp-validation-for="Content" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- IsPublished Toggle -->
                <div class="pt-2">
                    @if (ViewBag.CanApprove == true)
                    {
                        <div class="p-4 rounded-xl bg-emerald-50/70 border border-emerald-200 flex items-center justify-between gap-3">
                            <div>
                                <label class="relative flex items-center gap-3 cursor-pointer">
                                    <input asp-for="IsPublished" type="checkbox" class="w-4 h-4 text-emerald-600 rounded border-gray-300 focus:ring-emerald-500" />
                                    <span class="text-sm font-bold text-emerald-950 select-none">Xuất bản bài viết (Phê duyệt công khai)</span>
                                </label>
                                <p class="text-xs text-emerald-700 mt-0.5 ml-7">Bạn có thẩm quyền phê duyệt bài viết này với tư cách Admin hoặc QA Coordinator phụ trách phòng ban.</p>
                            </div>
                            <span class="px-2.5 py-1 bg-emerald-100 text-emerald-800 text-[11px] font-bold rounded-lg uppercase tracking-wider">Người duyệt</span>
                        </div>
                    }
                    else
                    {
                        <input type="hidden" asp-for="IsPublished" />
                        <div class="p-4 rounded-xl bg-gray-50 border border-gray-200 text-gray-700 text-xs flex items-center justify-between gap-3">
                            <div class="flex items-center gap-2">
                                <span class="text-gray-500 font-medium">Trạng thái bài viết:</span>
                                @if (Model?.IsPublished == true)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-emerald-100 text-emerald-800 rounded-lg text-xs font-bold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Đã duyệt & Xuất bản
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-amber-100 text-amber-800 rounded-lg text-xs font-bold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span> Chờ duyệt (Chưa đăng)
                                    </span>
                                }
                            </div>
                            <span class="text-gray-400 italic">Chỉ Admin hoặc QA Coordinator phòng ban mới có quyền duyệt bài</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="pt-6 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 text-sm font-medium transition-all">Hủy bỏ</a>
                @if (isClosedForAuthor)
                {
                    <button type="button" disabled class="px-6 py-2.5 rounded-xl bg-gray-300 text-gray-500 text-sm font-semibold cursor-not-allowed flex items-center gap-2" title="Đợt nộp bài đã qua hạn Closure Date">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        Đợt nộp đã đóng
                    </button>
                }
                else if (Model.Status == "ChangesRequested" && !isReviewer)
                {
                    <button type="submit" class="px-6 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center gap-2 active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        Cập nhật và Nộp lại xét duyệt
                    </button>
                }
                else
                {
                    <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center gap-2 active:scale-95">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                        Cập nhật thay đổi
                    </button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Tag Selection logic
        function updateTagChipState(checkbox) {
            const label = checkbox.closest('label');
            const checkIcon = label.querySelector('.tag-check');
            if (checkbox.checked) {
                label.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:border-blue-300', 'hover:bg-blue-50/50');
                label.classList.add('bg-blue-600', 'text-white', 'shadow-sm', 'ring-2', 'ring-blue-400/40');
                if (checkIcon) checkIcon.classList.remove('hidden');
            } else {
                label.classList.remove('bg-blue-600', 'text-white', 'shadow-sm', 'ring-2', 'ring-blue-400/40');
                label.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200', 'hover:border-blue-300', 'hover:bg-blue-50/50');
                if (checkIcon) checkIcon.classList.add('hidden');
            }
            updateSelectedCount();
        }

        let customTagSet = new Set();
        function addCustomTag() {
            const input = document.getElementById('newTagInput');
            const val = input?.value.trim().replace(/^#/, '');
            if (!val) return;

            if (customTagSet.has(val.toLowerCase())) {
                input.value = '';
                return;
            }

            customTagSet.add(val);
            syncCustomTagsInput();

            const container = document.getElementById('customTagsList');
            if (container) {
                const chip = document.createElement('span');
                chip.className = 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-blue-600 text-white shadow-sm ring-2 ring-blue-400/40';
                chip.innerHTML = `<span>#${escapeHtml(val)}</span><button type="button" onclick="removeCustomTag('${escapeHtml(val)}', this)" class="hover:text-rose-200 ml-0.5 text-xs font-bold cursor-pointer">×</button>`;
                container.appendChild(chip);
            }

            input.value = '';
            updateSelectedCount();
        }

        function removeCustomTag(val, btn) {
            customTagSet.delete(val);
            btn.closest('span')?.remove();
            syncCustomTagsInput();
            updateSelectedCount();
        }

        function syncCustomTagsInput() {
            const hidden = document.getElementById('customTagsInput');
            if (hidden) hidden.value = Array.from(customTagSet).join(',');
        }

        function handleTagKeydown(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addCustomTag();
            }
        }

        function updateSelectedCount() {
            const checkedCount = document.querySelectorAll('.tag-checkbox:checked').length;
            const total = checkedCount + customTagSet.size;
            const badge = document.getElementById('selectedTagsCount');
            if (badge) badge.innerText = total + ' tag đã chọn';
        }

        function escapeHtml(str) {
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // Slug Auto-generation
        document.getElementById('btnGenerateSlug')?.addEventListener('click', function () {
            const title = document.getElementById('Title')?.value || '';
            const slug = toSlug(title);
            const slugInput = document.getElementById('Slug');
            if (slugInput) slugInput.value = slug;
        });

        document.getElementById('Title')?.addEventListener('input', function () {
            const slugInput = document.getElementById('Slug');
            if (slugInput && !slugInput.dataset.manual) {
                slugInput.value = toSlug(this.value);
            }
        });

        document.getElementById('Slug')?.addEventListener('input', function () {
            this.dataset.manual = 'true';
        });

        function toSlug(str) {
            str = str.toLowerCase();
            str = str.replace(/à|á|ạ|ả|ã|â|ầ|ấ|ậ|ẩ|ẫ|ă|ằ|ắ|ặ|ẳ|ẵ/g, 'a');
            str = str.replace(/è|é|ẹ|ẻ|ẽ|ê|ề|ế|ệ|ể|ễ/g, 'e');
            str = str.replace(/ì|í|ị|ỉ|ĩ/g, 'i');
            str = str.replace(/ò|ó|ọ|ỏ|õ|ô|ồ|ố|ộ|ổ|ỗ|ơ|ờ|ớ|ợ|ở|ỡ/g, 'o');
            str = str.replace(/ù|ú|ụ|ủ|ũ|ư|ừ|ứ|ự|ử|ữ/g, 'u');
            str = str.replace(/ỳ|ý|ỵ|ỷ|ỹ/g, 'y');
            str = str.replace(/đ/g, 'd');
            str = str.replace(/[^a-z0-9 -]/g, '');
            str = str.replace(/\s+/g, '-');
            str = str.replace(/-+/g, '-');
            return str.trim();
        }

        document.addEventListener('DOMContentLoaded', updateSelectedCount);
    </script>
}

