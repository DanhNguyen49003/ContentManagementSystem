@model IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.PostDto>
@using ContentManagementSystem.Services
@inject ICurrentUserService CurrentUserService

@{
    ViewData["Title"] = "Bài viết của tôi";
    Layout = "_Layout";

    var currentUser = await CurrentUserService.GetCurrentUserAsync();
    var currentStatus = ViewBag.CurrentStatus as string ?? "";
    var searchTerm = ViewBag.SearchTerm as string ?? "";
    var userDeptName = ViewBag.UserDepartmentName as string ?? currentUser.DepartmentName ?? "Chưa phân phòng ban";
    var activeWindow = ViewBag.ActiveWindow as ContentManagementSystem.ApplicationCore.DTOs.SubmissionWindowDto;

    int countAll = ViewBag.CountAll ?? 0;
    int countPending = ViewBag.CountPending ?? 0;
    int countChanges = ViewBag.CountChanges ?? 0;
    int countApproved = ViewBag.CountApproved ?? 0;
    int countRejected = ViewBag.CountRejected ?? 0;

    var postsList = Model?.ToList() ?? new List<ContentManagementSystem.ApplicationCore.DTOs.PostDto>();
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <h2 class="text-2xl font-black text-gray-900 tracking-tight">📁 Bài viết của tôi</h2>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200">
                    🏢 @userDeptName
                </span>
            </div>
            <p class="text-sm text-gray-500 mt-1">
                Theo dõi vòng đời bài viết, tiếp nhận phản hồi từ QA Coordinator và chỉnh sửa kịp thời trong thời hạn đợt nộp.
            </p>
        </div>

        <div class="flex items-center gap-2.5">
            <a asp-action="Index" class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 border border-gray-200 px-4 py-2.5 rounded-xl text-sm font-semibold shadow-xs transition-all active:scale-95">
                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                </svg>
                <span>Xem tất cả bài viết</span>
            </a>
            <a asp-action="Create" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl text-sm font-bold shadow-sm transition-all active:scale-95">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                <span>Viết bài mới</span>
            </a>
        </div>
    </div>

    <!-- Toast Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-3 shadow-xs">
            <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-xs">
            <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Stat Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5">
        <!-- Tất cả -->
        <a href="@Url.Action("MyPosts", new { search = searchTerm })" 
           class="p-4 rounded-2xl border transition-all duration-200 @(string.IsNullOrEmpty(currentStatus) ? "bg-blue-50/70 border-blue-300 ring-2 ring-blue-500/20 shadow-sm" : "bg-white border-gray-200/80 hover:border-gray-300 hover:shadow-xs")">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-gray-500">Tất cả bài</span>
                <span class="text-base">📝</span>
            </div>
            <div class="text-2xl font-black text-gray-900 mt-2">@countAll</div>
            <div class="text-[11px] text-gray-400 mt-0.5">Tổng số đã tạo</div>
        </a>

        <!-- Chờ duyệt -->
        <a href="@Url.Action("MyPosts", new { status = "Pending", search = searchTerm })" 
           class="p-4 rounded-2xl border transition-all duration-200 @(currentStatus == "Pending" ? "bg-amber-50/70 border-amber-300 ring-2 ring-amber-500/20 shadow-sm" : "bg-white border-gray-200/80 hover:border-gray-300 hover:shadow-xs")">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-amber-700">Chờ duyệt</span>
                <span class="text-base">⏳</span>
            </div>
            <div class="text-2xl font-black text-amber-600 mt-2">@countPending</div>
            <div class="text-[11px] text-amber-600/80 mt-0.5">QA đang kiểm tra</div>
        </a>

        <!-- Cần sửa -->
        <a href="@Url.Action("MyPosts", new { status = "Changes", search = searchTerm })" 
           class="p-4 rounded-2xl border transition-all duration-200 @(currentStatus == "Changes" ? "bg-orange-50/70 border-orange-300 ring-2 ring-orange-500/20 shadow-sm" : "bg-white border-gray-200/80 hover:border-gray-300 hover:shadow-xs")">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-orange-700">Cần sửa đổi</span>
                <span class="text-base">🔄</span>
            </div>
            <div class="text-2xl font-black text-orange-600 mt-2">@countChanges</div>
            <div class="text-[11px] text-orange-600/80 mt-0.5">Có phản hồi từ QA</div>
        </a>

        <!-- Đã duyệt -->
        <a href="@Url.Action("MyPosts", new { status = "Approved", search = searchTerm })" 
           class="p-4 rounded-2xl border transition-all duration-200 @(currentStatus == "Approved" ? "bg-emerald-50/70 border-emerald-300 ring-2 ring-emerald-500/20 shadow-sm" : "bg-white border-gray-200/80 hover:border-gray-300 hover:shadow-xs")">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-emerald-700">Đã xuất bản</span>
                <span class="text-base">✅</span>
            </div>
            <div class="text-2xl font-black text-emerald-600 mt-2">@countApproved</div>
            <div class="text-[11px] text-emerald-600/80 mt-0.5">Đã công khai</div>
        </a>

        <!-- Bị từ chối -->
        <a href="@Url.Action("MyPosts", new { status = "Rejected", search = searchTerm })" 
           class="p-4 rounded-2xl border transition-all duration-200 @(currentStatus == "Rejected" ? "bg-rose-50/70 border-rose-300 ring-2 ring-rose-500/20 shadow-sm" : "bg-white border-gray-200/80 hover:border-gray-300 hover:shadow-xs")">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-rose-700">Bị từ chối</span>
                <span class="text-base">❌</span>
            </div>
            <div class="text-2xl font-black text-rose-600 mt-2">@countRejected</div>
            <div class="text-[11px] text-rose-600/80 mt-0.5">Không đạt chuẩn</div>
        </a>
    </div>

    <!-- Main Content Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <!-- Search and Filter Bar -->
        <div class="p-4 border-b border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-3">
            <!-- Filter Tabs -->
            <div class="flex items-center gap-1.5 flex-wrap w-full sm:w-auto">
                <a href="@Url.Action("MyPosts", new { search = searchTerm })" 
                   class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all @(string.IsNullOrEmpty(currentStatus) ? "bg-gray-900 text-white shadow-xs" : "bg-gray-100 text-gray-600 hover:bg-gray-200")">
                    Tất cả (@countAll)
                </a>
                <a href="@Url.Action("MyPosts", new { status = "Pending", search = searchTerm })" 
                   class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all @(currentStatus == "Pending" ? "bg-amber-500 text-white shadow-xs" : "bg-amber-50 text-amber-700 hover:bg-amber-100")">
                    Chờ duyệt (@countPending)
                </a>
                <a href="@Url.Action("MyPosts", new { status = "Changes", search = searchTerm })" 
                   class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all @(currentStatus == "Changes" ? "bg-orange-500 text-white shadow-xs" : "bg-orange-50 text-orange-700 hover:bg-orange-100")">
                    Cần sửa (@countChanges)
                </a>
                <a href="@Url.Action("MyPosts", new { status = "Approved", search = searchTerm })" 
                   class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all @(currentStatus == "Approved" ? "bg-emerald-600 text-white shadow-xs" : "bg-emerald-50 text-emerald-700 hover:bg-emerald-100")">
                    Đã xuất bản (@countApproved)
                </a>
                <a href="@Url.Action("MyPosts", new { status = "Rejected", search = searchTerm })" 
                   class="px-3 py-1.5 rounded-xl text-xs font-bold transition-all @(currentStatus == "Rejected" ? "bg-rose-600 text-white shadow-xs" : "bg-rose-50 text-rose-700 hover:bg-rose-100")">
                    Từ chối (@countRejected)
                </a>
            </div>

            <!-- Search form -->
            <form method="get" asp-action="MyPosts" class="w-full sm:w-72">
                <input type="hidden" name="status" value="@currentStatus" />
                <div class="relative">
                    <input type="text" name="search" value="@searchTerm" placeholder="Tìm theo tiêu đề..." 
                           class="w-full pl-9 pr-3 py-1.5 text-xs bg-gray-50 border border-gray-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" />
                    <svg class="w-4 h-4 text-gray-400 absolute left-2.5 top-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </div>
            </form>
        </div>

        <!-- Table -->
        @if (postsList.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-50/75 text-gray-500 text-xs uppercase tracking-wider border-b border-gray-100">
                            <th class="px-5 py-3.5 font-bold">Tiêu đề bài viết</th>
                            <th class="px-5 py-3.5 font-bold">Chuyên mục / Đợt nộp</th>
                            <th class="px-5 py-3.5 font-bold">Trạng thái</th>
                            <th class="px-5 py-3.5 font-bold">Ngày gửi</th>
                            <th class="px-5 py-3.5 font-bold text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 text-sm">
                        @foreach (var post in postsList)
                        {
                            var isApproved = post.IsPublished;
                            var isPending = (post.Status == "Pending" || string.IsNullOrEmpty(post.Status)) && !post.IsPublished;
                            var isChangesRequested = post.Status == "ChangesRequested";
                            var isRejected = post.Status == "Rejected";

                            <tr class="hover:bg-slate-50/60 transition-colors">
                                <!-- Title & Feedback Preview -->
                                <td class="px-5 py-4 max-w-md">
                                    <div class="flex items-start gap-2.5">
                                        <a asp-action="Details" asp-route-id="@post.Id" class="font-bold text-gray-900 hover:text-blue-600 transition-colors line-clamp-1 block">
                                            @post.Title
                                        </a>
                                        @if (post.IsAnonymous)
                                        {
                                            <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded-full bg-purple-100 text-purple-700 flex-shrink-0" title="Bài viết được đăng ở chế độ Ẩn danh">
                                                🎭 Ẩn danh
                                            </span>
                                        }
                                    </div>

                                    @if (!string.IsNullOrEmpty(post.Summary))
                                    {
                                        <p class="text-xs text-gray-500 line-clamp-1 mt-1">@post.Summary</p>
                                    }

                                    <!-- Feedback Box if ChangesRequested -->
                                    @if (isChangesRequested && !string.IsNullOrEmpty(post.ReviewerFeedback))
                                    {
                                        <div class="mt-2.5 p-2.5 rounded-xl bg-orange-50 border border-orange-200 text-orange-900 text-xs">
                                            <div class="flex items-center gap-1.5 font-bold text-orange-800 mb-1">
                                                <span>🔄 Yêu cầu chỉnh sửa từ QA Coordinator:</span>
                                            </div>
                                            <p class="italic text-orange-700 font-medium">"@post.ReviewerFeedback"</p>
                                            <div class="mt-2">
                                                <a asp-action="Edit" asp-route-id="@post.Id" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-orange-600 hover:bg-orange-700 text-white font-bold text-[11px] shadow-xs transition-colors">
                                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                                    Chỉnh sửa & Nộp lại ngay &rarr;
                                                </a>
                                            </div>
                                        </div>
                                    }

                                    <!-- Feedback Box if Rejected -->
                                    @if (isRejected && !string.IsNullOrEmpty(post.ReviewerFeedback))
                                    {
                                        <div class="mt-2.5 p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-900 text-xs">
                                            <span class="font-bold text-rose-800">❌ Lý do từ chối:</span>
                                            <span class="italic text-rose-700 font-medium ml-1">"@post.ReviewerFeedback"</span>
                                        </div>
                                    }
                                </td>

                                <!-- Category & Department -->
                                <td class="px-5 py-4 whitespace-nowrap">
                                    <div class="space-y-1">
                                        <span class="inline-block px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-100">
                                            @post.CategoryName
                                        </span>
                                        <div class="text-[11px] text-gray-500 flex items-center gap-1">
                                            <span>🏢 @post.DepartmentName</span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(post.SubmissionWindowName))
                                        {
                                            <div class="text-[10px] text-gray-400">
                                                Đợt: @post.SubmissionWindowName
                                            </div>
                                        }
                                    </div>
                                </td>

                                <!-- Status Badge -->
                                <td class="px-5 py-4 whitespace-nowrap">
                                    @if (isApproved)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-xs">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            Đã xuất bản
                                        </span>
                                    }
                                    else if (isChangesRequested)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-orange-50 text-orange-700 border border-orange-200 shadow-xs">
                                            <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span>
                                            Cần chỉnh sửa
                                        </span>
                                    }
                                    else if (isRejected)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200 shadow-xs">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                            Bị từ chối
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 shadow-xs">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                                            Chờ duyệt
                                        </span>
                                    }
                                </td>

                                <!-- Created Date -->
                                <td class="px-5 py-4 whitespace-nowrap text-xs text-gray-500 font-medium">
                                    <div>@post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                    <div class="text-[10px] text-gray-400">@post.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                                </td>

                                <!-- Actions -->
                                <td class="px-5 py-4 whitespace-nowrap text-right text-xs">
                                    <div class="flex items-center justify-end gap-2">
                                        <!-- Chi tiết -->
                                        <a asp-action="Details" asp-route-id="@post.Id" 
                                           class="p-2 text-gray-500 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-colors" title="Xem chi tiết bài viết">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                            </svg>
                                        </a>

                                        <!-- Chỉnh sửa (chỉ khi chưa duyệt hoặc được yêu cầu sửa, và còn hạn đợt nộp) -->
                                        @if (!isApproved && post.IsSubmissionOpen)
                                        {
                                            <a asp-action="Edit" asp-route-id="@post.Id" 
                                               class="p-2 text-gray-500 hover:text-orange-600 hover:bg-orange-50 rounded-xl transition-colors" title="Chỉnh sửa nội dung bài viết">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                                </svg>
                                            </a>
                                        }

                                        <!-- Rút bài / Xóa (chỉ khi chưa xuất bản) -->
                                        @if (!isApproved)
                                        {
                                            <form asp-action="DeleteMyPost" asp-route-id="@post.Id" method="post" class="inline m-0" onsubmit="return confirm('Bạn có chắc chắn muốn rút/xóa bài viết \'@post.Title\' này không?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="p-2 text-gray-400 hover:text-rose-600 hover:bg-rose-50 rounded-xl transition-colors cursor-pointer" title="Rút / Xóa bài viết">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                    </svg>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="py-16 text-center px-4">
                <div class="w-16 h-16 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center mx-auto mb-3 text-2xl shadow-xs">
                    ✍️
                </div>
                <h3 class="text-base font-bold text-gray-800">Chưa có bài viết nào</h3>
                <p class="text-xs text-gray-400 mt-1 max-w-sm mx-auto">
                    @(string.IsNullOrEmpty(currentStatus) 
                        ? "Bạn chưa tạo bài viết nào. Hãy chia sẻ ý tưởng hoặc sáng kiến của bạn ngay hôm nay!" 
                        : "Không tìm thấy bài viết nào ở trạng thái này.")
                </p>
                <div class="mt-4">
                    <a asp-action="Create" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-sm transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                        Tạo bài viết mới
                    </a>
                </div>
            </div>
        }
    </div>
</div>

