@model ContentManagementSystem.ApplicationCore.DTOs.TestimonialDto

@{
    ViewData["Title"] = "Chi tiết nhận xét";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chi tiết nhận xét</h2>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
                &larr; Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-xl shadow-sm transition-all">
                Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 space-y-4">
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Khách hàng:</span>
            <p class="text-xl font-bold text-gray-900">@Model.CustomerName</p>
        </div>
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Đánh giá:</span>
            <div class="flex items-center text-amber-400 text-lg">
                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Model.Rating)
                    {
                        <span>★</span>
                    }
                    else
                    {
                        <span class="text-gray-200">★</span>
                    }
                }
                <span class="ml-2 text-sm text-gray-600 font-semibold">(@Model.Rating/5)</span>
            </div>
        </div>
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Nội dung cảm nhận:</span>
            <div class="p-5 bg-gray-50 rounded-xl text-gray-800 text-sm leading-relaxed border border-gray-100">
                "@Model.Content"
            </div>
        </div>
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Ngày gửi:</span>
            <p class="text-xs text-gray-500">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
        </div>
    </div>
</div>

