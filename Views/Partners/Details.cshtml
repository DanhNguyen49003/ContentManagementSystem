@model ContentManagementSystem.ApplicationCore.DTOs.PartnerDto

@{
    ViewData["Title"] = "Chi tiết đối tác";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chi tiết đối tác</h2>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
                &larr; Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-xl shadow-sm transition-all">
                Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 space-y-4">
        @if (!string.IsNullOrEmpty(Model.LogoUrl))
        {
            <div class="w-24 h-16 bg-white p-2 border border-gray-100 rounded-xl shadow-sm flex items-center justify-center">
                <img src="@Model.LogoUrl" alt="@Model.Name" class="max-w-full max-h-full object-contain" />
            </div>
        }
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Tên đối tác:</span>
            <p class="text-xl font-bold text-gray-900">@Model.Name</p>
        </div>
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Website:</span>
            <a href="@Model.WebsiteUrl" target="_blank" class="text-blue-600 hover:underline text-sm font-medium">@Model.WebsiteUrl</a>
        </div>
    </div>
</div>

