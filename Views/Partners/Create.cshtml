@model ContentManagementSystem.ApplicationCore.DTOs.PartnerDto

@{
    ViewData["Title"] = "Thêm đối tác";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Thêm đối tác</h2>
        </div>
        <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
            &larr; Quay lại
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-sm"></div>

            <div>
                <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-1">Tên đối tác <span class="text-rose-500">*</span></label>
                <input asp-for="Name" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="VD: Google, Microsoft..." required />
                <span asp-validation-for="Name" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="LogoUrl" class="block text-sm font-semibold text-gray-700 mb-1">URL Logo</label>
                <input asp-for="LogoUrl" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="https://example.com/logo.png" />
                <span asp-validation-for="LogoUrl" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="WebsiteUrl" class="block text-sm font-semibold text-gray-700 mb-1">Trang web (Website URL)</label>
                <input asp-for="WebsiteUrl" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="https://example.com" />
                <span asp-validation-for="WebsiteUrl" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 text-sm font-medium transition-all">Hủy bỏ</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Lưu đối tác
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

