@model IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.TagDto>
@using ContentManagementSystem.Services
@inject ICurrentUserService CurrentUserService

@{
    ViewData["Title"] = "Quản lý & Dọn dẹp Thẻ Tags";
    Layout = "_Layout";
    var totalTags = Model?.Count() ?? 0;
    var usedTags = Model?.Count(t => t.PostCount > 0) ?? 0;
    var unusedTags = Model?.Count(t => t.PostCount == 0) ?? 0;
}

<div class="p-6 space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-2.5">
                <span class="p-2 rounded-xl bg-purple-100 text-purple-700">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" /></svg>
                </span>
                <div>
                    <h1 class="text-2xl font-black text-gray-900 tracking-tight">Quản lý & Dọn dẹp Thẻ Tags</h1>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Mô hình <strong>Post-Moderation</strong> (Dùng luôn, dọn dẹp sau) dành cho <strong class="text-purple-700">QA Manager & Admin</strong>
                    </p>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Create" asp-controller="Tags"
               class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-sm transition-all active:scale-95">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Thêm tag chuẩn
            </a>
        </div>
    </div>

    <!-- Quick Stats Summary (Post-moderation insight) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wider">Tổng số thẻ Tags</p>
                <h3 class="text-2xl font-black text-gray-800 mt-1">@totalTags</h3>
            </div>
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center font-bold text-lg">
                🏷️
            </div>
        </div>

        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-medium text-emerald-600 uppercase tracking-wider">Đang gắn bài viết</p>
                <h3 class="text-2xl font-black text-emerald-700 mt-1">@usedTags</h3>
                <span class="text-[11px] text-gray-400">Được độc giả & tác giả sử dụng</span>
            </div>
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-lg">
                ✓
            </div>
        </div>

        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-xs flex items-center justify-between">
            <div>
                <p class="text-xs font-medium text-amber-600 uppercase tracking-wider">Tag rác / Chưa gắn bài</p>
                <h3 class="text-2xl font-black text-amber-700 mt-1">@unusedTags</h3>
                <span class="text-[11px] text-amber-600 font-semibold">Cần dọn dẹp hệ thống</span>
            </div>
            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-lg">
                ⚠️
            </div>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="bg-white rounded-2xl shadow-xs border border-gray-100 p-4 flex flex-col md:flex-row md:items-center justify-between gap-3">
        <!-- Quick Filter Tabs -->
        <div class="inline-flex p-1 bg-gray-100 rounded-xl gap-1 text-xs font-semibold text-gray-600">
            <button type="button" onclick="filterTags('all', this)" class="filter-tab active px-3.5 py-1.5 rounded-lg bg-white text-gray-900 shadow-xs transition-all">
                Tất cả (@totalTags)
            </button>
            <button type="button" onclick="filterTags('used', this)" class="filter-tab px-3.5 py-1.5 rounded-lg hover:text-gray-900 transition-all">
                Có bài viết (@usedTags)
            </button>
            <button type="button" onclick="filterTags('unused', this)" class="filter-tab px-3.5 py-1.5 rounded-lg hover:text-gray-900 transition-all text-amber-700">
                Chưa dùng (@unusedTags)
            </button>
        </div>

        <!-- Search Input -->
        <div class="relative flex-1 max-w-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11A6 6 0 1 1 5 11a6 6 0 0 1 12 0z" />
            </svg>
            <input type="text" id="searchInput" placeholder="Tìm kiếm tên tag..."
                   class="w-full pl-9 pr-4 py-2 text-xs border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent bg-gray-50/50 focus:bg-white transition-all" />
        </div>
    </div>

    <!-- Data Table -->
    <div class="bg-white rounded-2xl shadow-xs border border-gray-100 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-100" id="tagsTable">
            <thead class="bg-gray-50/80">
                <tr>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider w-12">#</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Tên Thẻ Tag</th>
                    <th class="px-6 py-3.5 text-center text-xs font-bold text-gray-500 uppercase tracking-wider">Số bài viết sử dụng</th>
                    <th class="px-6 py-3.5 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Đánh giá hệ thống</th>
                    <th class="px-6 py-3.5 text-right text-xs font-bold text-gray-500 uppercase tracking-wider">Hành động</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-50" id="tagsBody">
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var tag in Model)
                    {
                        var isUsed = tag.PostCount > 0;
                        <tr class="hover:bg-gray-50/75 transition-colors duration-100 tag-row" data-used="@(isUsed ? "true" : "false")">
                            <td class="px-6 py-4 text-xs font-medium text-gray-400">@index</td>
                            <td class="px-6 py-4">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-100 tag-name">
                                    <span class="opacity-60">#</span>@tag.Name
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (isUsed)
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                        @tag.PostCount bài viết
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500 border border-gray-200">
                                        0 bài (Chưa dùng)
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4">
                                @if (isUsed)
                                {
                                    <span class="text-xs text-gray-600 flex items-center gap-1">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                        Đang hoạt động ổn định
                                    </span>
                                }
                                else
                                {
                                    <span class="text-xs text-amber-600 font-semibold flex items-center gap-1" title="Tag không có bài viết nào, QA Manager có thể xóa để dọn dẹp hệ thống">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                        Tag mồ côi (Có thể dọn dẹp)
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    <a asp-action="Edit" asp-controller="Tags" asp-route-id="@tag.Id"
                                       title="Chỉnh sửa tên tag (Chuẩn hóa chính tả)"
                                       class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-blue-600 hover:bg-blue-50 transition-all">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-5m-1.414-9.414a2 2 0 1 1 2.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </a>
                                    <a asp-action="Delete" asp-controller="Tags" asp-route-id="@tag.Id"
                                       title="Xóa tag rác khỏi hệ thống"
                                       class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-red-500 hover:bg-red-50 transition-all">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="px-6 py-16 text-center">
                            <div class="flex flex-col items-center gap-3 text-gray-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 0 1 0 2.828l-7 7a2 2 0 0 1-2.828 0l-7-7A2 2 0 0 1 3 12V7a4 4 0 0 1 4-4z" />
                                </svg>
                                <p class="text-sm font-medium">Chưa có tag nào trong hệ thống</p>
                                <a asp-action="Create" asp-controller="Tags" class="text-blue-600 hover:underline text-xs font-bold">Thêm tag đầu tiên</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Footer Row Count -->
        @if (Model != null && Model.Any())
        {
            <div class="px-6 py-3 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
                <p class="text-xs text-gray-500" id="rowCount">
                    Hiển thị <span class="font-bold text-gray-700">@Model.Count()</span> thẻ tag
                </p>
            </div>
        }
    </div>

    <!-- Informational Note Banner -->
    <div class="p-4 rounded-2xl bg-gradient-to-r from-purple-50 to-blue-50 border border-purple-100 text-xs text-purple-900 leading-relaxed space-y-1">
        <h5 class="font-bold flex items-center gap-1.5 text-purple-950">
            <span>💡</span> Cơ chế Quản lý Post-moderation:
        </h5>
        <p>
            • <strong>Author / Người viết bài:</strong> Tự do gõ tag mới khi tạo bài viết mà không bị nghẽn tiến độ. Tag mới tự động lưu và đính kèm vào bài viết.
        </p>
        <p>
            • <strong>QA Coordinator:</strong> Khi duyệt bài viết sẽ kiểm tra tính phù hợp của các tag đi kèm. Nếu có tag vi phạm, Coordinator có thể gỡ bỏ ngay trước khi phê duyệt xuất bản.
        </p>
        <p>
            • <strong>QA Manager & Admin:</strong> Định kỳ truy cập màn hình này để dọn dẹp các tag rác (0 bài viết), sửa lỗi chính tả để hệ thống từ khóa luôn chuẩn xác và tinh gọn.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        const searchInput = document.getElementById('searchInput');
        const rows = document.querySelectorAll('.tag-row');
        const rowCountEl = document.getElementById('rowCount');
        let currentFilter = 'all';

        function filterTags(type, btn) {
            currentFilter = type;
            document.querySelectorAll('.filter-tab').forEach(b => {
                b.classList.remove('bg-white', 'text-gray-900', 'shadow-xs');
                b.classList.add('text-gray-600');
            });
            btn.classList.add('bg-white', 'text-gray-900', 'shadow-xs');
            btn.classList.remove('text-gray-600');
            applyFilters();
        }

        function applyFilters() {
            const query = searchInput.value.toLowerCase().trim();
            let visible = 0;
            rows.forEach(row => {
                const name = row.querySelector('.tag-name').textContent.toLowerCase();
                const isUsed = row.getAttribute('data-used') === 'true';

                let filterMatch = true;
                if (currentFilter === 'used') filterMatch = isUsed;
                else if (currentFilter === 'unused') filterMatch = !isUsed;

                const searchMatch = name.includes(query);
                const show = filterMatch && searchMatch;

                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });

            if (rowCountEl) {
                rowCountEl.innerHTML = `Hiển thị <span class="font-bold text-gray-700">${visible}</span> thẻ tag`;
            }
        }

        searchInput.addEventListener('input', applyFilters);
    </script>
}

