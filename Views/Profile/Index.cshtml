@model ContentManagementSystem.ViewModels.Auth.UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "_Layout";
    var activeTab = ViewBag.ActiveTab as string ?? "info";
    var passwordModel = ViewBag.ChangePasswordModel as ContentManagementSystem.ViewModels.Auth.ChangePasswordViewModel ?? new ContentManagementSystem.ViewModels.Auth.ChangePasswordViewModel();
    
    var displayName = !string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName : Model.Email;
    var currentAvatar = !string.IsNullOrEmpty(Model.Avatar) 
        ? Model.Avatar 
        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(displayName)}&background=2563eb&color=fff&bold=true";

    var primaryRole = Model.Roles.FirstOrDefault() ?? "Customer";
    string roleBadgeClass = primaryRole switch
    {
        "Admin" => "bg-rose-100 text-rose-700 border-rose-200",
        "QA Manager" => "bg-amber-100 text-amber-700 border-amber-200",
        "QA Coordinator" => "bg-purple-100 text-purple-700 border-purple-200",
        _ => "bg-emerald-100 text-emerald-700 border-emerald-200"
    };
}

<div class="space-y-6 max-w-6xl mx-auto">
    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-800 text-sm font-medium flex items-center gap-3 shadow-sm animate-fade-in">
            <div class="w-8 h-8 rounded-xl bg-emerald-500 text-white flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
                <p class="font-bold text-emerald-900">Thao tác thành công!</p>
                <p class="text-xs text-emerald-700 mt-0.5">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    }

    @if (TempData["PasswordErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl text-rose-800 text-sm font-medium flex items-center gap-3 shadow-sm animate-fade-in">
            <div class="w-8 h-8 rounded-xl bg-rose-500 text-white flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </div>
            <div>
                <p class="font-bold text-rose-900">Đã xảy ra lỗi!</p>
                <p class="text-xs text-rose-700 mt-0.5">@TempData["PasswordErrorMessage"]</p>
            </div>
        </div>
    }

    <!-- Profile Header Banner -->
    <div class="bg-white border border-gray-200/80 rounded-3xl shadow-sm">
        <!-- Cover Banner -->
        <div class="h-44 bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 rounded-t-3xl relative overflow-hidden">
            <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]"></div>
            <div class="absolute bottom-3 right-5 text-white/70 text-xs font-medium backdrop-blur-sm bg-black/20 px-3 py-1 rounded-full">
                ID: @Model.Id
            </div>
        </div>

        <!-- User Information Bar -->
        <div class="px-8 pb-6 pt-0 relative z-10">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 -mt-14 mb-4">
                <!-- Avatar with edit button -->
                <div class="relative group w-28 h-28 flex-shrink-0">
                    <img id="headerAvatarPreview" src="@currentAvatar" alt="@displayName" 
                         class="w-28 h-28 rounded-2xl object-cover ring-4 ring-white shadow-xl bg-white border border-gray-100" 
                         onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(displayName))&background=2563eb&color=fff&bold=true';" />
                    <button type="button" onclick="switchTab('info'); document.getElementById('avatarFileInput').click();" 
                            class="absolute -bottom-1 -right-1 p-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl shadow-md transition-transform group-hover:scale-110" 
                            title="Đổi ảnh đại diện">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                    </button>
                </div>

                <!-- Action buttons -->
                <div class="flex items-center gap-2.5">
                    <button type="button" onclick="switchTab('info')" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-sm transition-all flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                        Chỉnh sửa hồ sơ
                    </button>
                    <button type="button" onclick="switchTab('security')" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-xl transition-all flex items-center gap-1.5">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                        Đổi mật khẩu
                    </button>
                </div>
            </div>

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pt-2">
                <div>
                    <div class="flex items-center gap-3">
                        <h2 class="text-2xl font-black text-gray-900">@displayName</h2>
                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold border @roleBadgeClass">
                            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                            @primaryRole
                        </span>
                        @if (!string.IsNullOrEmpty(Model.DepartmentName))
                        {
                            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200 shadow-sm">
                                🏢 @Model.DepartmentName
                            </span>
                        }
                    </div>
                    <p class="text-xs text-gray-500 font-medium mt-1 flex items-center gap-2">
                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        @Model.Email
                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <span class="text-gray-300">•</span>
                            <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                            @Model.PhoneNumber
                        }
                    </p>
                </div>

                <!-- Stats pill -->
                <div class="flex items-center gap-6 border border-gray-100 bg-gray-50/75 rounded-2xl px-5 py-3 text-xs">
                    <div>
                        <span class="text-gray-400 block text-[10px] uppercase font-bold">Ngày tham gia</span>
                        <span class="font-semibold text-gray-800">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="w-px h-8 bg-gray-200"></div>
                    <div>
                        <span class="text-gray-400 block text-[10px] uppercase font-bold">Trạng thái</span>
                        <span class="text-emerald-600 font-bold flex items-center gap-1">
                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                            Hoạt động
                        </span>
                    </div>
                </div>
            </div>

            <!-- Tab Buttons -->
            <div class="flex items-center gap-2 border-t border-gray-100 mt-6 pt-4 text-xs font-bold">
                <button type="button" onclick="switchTab('info')" id="tabBtn-info" 
                        class="tab-btn px-4 py-2.5 rounded-xl transition-all flex items-center gap-2 @(activeTab == "info" ? "bg-blue-600 text-white shadow-sm" : "text-gray-600 hover:bg-gray-100")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    Thông tin tài khoản
                </button>
                <button type="button" onclick="switchTab('security')" id="tabBtn-security" 
                        class="tab-btn px-4 py-2.5 rounded-xl transition-all flex items-center gap-2 @(activeTab == "security" ? "bg-blue-600 text-white shadow-sm" : "text-gray-600 hover:bg-gray-100")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                    Bảo mật & Mật khẩu
                </button>
                <button type="button" onclick="switchTab('roles')" id="tabBtn-roles" 
                        class="tab-btn px-4 py-2.5 rounded-xl transition-all flex items-center gap-2 @(activeTab == "roles" ? "bg-blue-600 text-white shadow-sm" : "text-gray-600 hover:bg-gray-100")">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    Vai trò & Quyền hạn
                </button>
            </div>
        </div>
    </div>

    <!-- TAB 1: THÔNG TIN TÀI KHOẢN & AVATAR -->
    <div id="tab-info" class="tab-pane @(activeTab == "info" ? "" : "hidden")">
        <div class="bg-white border border-gray-200/80 rounded-3xl p-7 shadow-sm">
            <h3 class="text-base font-bold text-gray-900 mb-1">Chỉnh sửa hồ sơ cá nhân</h3>
            <p class="text-xs text-gray-500 mb-6">Cập nhật thông tin đại diện, số điện thoại và ảnh đại diện hiển thị trên toàn hệ thống.</p>

            <form asp-controller="Profile" asp-action="Update" method="post" enctype="multipart/form-data" class="space-y-6">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-xs font-medium" role="alert"></div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Left: Avatar Controls -->
                    <div class="p-5 bg-gradient-to-b from-gray-50 to-blue-50/20 border border-gray-200/70 rounded-2xl space-y-4 flex flex-col items-center text-center">
                        <span class="text-xs font-bold text-gray-700">Ảnh đại diện (Avatar)</span>
                        
                        <div class="relative w-28 h-28 rounded-2xl overflow-hidden ring-4 ring-blue-500/20 shadow-md bg-white">
                            <img id="formAvatarPreview" src="@currentAvatar" alt="Preview" class="w-full h-full object-cover" 
                                 onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(displayName))&background=2563eb&color=fff&bold=true';" />
                        </div>

                        <!-- Upload File Button -->
                        <div class="w-full">
                            <label class="block text-[11px] font-semibold text-gray-600 mb-1.5 text-left">Tải ảnh từ thiết bị:</label>
                            <input asp-for="AvatarFile" type="file" accept="image/*" id="avatarFileInput" 
                                   class="block w-full text-xs text-gray-600 file:mr-2.5 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer bg-white border border-gray-200 rounded-xl" />
                            <span asp-validation-for="AvatarFile" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        <!-- OR Separator -->
                        <div class="flex items-center gap-2 w-full">
                            <div class="h-px bg-gray-200 flex-1"></div>
                            <span class="text-[10px] uppercase font-bold text-gray-400">hoặc URL ảnh</span>
                            <div class="h-px bg-gray-200 flex-1"></div>
                        </div>

                        <!-- URL Input -->
                        <div class="w-full">
                            <input asp-for="Avatar" id="avatarUrlInput" 
                                   class="block w-full px-3.5 py-2 bg-white border border-gray-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" 
                                   placeholder="https://example.com/avatar.png" />
                            <span asp-validation-for="Avatar" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        <!-- Presets Selector -->
                        <div class="w-full text-left pt-2 border-t border-gray-200/60">
                            <span class="block text-[11px] font-semibold text-gray-500 mb-2">Bộ sưu tập avatar mẫu:</span>
                            <div class="grid grid-cols-4 gap-2">
                                <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/bottts/svg?seed=Admin')" class="w-full aspect-square rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Robot 1">
                                    <img src="https://api.dicebear.com/7.x/bottts/svg?seed=Admin" class="w-full h-full object-cover" />
                                </button>
                                <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/bottts/svg?seed=Cyber')" class="w-full aspect-square rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Robot 2">
                                    <img src="https://api.dicebear.com/7.x/bottts/svg?seed=Cyber" class="w-full h-full object-cover" />
                                </button>
                                <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/avataaars/svg?seed=Felix')" class="w-full aspect-square rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Felix">
                                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" class="w-full h-full object-cover" />
                                </button>
                                <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka')" class="w-full aspect-square rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Aneka">
                                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" class="w-full h-full object-cover" />
                                </button>
                                <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/notionists/svg?seed=Jack')" class="w-full aspect-square rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Jack">
                                    <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Jack" class="w-full h-full object-cover" />
                                </button>
                                <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/notionists/svg?seed=Chloe')" class="w-full aspect-square rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Chloe">
                                    <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Chloe" class="w-full h-full object-cover" />
                                </button>
                                <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/adventurer/svg?seed=Shadow')" class="w-full aspect-square rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Adventurer">
                                    <img src="https://api.dicebear.com/7.x/adventurer/svg?seed=Shadow" class="w-full h-full object-cover" />
                                </button>
                                <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/personas/svg?seed=Dev')" class="w-full aspect-square rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Persona">
                                    <img src="https://api.dicebear.com/7.x/personas/svg?seed=Dev" class="w-full h-full object-cover" />
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Right: Text Inputs -->
                    <div class="lg:col-span-2 space-y-4">
                        <div>
                            <label asp-for="Email" class="block text-xs font-semibold text-gray-700 mb-1.5">Địa chỉ Email (Định danh đăng nhập)</label>
                            <div class="relative">
                                <input asp-for="Email" class="block w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-500 cursor-not-allowed font-medium" readonly />
                                <span class="absolute right-3 top-2.5 text-xs text-gray-400">Không thể thay đổi</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.DepartmentName))
                        {
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1.5">Phòng ban / Đơn vị trực thuộc</label>
                                <div class="relative">
                                    <input type="text" value="@Model.DepartmentName" class="block w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-purple-700 font-semibold cursor-not-allowed" readonly />
                                    <span class="absolute right-3 top-2.5 text-xs text-purple-600 bg-purple-100 px-2.5 py-0.5 rounded-lg font-bold">🏢 @Model.DepartmentName</span>
                                </div>
                            </div>
                        }

                        <div>
                            <label asp-for="FullName" class="block text-xs font-semibold text-gray-700 mb-1.5">Họ và tên hiển thị <span class="text-rose-500">*</span></label>
                            <input asp-for="FullName" class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all font-medium" required placeholder="Nguyễn Văn A" />
                            <span asp-validation-for="FullName" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label asp-for="PhoneNumber" class="block text-xs font-semibold text-gray-700 mb-1.5">Số điện thoại liên hệ</label>
                            <input asp-for="PhoneNumber" class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="0901234567" />
                            <span asp-validation-for="PhoneNumber" class="text-xs text-rose-500 mt-1 block"></span>
                        </div>

                        <div class="pt-4 border-t border-gray-100 flex justify-end">
                            <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-500/20 transition-all flex items-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                Lưu thay đổi hồ sơ
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- TAB 2: BẢO MẬT & MẬT KHẨU -->
    <div id="tab-security" class="tab-pane @(activeTab == "security" ? "" : "hidden")">
        <div class="bg-white border border-gray-200/80 rounded-3xl p-7 shadow-sm">
            <h3 class="text-base font-bold text-gray-900 mb-1">Bảo mật tài khoản & Đổi mật khẩu</h3>
            <p class="text-xs text-gray-500 mb-6">Quản lý mật khẩu đăng nhập để bảo vệ an toàn cho tài khoản của bạn.</p>

            <div class="max-w-xl">
                <form asp-controller="Profile" asp-action="ChangePassword" method="post" class="space-y-4">
                    @Html.AntiForgeryToken()

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1.5">Mật khẩu hiện tại <span class="text-rose-500">*</span></label>
                        <input name="CurrentPassword" type="password" required class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="Nhập mật khẩu đang sử dụng" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1.5">Mật khẩu mới <span class="text-rose-500">*</span></label>
                        <input name="NewPassword" type="password" required class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="Tối thiểu 6 ký tự" />
                    </div>

                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1.5">Xác nhận mật khẩu mới <span class="text-rose-500">*</span></label>
                        <input name="ConfirmPassword" type="password" required class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="Nhập lại mật khẩu mới" />
                    </div>

                    <div class="pt-4 border-t border-gray-100 flex justify-end">
                        <button type="submit" class="px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-emerald-500/20 transition-all flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                            Cập nhật mật khẩu mới
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- TAB 3: VAI TRÒ & QUYỀN HẠN -->
    <div id="tab-roles" class="tab-pane @(activeTab == "roles" ? "" : "hidden")">
        <div class="bg-white border border-gray-200/80 rounded-3xl p-7 shadow-sm space-y-6">
            <div>
                <h3 class="text-base font-bold text-gray-900 mb-1">Vai trò & Quyền hạn hệ thống</h3>
                <p class="text-xs text-gray-500">Các đặc quyền và nhiệm vụ được phân bổ cho tài khoản của bạn trên CMS Portal.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-5 border border-gray-200/80 rounded-2xl bg-gray-50/50">
                    <span class="text-xs text-gray-400 font-bold uppercase tracking-wider block mb-2">Vai trò được cấp:</span>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var r in Model.Roles)
                        {
                            <span class="px-3 py-1 rounded-full text-xs font-bold border @roleBadgeClass">
                                @r
                            </span>
                        }
                    </div>
                </div>

                <div class="p-5 border border-gray-200/80 rounded-2xl bg-gray-50/50">
                    <span class="text-xs text-gray-400 font-bold uppercase tracking-wider block mb-2">Cấp độ truy cập:</span>
                    <p class="text-xs text-gray-700 font-medium">
                        @if (Model.Roles.Contains("Admin"))
                        {
                            <span>👑 <strong>Quản trị viên (Admin):</strong> Toàn quyền truy cập tất cả chức năng, quản lý người dùng, phân quyền vai trò, cấu hình hệ thống và phê duyệt bài viết.</span>
                        }
                        else if (Model.Roles.Contains("QA Manager"))
                        {
                            <span>🛡️ <strong>Trưởng ban QA (QA Manager):</strong> Phê duyệt bài viết, kiểm soát chất lượng nội dung, quản lý tiêu chuẩn xuất bản và báo cáo.</span>
                        }
                        else if (Model.Roles.Contains("QA Coordinator"))
                        {
                            <span>📋 <strong>Điều phối viên QA (QA Coordinator):</strong> Tiếp nhận, kiểm duyệt bài viết mới từ khách hàng và điều phối nội dung xuất bản.</span>
                        }
                        else
                        {
                            <span>👤 <strong>Khách hàng / Thành viên (Customer):</strong> Soạn thảo bài viết, gửi duyệt bài viết và quản lý hồ sơ thông tin cá nhân.</span>
                        }
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(tabId) {
            // Hide all tab panes
            document.querySelectorAll('.tab-pane').forEach(el => el.classList.add('hidden'));
            // Remove active classes on all tab buttons
            document.querySelectorAll('.tab-btn').forEach(el => {
                el.classList.remove('bg-blue-600', 'text-white', 'shadow-sm');
                el.classList.add('text-gray-600', 'hover:bg-gray-100');
            });

            // Show selected tab pane
            const selectedPane = document.getElementById('tab-' + tabId);
            if (selectedPane) {
                selectedPane.classList.remove('hidden');
            }

            // Highlight selected tab button
            const selectedBtn = document.getElementById('tabBtn-' + tabId);
            if (selectedBtn) {
                selectedBtn.classList.add('bg-blue-600', 'text-white', 'shadow-sm');
                selectedBtn.classList.remove('text-gray-600', 'hover:bg-gray-100');
            }
        }

        function selectPreset(url) {
            document.getElementById('avatarUrlInput').value = url;
            document.getElementById('formAvatarPreview').src = url;
            document.getElementById('headerAvatarPreview').src = url;
            document.getElementById('avatarFileInput').value = '';
        }

        const fileInput = document.getElementById('avatarFileInput');
        if (fileInput) {
            fileInput.addEventListener('change', function (e) {
                if (this.files && this.files[0]) {
                    const reader = new FileReader();
                    reader.onload = function (evt) {
                        document.getElementById('formAvatarPreview').src = evt.target.result;
                        document.getElementById('headerAvatarPreview').src = evt.target.result;
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });
        }

        const urlInput = document.getElementById('avatarUrlInput');
        if (urlInput) {
            urlInput.addEventListener('input', function (e) {
                if (this.value.trim().length > 0) {
                    document.getElementById('formAvatarPreview').src = this.value.trim();
                    document.getElementById('headerAvatarPreview').src = this.value.trim();
                }
            });
        }
    </script>
}

