                    gradientAmber.addColorStop(0, 'rgba(245, 158, 11, 0.25)');
                    gradientAmber.addColorStop(1, 'rgba(245, 158, 11, 0.0)');

                    new Chart(ctxCustTrend, {
                        type: 'line',
