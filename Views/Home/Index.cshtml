                // Admin Role Chart
                const ctxRole = document.getElementById('roleChart')?.getContext('2d');
                if (ctxRole) {
                    new Chart(ctxRole, {
                        type: 'bar',
                        data: {
                            labels: ['Admin', 'QA Manager', 'QA Coordinator', 'Customer'],
