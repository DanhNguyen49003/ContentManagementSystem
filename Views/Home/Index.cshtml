                const ctxCat = document.getElementById('categoryChart')?.getContext('2d');
                if (ctxCat) {
                    new Chart(ctxCat, {
                        type: 'doughnut',
                        data: {
                            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryNames)),
                            datasets: [{
