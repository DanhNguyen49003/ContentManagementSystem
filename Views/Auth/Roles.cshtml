@model IEnumerable<ContentManagementSystem.ViewModels.Auth.RoleManagementViewModel>
@{
    ViewData["Title"] = "Danh sách Vai trò Hệ thống";
    Layout = "_Layout";
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Danh sách Vai trò Hệ thống (Identity Roles)</h2>
            <p class="text-sm text-gray-500 mt-1">Cấu trúc phân quyền 4 vai trò trong hệ sinh thái CMS Portal (Admin, QA Manager, QA Coordinator, Customer)</p>
        </div>
        <a asp-controller="Auth" asp-action="Users" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-500/20 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            Quản lý người dùng
        </a>
    </div>

    <!-- Role Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var role in Model)
        {
            var (iconColor, badgeColor, roleIcon) = role.Name switch
            {
                "Admin" => ("bg-rose-50 text-rose-600 border-rose-100", "bg-rose-50 text-rose-700 border-rose-200", "👑"),
                "QA Manager" => ("bg-amber-50 text-amber-600 border-amber-100", "bg-amber-50 text-amber-700 border-amber-200", "🛡️"),
                "QA Coordinator" => ("bg-purple-50 text-purple-600 border-purple-100", "bg-purple-50 text-purple-700 border-purple-200", "📋"),
                "Customer" => ("bg-emerald-50 text-emerald-600 border-emerald-100", "bg-emerald-50 text-emerald-700 border-emerald-200", "👤"),
                _ => ("bg-slate-100 text-slate-600 border-slate-200", "bg-slate-100 text-slate-700 border-slate-200", "👤")
            };

            <div class="bg-white border border-gray-200/80 rounded-2xl p-6 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-2xl @iconColor border">
                            @roleIcon
                        </div>
                        <span class="inline-flex items-center text-xs font-bold px-2.5 py-1 rounded-full border @badgeColor">
                            @role.UserCount thành viên
                        </span>
                    </div>

                    <h3 class="text-lg font-bold text-gray-900">@role.Name</h3>
                    <p class="text-xs text-gray-500 mt-2 leading-relaxed">
                        @role.Description
                    </p>
                </div>

                <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
                    <span class="text-[11px] font-mono text-gray-400">@role.NormalizedName</span>
                    <a asp-controller="Auth" asp-action="Users" asp-route-role="@role.Name" class="text-xs font-bold text-blue-600 hover:text-blue-700 hover:underline inline-flex items-center gap-1">
                        Xem danh sách &rarr;
                    </a>
                </div>
            </div>
        }
    </div>
</div>

