@model ContentManagementSystem.ViewModels.Auth.UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "_Layout";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Hồ sơ cá nhân</h2>
            <p class="text-sm text-gray-500 mt-1">Quản lý thông tin định danh và bảo mật tài khoản của bạn</p>
        </div>
        <a asp-controller="Auth" asp-action="ChangePassword" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-xl shadow-sm transition-all">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" /></svg>
            Đổi mật khẩu
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-100 rounded-xl text-emerald-700 text-sm font-medium flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- User Overview Card -->
        <div class="bg-white border border-gray-200/80 rounded-2xl p-6 shadow-sm flex flex-col items-center text-center">
            @{
                var currentAvatar = !string.IsNullOrEmpty(Model.Avatar) 
                    ? Model.Avatar 
                    : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(Model.FullName ?? "User")}&background=2563eb&color=fff&bold=true";
            }
            <div class="relative w-24 h-24 rounded-full ring-4 ring-blue-500/20 shadow-lg mb-4 overflow-hidden bg-gray-100 flex items-center justify-center flex-shrink-0">
                <img id="avatarPreview" src="@currentAvatar" alt="Avatar" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(Model.FullName ?? "User"))&background=2563eb&color=fff&bold=true';" />
            </div>

            <h3 class="text-base font-bold text-gray-900">@Model.FullName</h3>
            <p class="text-xs text-gray-400 mt-0.5">@Model.Email</p>

            <div class="mt-4 flex flex-wrap gap-1.5 justify-center">
                @foreach (var r in Model.Roles)
                {
                    <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-blue-50 text-blue-700 border border-blue-100">
                        @r
                    </span>
                }
            </div>

            <div class="mt-6 pt-6 border-t border-gray-100 w-full text-left space-y-2 text-xs text-gray-500">
                <div class="flex justify-between">
                    <span class="text-gray-400">Mã định danh:</span>
                    <span class="font-mono text-gray-700 text-[11px] truncate max-w-[140px]" title="@Model.Id">@Model.Id</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-400">Ngày tham gia:</span>
                    <span class="text-gray-700 font-medium">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
            </div>
        </div>

        <!-- Update Information Form Card -->
        <div class="md:col-span-2 bg-white border border-gray-200/80 rounded-2xl p-6 shadow-sm">
            <h3 class="text-base font-bold text-gray-900 mb-5">Chỉnh sửa thông tin tài khoản</h3>

            <form asp-controller="Auth" asp-action="Profile" method="post" enctype="multipart/form-data" class="space-y-4">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-xs font-medium" role="alert"></div>

                <div>
                    <label asp-for="Email" class="block text-xs font-semibold text-gray-700 mb-1.5">Email tài khoản (không thể đổi)</label>
                    <input asp-for="Email" class="block w-full px-3.5 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm text-gray-500 cursor-not-allowed" readonly />
                </div>

                <div>
                    <label asp-for="FullName" class="block text-xs font-semibold text-gray-700 mb-1.5">Họ và tên</label>
                    <input asp-for="FullName" class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" required />
                    <span asp-validation-for="FullName" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="block text-xs font-semibold text-gray-700 mb-1.5">Số điện thoại</label>
                    <input asp-for="PhoneNumber" class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="0901234567" />
                    <span asp-validation-for="PhoneNumber" class="text-xs text-rose-500 mt-1 block"></span>
                </div>

                <!-- Avatar Section (Upload file / URL / Presets) -->
                <div class="p-4 bg-gray-50 border border-gray-200/80 rounded-2xl space-y-3">
                    <label class="block text-xs font-bold text-gray-800">Ảnh đại diện (Avatar)</label>

                    <!-- File Upload Option -->
                    <div>
                        <label class="block text-[11px] font-semibold text-gray-600 mb-1">Tải ảnh từ máy tính (.jpg, .png, .webp tối đa 5MB)</label>
                        <input asp-for="AvatarFile" type="file" accept="image/*" id="avatarFileInput" class="block w-full text-xs text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-blue-600 file:text-white hover:file:bg-blue-700 cursor-pointer bg-white border border-gray-200 rounded-xl" />
                        <span asp-validation-for="AvatarFile" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Separator -->
                    <div class="flex items-center gap-2">
                        <div class="h-px bg-gray-200 flex-1"></div>
                        <span class="text-[10px] uppercase font-bold text-gray-400">hoặc nhập đường dẫn URL ảnh</span>
                        <div class="h-px bg-gray-200 flex-1"></div>
                    </div>

                    <!-- URL Input Option -->
                    <div>
                        <input asp-for="Avatar" id="avatarUrlInput" class="block w-full px-3.5 py-2 bg-white border border-gray-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="https://example.com/avatar.png" />
                        <span asp-validation-for="Avatar" class="text-xs text-rose-500 mt-1 block"></span>
                    </div>

                    <!-- Quick Preset Avatars -->
                    <div>
                        <span class="block text-[11px] font-semibold text-gray-500 mb-1.5">Hoặc chọn nhanh avatar mẫu:</span>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/bottts/svg?seed=Admin')" class="w-9 h-9 rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Robot 1">
                                <img src="https://api.dicebear.com/7.x/bottts/svg?seed=Admin" class="w-full h-full object-cover" />
                            </button>
                            <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/bottts/svg?seed=Cyber')" class="w-9 h-9 rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Robot 2">
                                <img src="https://api.dicebear.com/7.x/bottts/svg?seed=Cyber" class="w-full h-full object-cover" />
                            </button>
                            <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/avataaars/svg?seed=Felix')" class="w-9 h-9 rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Felix">
                                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" class="w-full h-full object-cover" />
                            </button>
                            <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka')" class="w-9 h-9 rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Aneka">
                                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Aneka" class="w-full h-full object-cover" />
                            </button>
                            <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/notionists/svg?seed=Jack')" class="w-9 h-9 rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Notion Style 1">
                                <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Jack" class="w-full h-full object-cover" />
                            </button>
                            <button type="button" onclick="selectPreset('https://api.dicebear.com/7.x/notionists/svg?seed=Chloe')" class="w-9 h-9 rounded-xl border border-gray-200 overflow-hidden hover:ring-2 hover:ring-blue-500 transition-all bg-white p-0.5 shadow-sm" title="Notion Style 2">
                                <img src="https://api.dicebear.com/7.x/notionists/svg?seed=Chloe" class="w-full h-full object-cover" />
                            </button>
                        </div>
                    </div>
                </div>

                <div class="pt-4 border-t border-gray-100 flex justify-end">
                    <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-500/20 transition-all">
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectPreset(url) {
            document.getElementById('avatarUrlInput').value = url;
            document.getElementById('avatarPreview').src = url;
            document.getElementById('avatarFileInput').value = '';
        }

        document.getElementById('avatarFileInput').addEventListener('change', function (e) {
            if (this.files && this.files[0]) {
                const reader = new FileReader();
                reader.onload = function (evt) {
                    document.getElementById('avatarPreview').src = evt.target.result;
                };
                reader.readAsDataURL(this.files[0]);
            }
        });

        document.getElementById('avatarUrlInput').addEventListener('input', function (e) {
            if (this.value.trim().length > 0) {
                document.getElementById('avatarPreview').src = this.value.trim();
            }
        });
    </script>
}

