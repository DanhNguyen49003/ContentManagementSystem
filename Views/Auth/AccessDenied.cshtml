@{
    ViewData["Title"] = "Không có quyền truy cập";
    Layout = "_AuthLayout";
}

<div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-100 p-8 sm:p-10 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-rose-100 text-rose-600 mb-6">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
    </div>

    <h1 class="text-3xl font-black text-slate-800 tracking-tight mb-2">403 - Truy cập bị từ chối</h1>
    <p class="text-sm text-slate-500 mb-8 max-w-sm mx-auto">
        Tài khoản của bạn không có đủ quyền hạn để truy cập vào tài nguyên hoặc chức năng này. Vui lòng liên hệ Quản trị viên để được cấp quyền.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a asp-controller="Home" asp-action="Index" class="w-full sm:w-auto px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-500/30 transition-all">
            Về trang chủ Dashboard
        </a>
        <a asp-controller="Auth" asp-action="Logout" class="w-full sm:w-auto px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-all">
            Đăng nhập tài khoản khác
        </a>
    </div>
</div>

