@model IEnumerable<ContentManagementSystem.ViewModels.Auth.UserManagementViewModel>
@{
    ViewData["Title"] = "Quản lý Người dùng & Phân quyền";
    Layout = "_Layout";
    var allRoles = ViewBag.AllRoles as string[] ?? Array.Empty<string>();
    var selectedRole = ViewBag.SelectedRole as string;
    var search = ViewBag.Search as string;
    var departments = ViewBag.Departments as IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.DepartmentDto> ?? Enumerable.Empty<ContentManagementSystem.ApplicationCore.DTOs.DepartmentDto>();
    var selectedDept = ViewBag.SelectedDepartmentId as string;
}

<div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Quản lý Người dùng & Phân quyền</h2>
            <p class="text-sm text-gray-500 mt-1">Danh sách tài khoản, vai trò và phân bổ phòng ban trực thuộc</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Departments" asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-xl shadow-sm transition-all">
                <span>🏢</span> Quản lý Phòng ban
            </a>
            <a asp-controller="Auth" asp-action="Roles" class="inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-200 hover:bg-gray-50 text-gray-700 text-xs font-semibold rounded-xl shadow-sm transition-all">
                <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                Xem vai trò
            </a>
            <a asp-controller="Auth" asp-action="Register" class="inline-flex items-center gap-2 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-500/20 transition-all">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Thêm người dùng
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-emerald-50 border border-emerald-100 rounded-xl text-emerald-700 text-sm font-medium flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 bg-rose-50 border border-rose-100 rounded-xl text-rose-700 text-sm font-medium flex items-center gap-2">
            <svg class="w-5 h-5 text-rose-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Filter & Search Bar -->
    <div class="bg-white border border-gray-200/80 rounded-2xl p-4 shadow-sm">
        <form asp-controller="Auth" asp-action="Users" method="get" class="flex flex-col sm:flex-row items-center gap-3">
            <div class="relative flex-1 w-full">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-gray-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                </div>
                <input type="text" name="search" value="@search" placeholder="Tìm theo email hoặc họ tên..." class="w-full pl-9 pr-4 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:bg-white focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" />
            </div>

            <div class="w-full sm:w-44">
                <select name="role" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:bg-white focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all">
                    <option value="">-- Tất cả vai trò --</option>
                    @foreach (var r in allRoles)
                    {
                        if (r == selectedRole)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>

            <div class="w-full sm:w-52">
                <select name="departmentId" class="w-full px-3 py-2 bg-gray-50 border border-gray-200 rounded-xl text-xs focus:bg-white focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all">
                    <option value="">-- Tất cả phòng ban --</option>
                    <option value="admin" selected="@(selectedDept == "admin")">⚡ Toàn quyền (Admin)</option>
                    <option value="none" selected="@(selectedDept == "none")">Chưa gán phòng ban</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id" selected="@(selectedDept == d.Id.ToString())">🏢 @d.Name</option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-2 w-full sm:w-auto">
                <button type="submit" class="w-full sm:w-auto px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-xl transition-all shadow-sm">
                    Lọc
                </button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(selectedRole) || !string.IsNullOrEmpty(selectedDept))
                {
                    <a asp-controller="Auth" asp-action="Users" class="w-full sm:w-auto px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-600 text-xs font-semibold rounded-xl text-center transition-all">
                        Xóa lọc
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Data Table -->
    <div class="bg-white border border-gray-200/80 rounded-2xl shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50/75 border-b border-gray-200 text-[11px] font-bold text-gray-500 uppercase tracking-wider">
                        <th class="py-3.5 px-5">Người dùng</th>
                        <th class="py-3.5 px-4">Vai trò (Role)</th>
                        <th class="py-3.5 px-4">Phòng ban</th>
                        <th class="py-3.5 px-4">Trạng thái</th>
                        <th class="py-3.5 px-4">Ngày tạo</th>
                        <th class="py-3.5 px-5 text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-xs text-gray-700">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="py-10 text-center text-gray-400">
                                Không tìm thấy người dùng nào phù hợp.
                            </td>
                        </tr>
                    }
                    @foreach (var u in Model)
                    {
                        <tr class="hover:bg-gray-50/50 transition-colors">
                            <td class="py-3.5 px-5">
                                <div class="flex items-center gap-3">
                                    @{
                                        var uAvatar = !string.IsNullOrEmpty(u.Avatar) 
                                            ? u.Avatar 
                                            : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(u.FullName ?? u.Email)}&background=2563eb&color=fff&bold=true";
                                    }
                                    <img src="@uAvatar" alt="@u.Email" class="w-9 h-9 rounded-full object-cover border border-gray-200 shadow-sm flex-shrink-0 bg-gray-100" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(u.FullName ?? u.Email))&background=2563eb&color=fff&bold=true';" />
                                    <div class="min-w-0">
                                        <p class="font-bold text-gray-900 truncate">@(string.IsNullOrEmpty(u.FullName) ? "Chưa đặt tên" : u.FullName)</p>
                                        <p class="text-gray-400 text-[11px] truncate">@u.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var r in u.Roles)
                                    {
                                        var badgeColor = r switch
                                        {
                                            "Admin" => "bg-rose-50 text-rose-700 border-rose-200",
                                            "QA Manager" => "bg-indigo-50 text-indigo-700 border-indigo-200",
                                            "QA Coordinator" => "bg-sky-50 text-sky-700 border-sky-200",
                                            "Customer" => "bg-emerald-50 text-emerald-700 border-emerald-200",
                                            _ => "bg-slate-100 text-slate-700 border-slate-200"
                                        };
                                        <span class="inline-flex items-center text-[10px] font-bold px-2 py-0.5 rounded-md border @badgeColor">
                                            @r
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="py-3.5 px-4">
                                @if (u.Roles.Contains("Admin"))
                                {
                                    <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2.5 py-1 rounded-md border bg-rose-50 text-rose-700 border-rose-200 shadow-sm" title="Quản trị viên có toàn quyền truy cập tất cả phòng ban, không cần gán phòng ban">
                                        <svg class="w-3 h-3 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                                        Toàn quyền (Tất cả PB)
                                    </span>
                                }
                                else
                                {
                                    <div class="flex items-center gap-2">
                                        @if (!string.IsNullOrEmpty(u.DepartmentName))
                                        {
                                            <span class="inline-flex items-center text-[10px] font-bold px-2 py-0.5 rounded-md border bg-purple-50 text-purple-700 border-purple-200">
                                                🏢 @u.DepartmentName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-400 italic text-[11px]">Chưa gán</span>
                                        }

                                        @if (User.IsInRole("Admin"))
                                        {
                                            <button type="button" onclick="openDeptModal('@u.Id', '@(Uri.EscapeDataString(u.FullName ?? u.Email))', '@(u.DepartmentId?.ToString() ?? "")')" class="text-[10px] text-blue-600 hover:text-blue-800 font-semibold underline hover:bg-blue-50 px-1 py-0.5 rounded transition-colors" title="Chỉnh sửa phòng ban cho người này">
                                                Đổi PB
                                            </button>
                                        }
                                    </div>
                                }
                            </td>
                            <td class="py-3.5 px-4">
                                <div class="flex flex-col gap-1 items-start">
                                    @if (u.IsLockedOut)
                                    {
                                        <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-rose-700 bg-rose-50 px-2 py-0.5 rounded-full">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
                                            Đã bị khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
                                            Hoạt động
                                        </span>
                                    }

                                    @if (u.EmailConfirmed)
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] font-medium text-emerald-600">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                            Đã xác thực mail
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-600">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                                            Chưa xác thực mail
                                        </span>
                                    }
                                </div>
                            </td>
                            <td class="py-3.5 px-4 text-gray-500 text-[11px]">
                                @u.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="py-3.5 px-5 text-right">
                                <div class="flex items-center justify-end gap-1.5">
                                    @if (!u.EmailConfirmed)
                                    {
                                        <!-- Kích hoạt Email thủ công -->
                                        <form asp-controller="Auth" asp-action="ConfirmUserEmail" asp-route-id="@u.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-2.5 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-semibold rounded-lg transition-colors text-[11px]" title="Kích hoạt email cho tài khoản này">
                                                Kích hoạt mail
                                            </button>
                                        </form>
                                    }

                                    <!-- Phân quyền & Phòng ban -->
                                    <a asp-controller="Auth" asp-action="AssignRole" asp-route-id="@u.Id" class="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold rounded-lg transition-colors text-[11px]" title="Đổi vai trò & phòng ban">
                                        Phân quyền
                                    </a>

                                    <!-- Khóa / Mở khóa -->
                                    <form asp-controller="Auth" asp-action="ToggleLock" asp-route-id="@u.Id" method="post" class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="px-2.5 py-1.5 @(u.IsLockedOut ? "bg-emerald-50 hover:bg-emerald-100 text-emerald-700" : "bg-amber-50 hover:bg-amber-100 text-amber-700") font-semibold rounded-lg transition-colors text-[11px]" title="@(u.IsLockedOut ? "Mở khóa tài khoản" : "Khóa tài khoản")">
                                            @(u.IsLockedOut ? "Mở khóa" : "Khóa")
                                        </button>
                                    </form>

                                    <!-- Xóa -->
                                    <form asp-controller="Auth" asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa người dùng này khỏi hệ thống?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="p-1.5 text-gray-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Xóa người dùng">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Đổi phòng ban nhanh dành cho Admin -->
<div id="deptModal" class="fixed inset-0 z-50 bg-black/40 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 space-y-4 border border-gray-100">
        <div class="flex items-center justify-between pb-3 border-b border-gray-100">
            <h3 class="text-base font-bold text-gray-900 flex items-center gap-2">
                <span>🏢</span> Phân bổ Phòng ban cho Thành viên
            </h3>
            <button type="button" onclick="closeDeptModal()" class="text-gray-400 hover:text-gray-600 p-1 rounded-lg">
                ✕
            </button>
        </div>
        <form asp-controller="Auth" asp-action="UpdateDepartment" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="userId" id="modalUserId" />
            <div class="p-3 bg-gray-50 rounded-xl">
                <p class="text-[11px] text-gray-500">Đang điều chỉnh phòng ban cho tài khoản:</p>
                <p class="text-xs font-bold text-gray-800 mt-0.5" id="modalUserName"></p>
            </div>
            <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-2">Chọn Phòng ban / Khoa</label>
                <select name="departmentId" id="modalDeptSelect" class="w-full px-3 py-2.5 bg-white border border-gray-200 rounded-xl text-xs font-semibold focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all">
                    <option value="">-- Chưa gán phòng ban (Chung) --</option>
                    @foreach (var d in departments)
                    {
                        <option value="@d.Id">🏢 @d.Name</option>
                    }
                </select>
                <p class="text-[11px] text-gray-400 mt-2 leading-relaxed">
                    * Quyền hạn duyệt bài của <strong>QA Coordinator</strong> sẽ giới hạn trong phòng ban được chọn tại đây.
                </p>
            </div>
            <div class="flex items-center justify-end gap-2 pt-3 border-t border-gray-100">
                <button type="button" onclick="closeDeptModal()" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-semibold rounded-xl transition-all">
                    Hủy
                </button>
                <button type="submit" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-md shadow-blue-500/20 transition-all">
                    Lưu phân bổ
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openDeptModal(userId, userName, currentDeptId) {
        document.getElementById('modalUserId').value = userId;
        document.getElementById('modalUserName').textContent = decodeURIComponent(userName);
        document.getElementById('modalDeptSelect').value = currentDeptId;
        document.getElementById('deptModal').classList.remove('hidden');
    }
    function closeDeptModal() {
        document.getElementById('deptModal').classList.add('hidden');
    }
</script>

