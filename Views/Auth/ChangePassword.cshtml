@model ContentManagementSystem.ViewModels.Auth.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = "_Layout";
}

<div class="max-w-xl mx-auto space-y-6">
    <!-- Breadcrumb & Header -->
    <div>
        <h2 class="text-2xl font-bold text-gray-900 tracking-tight">Đổi mật khẩu</h2>
        <p class="text-sm text-gray-500 mt-1">Cập nhật mật khẩu định kỳ để tăng cường an toàn cho tài khoản</p>
    </div>

    <div class="bg-white border border-gray-200/80 rounded-2xl p-6 shadow-sm">
        <form asp-controller="Auth" asp-action="ChangePassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-xs font-medium" role="alert"></div>

            <div>
                <label asp-for="CurrentPassword" class="block text-xs font-semibold text-gray-700 mb-1.5">Mật khẩu hiện tại</label>
                <input asp-for="CurrentPassword" type="password" class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="••••••••" required />
                <span asp-validation-for="CurrentPassword" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-xs font-semibold text-gray-700 mb-1.5">Mật khẩu mới</label>
                <input asp-for="NewPassword" type="password" class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="••••••••" required />
                <span asp-validation-for="NewPassword" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-gray-700 mb-1.5">Xác nhận mật khẩu mới</label>
                <input asp-for="ConfirmPassword" type="password" class="block w-full px-3.5 py-2.5 bg-white border border-gray-200 rounded-xl text-sm focus:ring-2 focus:ring-blue-600 focus:border-transparent transition-all" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                <a asp-controller="Auth" asp-action="Profile" class="text-xs font-semibold text-gray-500 hover:text-gray-800 transition-colors">
                    &larr; Quay lại Hồ sơ
                </a>
                <button type="submit" class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold rounded-xl shadow-lg shadow-blue-500/20 transition-all">
                    Đổi mật khẩu
                </button>
            </div>
        </form>
    </div>
</div>

