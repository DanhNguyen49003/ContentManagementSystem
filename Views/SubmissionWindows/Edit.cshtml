@model ContentManagementSystem.ApplicationCore.DTOs.SubmissionWindowDto
@{
    ViewData["Title"] = "Chỉnh sửa đợt nộp bài";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div>
        <nav class="text-xs text-gray-500 flex items-center gap-2 mb-2">
            <a asp-action="Index" class="hover:text-blue-600">Đợt nộp bài</a>
            <span>/</span>
            <span class="text-gray-800 font-semibold">Chỉnh sửa</span>
        </nav>
        <h1 class="text-2xl font-black text-gray-900 tracking-tight flex items-center gap-2">
            ✏️ Chỉnh sửa đợt nộp bài
        </h1>
        <p class="text-sm text-gray-500 mt-1 font-medium">@Model.Name</p>
    </div>

    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 sm:p-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="p-3 bg-red-50 border border-red-200 rounded-xl text-sm text-red-700 font-medium"></div>

            <div class="space-y-1.5">
                <label asp-for="Name" class="block text-sm font-bold text-gray-700">Tên đợt nộp bài <span class="text-red-500">*</span></label>
                <input asp-for="Name" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-blue-400 focus:ring-2 focus:ring-blue-100 outline-none text-sm transition-all" />
                <span asp-validation-for="Name" class="text-xs text-red-600"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="space-y-1.5">
                    <label asp-for="StartDate" class="block text-sm font-bold text-gray-700">Ngày bắt đầu <span class="text-red-500">*</span></label>
                    <input asp-for="StartDate" type="datetime-local" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-blue-400 focus:ring-2 focus:ring-blue-100 outline-none text-sm transition-all" />
                    <span asp-validation-for="StartDate" class="text-xs text-red-600"></span>
                </div>
                <div class="space-y-1.5">
                    <label asp-for="ClosureDate" class="block text-sm font-bold text-gray-700">Hạn nộp bài <span class="text-red-500">*</span></label>
                    <input asp-for="ClosureDate" type="datetime-local" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-amber-400 focus:ring-2 focus:ring-amber-100 outline-none text-sm transition-all" />
                    <span asp-validation-for="ClosureDate" class="text-xs text-red-600"></span>
                    <p class="text-[11px] text-amber-600">Sau ngày này tác giả không thể nộp bài mới.</p>
                </div>
                <div class="space-y-1.5">
                    <label asp-for="FinalClosureDate" class="block text-sm font-bold text-gray-700">Hạn cuối cùng <span class="text-red-500">*</span></label>
                    <input asp-for="FinalClosureDate" type="datetime-local" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-red-400 focus:ring-2 focus:ring-red-100 outline-none text-sm transition-all" />
                    <span asp-validation-for="FinalClosureDate" class="text-xs text-red-600"></span>
                    <p class="text-[11px] text-red-600">Sau ngày này toàn bộ tương tác bị đóng.</p>
                </div>
            </div>

            <div class="flex items-center gap-3 p-4 bg-blue-50 rounded-xl border border-blue-100">
                <input asp-for="IsActive" type="checkbox" class="w-4 h-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                <label asp-for="IsActive" class="text-sm font-bold text-blue-800">Kích hoạt đợt nộp bài này</label>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <a asp-action="Index" class="px-5 py-2.5 text-sm font-bold text-gray-700 hover:bg-gray-100 rounded-xl border border-gray-200 transition-all">Hủy</a>
                <button type="submit" class="px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold rounded-xl shadow-sm shadow-blue-200 transition-all active:scale-95">
                    <svg class="w-4 h-4 inline-block mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Lưu thay đổi
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
