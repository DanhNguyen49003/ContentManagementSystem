@model IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.BannerDto>

@{
    ViewData["Title"] = "Quản lý Banners";
    Layout = "_Layout";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Quản lý Banner</h2>
            <p class="text-sm text-gray-500 mt-1">Ảnh bìa, slider và các banner quảng cáo trên website.</p>
        </div>
        <a asp-action="Create" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition-all">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Thêm banner mới
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-5 border-b border-gray-100 flex justify-between items-center">
            <span class="text-sm text-gray-500">Tổng số: <strong class="text-gray-800 font-semibold">@(Model?.Count() ?? 0)</strong> banner</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50/75 text-gray-500 text-xs uppercase tracking-wider">
                        <th class="px-6 py-3.5 font-semibold">Hình ảnh</th>
                        <th class="px-6 py-3.5 font-semibold">Tiêu đề</th>
                        <th class="px-6 py-3.5 font-semibold">Đường dẫn liên kết</th>
                        <th class="px-6 py-3.5 font-semibold">Trạng thái</th>
                        <th class="px-6 py-3.5 font-semibold text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50/75 transition-colors">
                                <td class="px-6 py-4">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Title" class="w-20 h-12 object-cover rounded-lg border border-gray-100 shadow-sm" onerror="this.src='https://via.placeholder.com/80x48?text=Banner'" />
                                    }
                                    else
                                    {
                                        <div class="w-20 h-12 bg-gray-100 rounded-lg flex items-center justify-center text-gray-400 text-xs">No image</div>
                                    }
                                </td>
                                <td class="px-6 py-4 font-semibold text-gray-800">
                                    @item.Title
                                </td>
                                <td class="px-6 py-4 text-gray-500 text-xs max-w-xs truncate">
                                    <a href="@item.LinkUrl" target="_blank" class="text-blue-600 hover:underline">@item.LinkUrl</a>
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-green-50 text-green-700 rounded-full text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 bg-gray-100 text-gray-500 rounded-full text-xs font-medium">
                                            Ẩn
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="p-1.5 text-gray-400 hover:text-indigo-600 rounded-lg hover:bg-indigo-50 transition-all" title="Chỉnh sửa">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 text-gray-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-all" title="Xóa">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-12 text-gray-400">Chưa có banner nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

