@model ContentManagementSystem.ApplicationCore.DTOs.MenuItemDto

@{
    ViewData["Title"] = "Chỉnh sửa liên kết Menu";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chỉnh sửa liên kết Menu</h2>
        </div>
        <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
            &larr; Quay lại
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <form asp-action="Edit" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="p-4 bg-rose-50 border border-rose-100 rounded-xl text-rose-600 text-sm"></div>

            <div>
                <label asp-for="Title" class="block text-sm font-semibold text-gray-700 mb-1">Tiêu đề liên kết <span class="text-rose-500">*</span></label>
                <input asp-for="Title" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" required />
                <span asp-validation-for="Title" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Url" class="block text-sm font-semibold text-gray-700 mb-1">Đường dẫn liên kết (URL) <span class="text-rose-500">*</span></label>
                <input asp-for="Url" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" required />
                <span asp-validation-for="Url" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="MenuId" class="block text-sm font-semibold text-gray-700 mb-1">Thuộc Menu <span class="text-rose-500">*</span></label>
                <select asp-for="MenuId" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent bg-white" asp-items="ViewBag.MenuId" required></select>
                <span asp-validation-for="MenuId" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div class="pt-4 border-t border-gray-100 flex items-center justify-end gap-3">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 text-sm font-medium transition-all">Hủy bỏ</a>
                <button type="submit" class="px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Cập nhật
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

