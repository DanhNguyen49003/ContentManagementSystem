@model ContentManagementSystem.ApplicationCore.DTOs.MenuItemDto

@{
    ViewData["Title"] = "Chi tiết liên kết Menu";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Chi tiết liên kết Menu</h2>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" class="text-sm font-medium text-gray-600 hover:text-gray-900 bg-white px-4 py-2 rounded-xl border border-gray-200 shadow-sm transition-all">
                &larr; Quay lại
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="inline-flex items-center gap-1.5 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-xl shadow-sm transition-all">
                Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 space-y-4">
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Tiêu đề:</span>
            <p class="text-xl font-bold text-gray-900">@Model.Title</p>
        </div>
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Đường dẫn (URL):</span>
            <code class="text-sm bg-gray-100 px-2.5 py-1 rounded text-blue-600">@Model.Url</code>
        </div>
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-gray-400 block mb-1">Menu ID:</span>
            <p class="text-xs text-gray-500 font-mono">@Model.MenuId</p>
        </div>
    </div>
</div>

