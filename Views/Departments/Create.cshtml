@model ContentManagementSystem.ApplicationCore.DTOs.DepartmentDto

@{
    ViewData["Title"] = "Thêm Phòng ban mới";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Thêm Phòng ban mới</h2>
            <p class="text-sm text-gray-500 mt-1">Khởi tạo đơn vị phòng ban hoặc khoa trực thuộc hệ thống.</p>
        </div>
        <a asp-action="Index" class="text-sm text-gray-500 hover:text-gray-700 font-semibold flex items-center gap-1">
            &larr; Quay lại
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
        <form asp-action="Create" method="post" class="space-y-5">
            @Html.AntiForgeryToken()

            <div>
                <label asp-for="Name" class="block text-sm font-semibold text-gray-700 mb-1">Tên phòng ban / Khoa <span class="text-rose-500">*</span></label>
                <input asp-for="Name" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="Ví dụ: Khoa Công nghệ thông tin" required />
                <span asp-validation-for="Name" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Description" class="block text-sm font-semibold text-gray-700 mb-1">Mô tả chi tiết</label>
                <textarea asp-for="Description" rows="4" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all" placeholder="Mô tả chức năng, nhiệm vụ của phòng ban..."></textarea>
                <span asp-validation-for="Description" class="text-xs text-rose-500 mt-1 block"></span>
            </div>

            <div class="pt-4 flex items-center justify-end gap-3 border-t border-gray-100">
                <a asp-action="Index" class="px-5 py-2.5 rounded-xl border border-gray-200 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition-all">
                    Hủy bỏ
                </a>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all">
                    Lưu phòng ban
                </button>
            </div>
        </form>
    </div>
</div>

