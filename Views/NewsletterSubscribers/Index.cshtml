@model IEnumerable<ContentManagementSystem.ApplicationCore.DTOs.NewsletterSubscriberDto>

@{
    ViewData["Title"] = "Quản lý Đăng ký nhận tin";
    Layout = "_Layout";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h2 class="text-2xl font-bold text-gray-800">Đăng ký nhận tin (Newsletter)</h2>
            <p class="text-sm text-gray-500 mt-1">Danh sách địa chỉ email đăng ký nhận bản tin marketing.</p>
        </div>
    </div>

    <!-- Add Subscriber Box -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
        <form asp-action="Subscribe" method="post" class="flex flex-col sm:flex-row items-center gap-3">
            @Html.AntiForgeryToken()
            <div class="relative flex-1 w-full">
                <input type="email" name="email" placeholder="Nhập địa chỉ email cần thêm vào danh sách..." required
                       class="w-full px-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" />
            </div>
            <button type="submit" class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all flex items-center justify-center gap-2 whitespace-nowrap">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Thêm Email
            </button>
        </form>
    </div>

    <!-- Table Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="p-5 border-b border-gray-100 flex justify-between items-center">
            <span class="text-sm text-gray-500">Tổng cộng: <strong class="text-gray-800 font-semibold">@(Model?.Count() ?? 0)</strong> email đăng ký</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50/75 text-gray-500 text-xs uppercase tracking-wider">
                        <th class="px-6 py-3.5 font-semibold">Email</th>
                        <th class="px-6 py-3.5 font-semibold">Trạng thái</th>
                        <th class="px-6 py-3.5 font-semibold">Ngày đăng ký</th>
                        <th class="px-6 py-3.5 font-semibold text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 text-sm">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="hover:bg-gray-50/75 transition-colors">
                                <td class="px-6 py-4 font-semibold text-gray-800">
                                    @item.Email
                                </td>
                                <td class="px-6 py-4">
                                    @if (item.IsActive)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-green-50 text-green-700 rounded-full text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                                            Đang theo dõi
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-gray-100 text-gray-500 rounded-full text-xs font-medium">
                                            Đã hủy đăng ký
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-gray-400 text-xs">
                                    @item.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="inline-flex items-center gap-2">
                                        @if (item.IsActive)
                                        {
                                            <form asp-action="Unsubscribe" asp-route-id="@item.Id" method="post" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="px-2.5 py-1 text-xs font-medium text-amber-700 bg-amber-50 hover:bg-amber-100 rounded-lg transition-all" title="Hủy đăng ký">
                                                    Hủy theo dõi
                                                </button>
                                            </form>
                                        }
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="p-1.5 text-gray-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-all" title="Xóa">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-12 text-gray-400">Chưa có người đăng ký nhận tin nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

