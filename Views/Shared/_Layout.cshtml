@using Microsoft.AspNetCore.Identity
@using ContentManagementSystem.ApplicationCore.Entities.Identity
@inject SignInManager<ContentUser> SignInManager
@inject UserManager<ContentUser> UserManager

@{
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isAdmin = User.IsInRole("Admin");
    var isQAManager = User.IsInRole("QA Manager");
    var isQACoordinator = User.IsInRole("QA Coordinator");
    var isCustomer = User.IsInRole("Customer");

    ContentUser? currentUser = null;
    string displayName = User.Identity?.Name ?? "User";
    string userAvatar = "";
    string roleName = "Khách";
    string roleBadgeClass = "bg-gray-100 text-gray-700";

    if (isSignedIn)
    {
        currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null)
        {
            displayName = !string.IsNullOrWhiteSpace(currentUser.FullName) 
                ? currentUser.FullName 
                : (!string.IsNullOrWhiteSpace(currentUser.UserName) ? currentUser.UserName : (currentUser.Email ?? "User"));
            userAvatar = currentUser.Avatar ?? "";

            var userRoles = await UserManager.GetRolesAsync(currentUser);
            if (userRoles.Contains("Admin", StringComparer.OrdinalIgnoreCase) || currentUser.Email?.Equals("admin@cms.com", StringComparison.OrdinalIgnoreCase) == true)
            {
                isAdmin = true;
            }
            if (userRoles.Contains("QA Manager", StringComparer.OrdinalIgnoreCase))
            {
                isQAManager = true;
            }
            if (userRoles.Contains("QA Coordinator", StringComparer.OrdinalIgnoreCase))
            {
                isQACoordinator = true;
            }
            if (userRoles.Contains("Customer", StringComparer.OrdinalIgnoreCase))
            {
                isCustomer = true;
            }
        }
    }

    if (string.IsNullOrEmpty(userAvatar))
    {
        userAvatar = $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(displayName)}&background=2563eb&color=fff&bold=true";
    }

    if (isAdmin) { roleName = "Admin"; roleBadgeClass = "bg-rose-100 text-rose-700"; }
    else if (isQAManager) { roleName = "QA Manager"; roleBadgeClass = "bg-amber-100 text-amber-700"; }
    else if (isQACoordinator) { roleName = "QA Coordinator"; roleBadgeClass = "bg-purple-100 text-purple-700"; }
    else if (isCustomer) { roleName = "Customer"; roleBadgeClass = "bg-emerald-100 text-emerald-700"; }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMS Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/ContentManagementSystem.styles.css" asp-append-version="true" />
    <style>
        .sidebar-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 1rem; border-radius: 0.5rem; color: #4b5563; font-size: 0.875rem; font-weight: 500; transition: all 0.15s ease-in-out; }
        .sidebar-link:hover { background-color: #eff6ff; color: #1d4ed8; }
        .sidebar-link.active { background-color: #2563eb; color: #ffffff; }
        .sidebar-link.active:hover { background-color: #1d4ed8; color: #ffffff; }
        .sidebar-group-label { font-size: 0.75rem; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em; padding: 0 1rem; margin-top: 1.5rem; margin-bottom: 0.5rem; }
        /* Custom scrollbar cho sidebar */
        nav::-webkit-scrollbar { width: 5px; }
        nav::-webkit-scrollbar-track { background: transparent; }
        nav::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        nav::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex">

    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col h-screen fixed top-0 left-0 z-30">
        <!-- Logo -->
        <div class="flex items-center gap-3 px-6 py-5 border-b border-gray-100 flex-shrink-0">
            <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center shadow-sm">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
            </div>
            <div>
                <span class="font-bold text-gray-900 text-lg leading-none block">CMS Portal</span>
                <span class="text-[10px] text-gray-400 font-medium mt-0.5 block uppercase tracking-wider">Hệ thống quản trị</span>
            </div>
        </div>

        <!-- Navigation Menu with Role Visibility (Scrollable) -->
        <nav class="flex-1 px-3 py-4 overflow-y-auto min-h-0">
            <!-- Tổng quan -->
            <p class="sidebar-group-label">Tổng quan</p>
            <a asp-controller="Home" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                Dashboard
            </a>
            @if (isSignedIn)
            {
                <a asp-controller="Profile" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    Hồ sơ cá nhân
                </a>
            }

            <!-- Quản trị Hệ thống & Phân quyền: Chỉ hiển thị cho Admin và QA Manager -->
            @if (isAdmin || isQAManager)
            {
                <p class="sidebar-group-label">Hệ thống & Phân quyền</p>
                <a asp-controller="Auth" asp-action="Users" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Auth" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                    <span>Quản lý Người dùng</span>
                </a>
                <a asp-controller="Auth" asp-action="Roles" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Auth" && ViewContext.RouteData.Values["action"]?.ToString() == "Roles" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    <span>Danh sách Vai trò</span>
                </a>
            }

            <!-- Nội dung: Admin, QA Manager, QA Coordinator, Customer -->
            <p class="sidebar-group-label">Nội dung</p>

            <a asp-controller="Posts" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Posts" ? "active" : "")">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                Bài viết
            </a>

            @if (isAdmin || isQAManager || isQACoordinator)
            {
                <a asp-controller="Categories" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                    Chuyên mục
                </a>
            }

            <a asp-controller="Tags" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tags" ? "active" : "")">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" /></svg>
                Thẻ Tags
            </a>

            @if (isAdmin || isQAManager)
            {
                <a asp-controller="Pages" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pages" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    Trang tĩnh
                </a>
            }

            @if (isAdmin || isQAManager || isQACoordinator)
            {
                <a asp-controller="Comments" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Comments" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
                    Bình luận
                </a>
            }

            <!-- Giao diện: Chỉ Admin -->
            @if (isAdmin)
            {
                <p class="sidebar-group-label">Giao diện (Chỉ Admin)</p>
                <a asp-controller="Menus" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menus" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                    Menu
                </a>
                <a asp-controller="MenuItems" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MenuItems" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
                    Menu Items
                </a>
                <a asp-controller="Banners" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Banners" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    Banners
                </a>
            }

            <!-- Marketing & Tương tác -->
            @if (isAdmin || isQAManager || isQACoordinator)
            {
                <p class="sidebar-group-label">Marketing & Tương tác</p>
                <a asp-controller="Events" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    Sự kiện
                </a>
                <a asp-controller="Partners" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Partners" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0" /></svg>
                    Đối tác
                </a>
                <a asp-controller="Testimonials" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Testimonials" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
                    Đánh giá
                </a>
            }

            <!-- Hỗ trợ & Khách hàng -->
            @if (isAdmin || isQAManager || isQACoordinator)
            {
                <p class="sidebar-group-label">Hỗ trợ & Khách hàng</p>
                <a asp-controller="Faqs" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Faqs" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    FAQ
                </a>
                <a asp-controller="ContactMessages" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ContactMessages" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    Liên hệ
                </a>
                <a asp-controller="NewsletterSubscribers" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NewsletterSubscribers" ? "active" : "")">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                    Newsletter
                </a>
            }
        </nav>

        <!-- User info / Login / Logout bottom -->
        <div class="border-t border-gray-100 p-4 bg-gray-50/50">
            @if (isSignedIn)
            {
                <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-3 w-full p-1.5 rounded-xl hover:bg-gray-50 border border-transparent hover:border-gray-200 transition-all group" title="Xem hồ sơ cá nhân">
                    <img src="@userAvatar" alt="@displayName" class="w-9 h-9 rounded-full object-cover border border-gray-200 shadow-sm flex-shrink-0 bg-gray-100 ring-2 ring-blue-500/10 group-hover:ring-blue-500/30" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(displayName))&background=2563eb&color=fff&bold=true';" />
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-semibold text-gray-900 truncate group-hover:text-blue-600 transition-colors">@displayName</p>
                        <span class="inline-block text-[10px] font-semibold px-2 py-0.5 rounded-md @roleBadgeClass">
                            @roleName
                        </span>
                    </div>
                </a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login" class="flex items-center justify-center gap-2 w-full py-2 px-3 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-all">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
                    Đăng nhập
                </a>
            }
        </div>
    </aside>

    <!-- Main content area -->
    <div class="ml-64 flex-1 flex flex-col min-h-screen">
        <!-- Top bar -->
        <header class="bg-white border-b border-gray-200 px-8 py-3 flex items-center justify-between sticky top-0 z-20 shadow-sm">
            <div class="flex items-center gap-3">
                <h1 class="text-xl font-bold text-gray-800">@ViewData["Title"]</h1>
                @if (isSignedIn)
                {
                    <span class="text-xs px-2.5 py-0.5 rounded-full font-semibold @roleBadgeClass">
                        Vai trò: @roleName
                    </span>
                }
            </div>
            <div class="flex items-center gap-3.5">
                @if (isAdmin || isQAManager)
                {
                    <a asp-controller="Auth" asp-action="Users" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 hover:bg-blue-600 text-blue-700 hover:text-white border border-blue-200 hover:border-blue-600 rounded-xl text-xs font-bold transition-all shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                        <span>Quản lý User</span>
                    </a>
                }
                <span class="text-xs text-gray-400 font-medium hidden md:inline">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                @if (isSignedIn)
                {
                    <span class="text-xs text-gray-200 hidden md:inline">|</span>
                    <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-2.5 px-2 py-1 rounded-xl hover:bg-gray-50 border border-transparent hover:border-gray-200 transition-all group" title="Xem hồ sơ cá nhân">
                        <img src="@userAvatar" alt="@displayName" class="w-8 h-8 rounded-full object-cover border border-gray-200 ring-2 ring-blue-500/20 group-hover:ring-blue-500 shadow-sm flex-shrink-0 bg-gray-100" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(displayName))&background=2563eb&color=fff&bold=true';" />
                        <div class="text-left hidden lg:block">
                            <span class="text-xs text-gray-800 font-semibold block leading-tight group-hover:text-blue-600 transition-colors">@displayName</span>
                            <span class="text-[10px] text-gray-400 block leading-none mt-0.5">@(User.Identity?.Name)</span>
                        </div>
                    </a>

                    <!-- Nút Đăng xuất duy nhất ở góc trên cùng bên phải -->
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="inline m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-600 hover:text-white bg-rose-50 hover:bg-rose-600 border border-rose-200/80 transition-all shadow-sm hover:shadow active:scale-95 cursor-pointer" title="Đăng xuất khỏi hệ thống">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            <span>Đăng xuất</span>
                        </button>
                    </form>
                }
            </div>
        </header>

        <!-- Page content -->
        <main class="flex-1 p-8">
            @RenderBody()
        </main>

        <footer class="border-t border-gray-200 bg-white px-8 py-3.5 text-xs text-gray-400 text-center">
            &copy; @DateTime.Now.Year CMS Portal - Phân quyền 4 vai trò (Admin, QA Manager, QA Coordinator, Customer)
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

