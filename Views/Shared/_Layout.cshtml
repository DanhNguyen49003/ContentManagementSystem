@using ContentManagementSystem.Services
@inject ICurrentUserService CurrentUserService

@{
    var currentUser = await CurrentUserService.GetCurrentUserAsync();
    var isSignedIn = currentUser.IsAuthenticated;
    var isAdmin = currentUser.IsAdmin;
    var isQAManager = currentUser.IsQAManager;
    var isQACoordinator = currentUser.IsQACoordinator;
    var isCustomer = currentUser.IsCustomer;
    var displayName = currentUser.DisplayName;
    var userAvatar = currentUser.GetAvatarOrDefault();
    var roleName = currentUser.RoleName;
    var roleBadgeClass = currentUser.RoleBadgeClass;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMS Admin</title>
    <script>
        // Kiểm tra và áp dụng trạng thái thu gọn trước khi render để chống giật trang (FOUC)
        if (localStorage.getItem('cms_sidebar_collapsed') === 'true') {
            document.documentElement.classList.add('sidebar-collapsed');
        }
    </script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/ContentManagementSystem.styles.css" asp-append-version="true" />
    <style>
        .sidebar-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.625rem 1rem; border-radius: 0.5rem; color: #4b5563; font-size: 0.875rem; font-weight: 500; transition: all 0.15s ease-in-out; white-space: nowrap; }
        .sidebar-link:hover { background-color: #eff6ff; color: #1d4ed8; }
        .sidebar-link.active { background-color: #2563eb; color: #ffffff; }
        .sidebar-link.active:hover { background-color: #1d4ed8; color: #ffffff; }
        .sidebar-group-label { font-size: 0.75rem; font-weight: 600; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.05em; padding: 0 1rem; margin-top: 1.5rem; margin-bottom: 0.5rem; white-space: nowrap; transition: all 0.2s ease; }
        
        /* Hiệu ứng mượt mà khi thục ra thục vô */
        aside#sidebar {
            width: 16rem;
            transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        #mainContent {
            margin-left: 16rem;
            transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Khi Sidebar thu gọn (thục vô) */
        html.sidebar-collapsed aside#sidebar, body.sidebar-collapsed aside#sidebar {
            width: 5rem;
        }
        html.sidebar-collapsed #mainContent, body.sidebar-collapsed #mainContent {
            margin-left: 5rem;
        }
        html.sidebar-collapsed .sidebar-text, body.sidebar-collapsed .sidebar-text {
            display: none !important;
        }
        html.sidebar-collapsed .sidebar-group-label, body.sidebar-collapsed .sidebar-group-label {
            height: 1px;
            background-color: #e2e8f0;
            margin: 0.875rem 0.75rem;
            padding: 0;
            font-size: 0;
            overflow: hidden;
        }
        html.sidebar-collapsed .sidebar-link, body.sidebar-collapsed .sidebar-link {
            justify-content: center;
            padding: 0.625rem 0;
            gap: 0;
        }
        html.sidebar-collapsed #sidebarHeader, body.sidebar-collapsed #sidebarHeader {
            justify-content: center;
            padding-left: 0.5rem;
            padding-right: 0.5rem;
        }
        html.sidebar-collapsed #sidebarFooter .user-profile-card, body.sidebar-collapsed #sidebarFooter .user-profile-card {
            justify-content: center;
            padding: 0.25rem 0;
        }

        /* Custom scrollbar cho sidebar */
        nav::-webkit-scrollbar { width: 5px; }
        nav::-webkit-scrollbar-track { background: transparent; }
        nav::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        nav::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen flex">

    <!-- Sidebar -->
    <aside id="sidebar" class="bg-white border-r border-gray-200 flex flex-col h-screen fixed top-0 left-0 z-30 shadow-sm overflow-hidden">
        <!-- Logo & Collapse Button -->
        <div id="sidebarHeader" class="flex items-center justify-between px-5 py-4 border-b border-gray-100 flex-shrink-0">
            <div class="flex items-center gap-3 overflow-hidden cursor-pointer select-none" onclick="toggleSidebar()" title="CMS Portal (Bấm để thu gọn/mở rộng)">
                <div class="w-8 h-8 bg-blue-600 hover:bg-blue-700 rounded-lg flex items-center justify-center shadow-sm flex-shrink-0 transition-colors">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                    </svg>
                </div>
                <div class="sidebar-text">
                    <span class="font-bold text-gray-900 text-base leading-none block">CMS Portal</span>
                    <span class="text-[10px] text-gray-400 font-medium mt-0.5 block uppercase tracking-wider">Hệ thống quản trị</span>
                </div>
            </div>
            <button type="button" onclick="toggleSidebar()" class="sidebar-text p-1.5 rounded-lg text-gray-400 hover:text-blue-600 hover:bg-blue-50 transition-all cursor-pointer" title="Thu gọn menu (Ctrl+B)">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
                </svg>
            </button>
        </div>

        <!-- Navigation Menu with Role Visibility (Scrollable) -->
        <nav class="flex-1 px-3 py-4 overflow-y-auto min-h-0">
            <!-- Tổng quan -->
            <p class="sidebar-group-label">Tổng quan</p>
            <a asp-controller="Home" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" title="Dashboard">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                <span class="sidebar-text">Dashboard</span>
            </a>
            @if (isSignedIn)
            {
                <a asp-controller="Profile" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Profile" ? "active" : "")" title="Hồ sơ cá nhân">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
                    <span class="sidebar-text">Hồ sơ cá nhân</span>
                </a>
            }

            <!-- Quản trị Hệ thống & Phân quyền: Chỉ hiển thị cho Admin và QA Manager -->
            @if (isAdmin || isQAManager)
            {
                <p class="sidebar-group-label">Hệ thống & Phân quyền</p>
                <a asp-controller="Auth" asp-action="Users" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Auth" && ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")" title="Quản lý Người dùng">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                    <span class="sidebar-text">Quản lý Người dùng</span>
                </a>
                <a asp-controller="Auth" asp-action="Roles" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Auth" && ViewContext.RouteData.Values["action"]?.ToString() == "Roles" ? "active" : "")" title="Danh sách Vai trò">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
                    <span class="sidebar-text">Danh sách Vai trò</span>
                </a>
                <a asp-controller="Departments" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Departments" ? "active" : "")" title="Quản lý Phòng ban">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                    <span class="sidebar-text">Phòng ban</span>
                </a>
            }

            <!-- Nội dung: Admin, QA Manager, QA Coordinator, Customer -->
            <p class="sidebar-group-label">Nội dung</p>

            <a asp-controller="Posts" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Posts" ? "active" : "")" title="Bài viết">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                <span class="sidebar-text">Bài viết</span>
            </a>

            @if (isAdmin || isQAManager || isQACoordinator)
            {
                <a asp-controller="Categories" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")" title="Chuyên mục">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" /></svg>
                    <span class="sidebar-text">Chuyên mục</span>
                </a>
            }

            <a asp-controller="Tags" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Tags" ? "active" : "")" title="Thẻ Tags">
                <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14" /></svg>
                <span class="sidebar-text">Thẻ Tags</span>
            </a>

            @if (isAdmin || isQAManager)
            {
                <a asp-controller="Pages" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Pages" ? "active" : "")" title="Trang tĩnh">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    <span class="sidebar-text">Trang tĩnh</span>
                </a>
            }

            @if (isAdmin || isQAManager || isQACoordinator)
            {
                <a asp-controller="Comments" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Comments" ? "active" : "")" title="Bình luận">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" /></svg>
                    <span class="sidebar-text">Bình luận</span>
                </a>
            }

            <!-- Giao diện: Chỉ Admin -->
            @if (isAdmin)
            {
                <p class="sidebar-group-label">Giao diện (Chỉ Admin)</p>
                <a asp-controller="Menus" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menus" ? "active" : "")" title="Menu">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
                    <span class="sidebar-text">Menu</span>
                </a>
                <a asp-controller="MenuItems" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "MenuItems" ? "active" : "")" title="Menu Items">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></svg>
                    <span class="sidebar-text">Menu Items</span>
                </a>
                <a asp-controller="Banners" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Banners" ? "active" : "")" title="Banners">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    <span class="sidebar-text">Banners</span>
                </a>
            }

            <!-- Marketing & Tương tác -->
            @if (isAdmin || isQAManager || isQACoordinator)
            {
                <p class="sidebar-group-label">Marketing & Tương tác</p>
                <a asp-controller="Events" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "active" : "")" title="Sự kiện">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
                    <span class="sidebar-text">Sự kiện</span>
                </a>
                <a asp-controller="Partners" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Partners" ? "active" : "")" title="Đối tác">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0" /></svg>
                    <span class="sidebar-text">Đối tác</span>
                </a>
                <a asp-controller="Testimonials" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Testimonials" ? "active" : "")" title="Đánh giá">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
                    <span class="sidebar-text">Đánh giá</span>
                </a>
            }

            <!-- Hỗ trợ & Khách hàng -->
            @if (isAdmin || isQAManager || isQACoordinator)
            {
                <p class="sidebar-group-label">Hỗ trợ & Khách hàng</p>
                <a asp-controller="Faqs" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Faqs" ? "active" : "")" title="FAQ">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span class="sidebar-text">FAQ</span>
                </a>
                <a asp-controller="ContactMessages" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ContactMessages" ? "active" : "")" title="Liên hệ">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                    <span class="sidebar-text">Liên hệ</span>
                </a>
                <a asp-controller="NewsletterSubscribers" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NewsletterSubscribers" ? "active" : "")" title="Newsletter">
                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
                    <span class="sidebar-text">Newsletter</span>
                </a>
            }
        </nav>

        <!-- User info / Login / Logout bottom -->
        <div id="sidebarFooter" class="border-t border-gray-100 p-3 bg-gray-50/50 flex-shrink-0">
            @if (isSignedIn)
            {
                <a asp-controller="Profile" asp-action="Index" class="user-profile-card flex items-center gap-3 w-full p-1.5 rounded-xl hover:bg-white border border-transparent hover:border-gray-200 transition-all group" title="@displayName (@roleName)">
                    <img src="@userAvatar" alt="@displayName" class="w-9 h-9 rounded-full object-cover border border-gray-200 shadow-sm flex-shrink-0 bg-gray-100 ring-2 ring-blue-500/10 group-hover:ring-blue-500/30" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(displayName))&background=2563eb&color=fff&bold=true';" />
                    <div class="sidebar-text min-w-0 flex-1">
                        <p class="text-xs font-semibold text-gray-900 truncate group-hover:text-blue-600 transition-colors">@displayName</p>
                        <span class="inline-block text-[10px] font-semibold px-2 py-0.5 rounded-md @roleBadgeClass">
                            @roleName
                        </span>
                    </div>
                </a>
            }
            else
            {
                <a asp-controller="Auth" asp-action="Login" class="user-profile-card flex items-center justify-center gap-2 w-full py-2 px-3 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg shadow-sm transition-all" title="Đăng nhập">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
                    <span class="sidebar-text">Đăng nhập</span>
                </a>
            }
        </div>
    </aside>

    <!-- Main content area -->
    <div id="mainContent" class="flex-1 flex flex-col min-h-screen">
        <!-- Top bar -->
        <header class="bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between sticky top-0 z-20 shadow-sm">
            <div class="flex items-center gap-3">
                <button type="button" onclick="toggleSidebar()" class="p-2 -ml-2 rounded-xl text-gray-500 hover:text-blue-600 hover:bg-blue-50 border border-gray-200/70 hover:border-blue-200 transition-all active:scale-95 cursor-pointer shadow-xs" title="Thu gọn / Mở rộng menu (Ctrl+B)">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                    </svg>
                </button>
                <h1 class="text-xl font-bold text-gray-800">@ViewData["Title"]</h1>
                @if (isSignedIn)
                {
                    <span class="text-xs px-2.5 py-0.5 rounded-full font-semibold @roleBadgeClass">
                        Vai trò: @roleName
                    </span>
                }
            </div>
            <div class="flex items-center gap-3.5">
                @if (isAdmin || isQAManager)
                {
                    <a asp-controller="Auth" asp-action="Users" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 hover:bg-blue-600 text-blue-700 hover:text-white border border-blue-200 hover:border-blue-600 rounded-xl text-xs font-bold transition-all shadow-sm">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                        <span>Quản lý User</span>
                    </a>
                }
                <span class="text-xs text-gray-400 font-medium hidden md:inline">@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                @if (isSignedIn)
                {
                    <span class="text-xs text-gray-200 hidden md:inline">|</span>
                    <a asp-controller="Profile" asp-action="Index" class="flex items-center gap-2.5 px-2 py-1 rounded-xl hover:bg-gray-50 border border-transparent hover:border-gray-200 transition-all group" title="Xem hồ sơ cá nhân">
                        <img src="@userAvatar" alt="@displayName" class="w-8 h-8 rounded-full object-cover border border-gray-200 ring-2 ring-blue-500/20 group-hover:ring-blue-500 shadow-sm flex-shrink-0 bg-gray-100" onerror="this.onerror=null;this.src='https://ui-avatars.com/api/?name=@(Uri.EscapeDataString(displayName))&background=2563eb&color=fff&bold=true';" />
                        <div class="text-left hidden lg:block">
                            <span class="text-xs text-gray-800 font-semibold block leading-tight group-hover:text-blue-600 transition-colors">@displayName</span>
                            <span class="text-[10px] text-gray-400 block leading-none mt-0.5">@(User.Identity?.Name)</span>
                        </div>
                    </a>

                    <!-- Nút Đăng xuất duy nhất ở góc trên cùng bên phải -->
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="inline m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold text-rose-600 hover:text-white bg-rose-50 hover:bg-rose-600 border border-rose-200/80 transition-all shadow-sm hover:shadow active:scale-95 cursor-pointer" title="Đăng xuất khỏi hệ thống">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            <span>Đăng xuất</span>
                        </button>
                    </form>
                }
            </div>
        </header>

        <!-- Page content -->
        <main class="flex-1 p-8">
            @RenderBody()
        </main>

        <footer class="border-t border-gray-200 bg-white px-8 py-3.5 text-xs text-gray-400 text-center">
            &copy; @DateTime.Now.Year CMS Portal - Phân quyền 4 vai trò (Admin, QA Manager, QA Coordinator, Customer)
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebar() {
            const html = document.documentElement;
            const body = document.body;
            const isCurrentlyCollapsed = html.classList.contains('sidebar-collapsed') || body.classList.contains('sidebar-collapsed');
            
            if (isCurrentlyCollapsed) {
                html.classList.remove('sidebar-collapsed');
                body.classList.remove('sidebar-collapsed');
                localStorage.setItem('cms_sidebar_collapsed', 'false');
            } else {
                html.classList.add('sidebar-collapsed');
                body.classList.add('sidebar-collapsed');
                localStorage.setItem('cms_sidebar_collapsed', 'true');
            }
        }

        // Phím tắt Ctrl+B hoặc Cmd+B để thục ra / thục vô
        document.addEventListener('keydown', function(e) {
            if ((e.ctrlKey || e.metaKey) && (e.key === 'b' || e.key === 'B')) {
                e.preventDefault();
                toggleSidebar();
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

