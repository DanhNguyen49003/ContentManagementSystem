@model ContentManagementSystem.ApplicationCore.DTOs.FaqDto
@{
    ViewData["Title"] = "Thêm FAQ mới";
    Layout = "_Layout";
}

<div class="p-6 max-w-3xl mx-auto">
    <!-- Back Button -->
    <div class="mb-5">
        <a asp-action="Index" asp-controller="Faqs"
           class="inline-flex items-center gap-1.5 text-sm text-gray-500 hover:text-blue-600 transition-colors duration-150">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            Quay lại danh sách
        </a>
    </div>

    <!-- Page Header -->
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">Thêm FAQ mới</h1>
        <p class="text-sm text-gray-500 mt-1">Điền thông tin câu hỏi thường gặp</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        <form asp-action="Create" asp-controller="Faqs" method="post" novalidate>
            @Html.AntiForgeryToken()

            <!-- Question -->
            <div class="mb-5">
                <label asp-for="Question" class="block text-sm font-medium text-gray-700 mb-1.5">
                    Câu hỏi <span class="text-red-500">*</span>
                </label>
                <input asp-for="Question" type="text"
                       placeholder="Nhập câu hỏi thường gặp..."
                       class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-400 transition" />
                <span asp-validation-for="Question" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Answer -->
            <div class="mb-6">
                <label asp-for="Answer" class="block text-sm font-medium text-gray-700 mb-1.5">
                    Câu trả lời <span class="text-red-500">*</span>
                </label>
                <textarea asp-for="Answer" rows="6"
                          placeholder="Nhập nội dung câu trả lời chi tiết..."
                          class="w-full px-3 py-2.5 text-sm border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent placeholder-gray-400 resize-y transition"></textarea>
                <span asp-validation-for="Answer" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <!-- Actions -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-100">
                <a asp-action="Index" asp-controller="Faqs"
                   class="px-4 py-2 text-sm font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors duration-150">
                    Hủy
                </a>
                <button type="submit"
                        class="inline-flex items-center gap-2 px-5 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-sm transition-colors duration-150">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    Lưu FAQ
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
